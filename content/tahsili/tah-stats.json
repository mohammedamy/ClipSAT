              "ar": null
            }
          },
          {
            "label": {
              "en": "Median",
              "ar": null
            },
            "value": {
              "en": "middle value",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Probability",
              "ar": null
            },
            "value": {
              "en": "\\( \\tfrac{\\text{fav}}{\\text{total}} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Independent",
              "ar": null
