      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ How to prepare",
          "ar": null
        },
        "body": {
          "en": "Work by topic, master the standard formulas, and practise recall under time pressure. The eight chapters below mirror the curriculum strands; each ends with worked examples, and the practice set blends all of them.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "warn",
        "label": {
          "en": "Practice Problem",
          "ar": null
        },
        "body": {
          "en": "A Tahsili math section has 50 questions. A student answers 42 correctly. If correct answers score +2 and incorrect score 0, what is the student's total score? <details><summary>Show solution</summary><div>Score\\(=42\\times2=84\\) points out of a possible 100. (Unanswered or wrong: \\(8\\times0=0.\\))</div></details>",
          "ar": null
        }
      }
    ]
  },
  "quizWidget": {
    "enabled": true
  }
