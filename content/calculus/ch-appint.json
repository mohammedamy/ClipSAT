          }
        ],
        "equationDisplay": {
          "id": "abcEq",
          "value": "y = 4 − x²&nbsp; and&nbsp; y = x + 2",
          "style": "font-size:.84rem; padding:9px 11px; background:var(--paper-2); border-radius:8px"
        },
        "readouts": [
          {
            "id": "abcLo",
            "label": {
              "en": "intersection",
              "ar": null
            },
            "colorClass": "indigo",
            "value": "—"
          },
          {
            "id": "abcArea",
