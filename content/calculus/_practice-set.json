      },
      "solution": {
        "en": "<p>Point \\( (3,9) \\); slope \\( y'=2x=6 \\). Then \\( y-9=6(x-3) \\):</p>\\[ y=6x-9. \\]",
        "ar": null
      },
      "difficulty": "Intermediate"
    },
    {
      "number": "P32",
      "question": {
        "en": "On what intervals is \\( f(x)=x^3-3x \\) increasing?",
