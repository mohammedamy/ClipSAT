    },
    {
      "number": "P29",
      "question": {
        "en": "Find \\( \\dfrac{dy}{dx} \\) if \\( x^2+y^2=25 \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>Differentiate implicitly: \\( 2x+2y\\,y'=0 \\).</p>\\[ \\frac{dy}{dx}=-\\frac{x}{y}. \\]",
        "ar": null
      },
      "difficulty": "Advanced"
    },
    {
      "number": "P30",
      "question": {
        "en": "Find \\( \\dfrac{dy}{dx} \\) if \\( xy+y^2=6 \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>Differentiate implicitly (product rule on \\( xy \\)): \\( y+x\\,y'+2y\\,y'=0 \\).</p>\\[ \\frac{dy}{dx}=-\\frac{y}{x+2y}. \\]",
        "ar": null
      },
      "difficulty": "Advanced"
    },
    {
      "number": "P31",
      "question": {
        "en": "Find the tangent line to \\( y=x^2 \\) at \\( x=3 \\).",
