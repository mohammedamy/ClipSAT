{
  "id": "ag-radicals",
  "chapterNumber": "9",
  "title": {
    "en": "Radicals &amp; Exponents",
    "ar": null
  },
  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "Roots can be written as radicals or as fractional exponents; both obey the laws of exponents.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ Reference — Radical laws",
          "ar": null
        },
        "body": {
          "en": "<p>\\( \\sqrt{ab}=\\sqrt{a}\\,\\sqrt{b} \\), \\( a^{1/n}=\\sqrt[n]{a} \\), and \\( a^{m/n}=\\sqrt[n]{a^{m}} \\). Rationalise a denominator by multiplying by the conjugate.</p>",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Product",
              "ar": null
            },
            "value": {
              "en": "\\( \\sqrt{ab}=\\sqrt{a}\\sqrt{b} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Fractional",
              "ar": null
            },
            "value": {
              "en": "\\( a^{m/n}=\\sqrt[n]{a^{m}} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Simplify",
              "ar": null
            },
            "value": {
              "en": "\\( \\sqrt{a^{2}b}=a\\sqrt{b} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Rationalise",
              "ar": null
            },
            "value": {
              "en": "× conjugate",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 9.A",
          "ar": null
        },
        "body": {
          "en": "<p>Simplify \\( \\sqrt{72} \\).</p>\\[ \\sqrt{36\\cdot2}=6\\sqrt{2}. \\]",
          "ar": null
        }
      }
    ]
  }
}
