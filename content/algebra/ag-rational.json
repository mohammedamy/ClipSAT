{
  "id": "ag-rational",
  "chapterNumber": "10",
  "title": {
    "en": "Rational Expressions",
    "ar": null
  },
  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "A rational expression is a ratio of polynomials; simplify by factoring and cancelling common factors.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ Reference — Working with rationals",
          "ar": null
        },
        "body": {
          "en": "<p>Multiply \\( \\tfrac{a}{b}\\cdot\\tfrac{c}{d}=\\tfrac{ac}{bd} \\); divide by multiplying by the reciprocal; add over a common denominator. Exclude any value making a denominator zero.</p>",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Simplify",
              "ar": null
            },
            "value": {
              "en": "cancel factors",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Multiply",
              "ar": null
            },
            "value": {
              "en": "\\( \\tfrac{ac}{bd} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Divide",
              "ar": null
            },
            "value": {
              "en": "× reciprocal",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Domain",
              "ar": null
            },
            "value": {
              "en": "\\( b\\neq 0 \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 10.A",
          "ar": null
        },
        "body": {
          "en": "<p>Simplify \\( \\dfrac{x^{2}-9}{x-3} \\).</p>\\[ x+3,\\quad x\\neq 3. \\]",
          "ar": null
        }
      }
    ]
  }
}
