            "min": 0,
            "max": 24,
            "value": 6,
            "step": 0.5,
            "valueDisplayId": "ibslTideTlab",
            "ariaLabel": {
              "en": "Query time t in hours, marked on the curve", "ar": null
            }
          }
        ],
        "readouts": [
          {
            "id": "ibslMax",
            "label": {
              "en": "max height",
              "ar": null
