            { "en": "value", "ar": null }
          ]
        },
        "controls": [
          {
            "id": "ibslVecAngUang",
            "label": { "en": "u's direction:", "ar": null },
            "min": 0, "max": 180, "value": 20, "step": 1,
            "valueDisplayId": "ibslVecAngUangVal",
            "ariaLabel": { "en": "Direction of u in degrees", "ar": null }
          },
          {
            "id": "ibslVecAngUlen",
            "label": { "en": "|u|:", "ar": null },
            "min": 1, "max": 5, "value": 4, "step": 0.5,
            "valueDisplayId": "ibslVecAngUlenVal",
            "ariaLabel": { "en": "Length of u", "ar": null }
          },
          {
            "id": "ibslVecAngVang",
            "label": { "en": "v's direction:", "ar": null },
            "min": 0, "max": 359, "value": 110, "step": 1,
            "valueDisplayId": "ibslVecAngVangVal",
            "ariaLabel": { "en": "Direction of v in degrees", "ar": null }
          },
          {
            "id": "ibslVecAngVlen",
            "label": { "en": "|v|:", "ar": null },
            "min": 1, "max": 5, "value": 3, "step": 0.5,
            "valueDisplayId": "ibslVecAngVlenVal",
            "ariaLabel": { "en": "Length of v", "ar": null }
          }
        ],
        "readouts": [
          {
            "id": "ibslVecAngDot",
            "label": { "en": "u · v", "ar": null },
            "colorClass": "amber",
            "value": "0.000"
          },
          {
            "id": "ibslVecAngTheta",
            "label": { "en": "angle between u and v (from dot product)", "ar": null },
            "colorClass": "indigo",
            "value": "90.0°"
          }
        ],
        "note": {
          "en": "θ is recovered from \\(\\cos\\theta=\\dfrac{\\mathbf{u}\\cdot\\mathbf{v}}{|\\mathbf{u}||\\mathbf{v}|}\\) — drag either direction slider and check the readout always matches the actual angle swept between the two arrows on screen, confirming the formula independently of how u and v happen to be oriented.",
          "ar": null
        }
      },
      {
        "kind": "workedExampleCard",
        "label": {
          "en": "Worked Example 3.1 — Sinusoidal model",
          "ar": null
        },
        "problem": {
          "en": "The tide height (m) is modelled by \\(h(t)=3\\sin\\!\\left(\\dfrac{\\pi t}{6}\\right)+5.\\) Find: amplitude, period, max and min heights.",
          "ar": null
        },
        "solution": {
          "en": "<p>Amplitude \\(=3\\) m. Period \\(=\\dfrac{2\\pi}{\\pi/6}=12\\) hours. Max \\(=5+3=8\\) m. Min \\(=5-3=2\\) m.</p>",
          "ar": null
        }
      },
      {
        "kind": "explorer",
        "canvasId": "ibslTideCanvas",
        "title": {
          "en": "⊙ Explorer · Sinusoidal model — tide height",
          "ar": null
        },
        "ariaLabel": {
          "en": "A sinusoidal tide-height model h of t equals A sine of 2 pi t over P plus k",
          "ar": null
        },
        "dataPanel": {
          "btnId": "ibslTideDataBtn",
          "panelId": "ibslTideDataPanel",
          "descId": "ibslTideDataDesc",
          "rowsId": "ibslTideDataRows",
