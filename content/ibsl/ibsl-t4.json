          },
          {
            "id": "ibslNormX",
            "label": { "en": "shade up to <b>x</b> =", "ar": null },
            "min": -10,
            "max": 30,
            "value": 10,
            "step": 0.5,
            "valueDisplayId": "ibslNormXVal",
