  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "Integration reverses differentiation and accumulates change — the second great engine of calculus.",
          "ar": null
        }
      },
      {
        "kind": "text",
        "body": {
          "en": "A definite integral is a limit of Riemann sums. Add rectangles and switch the sample point — the amber estimate marches toward the exact area.",
          "ar": null
        }
      },
      {
        "kind": "explorer",
        "canvasId": "apRiemCanvas",
        "title": {
          "en": "⊙ Explorer · Riemann sums",
          "ar": null
        },
        "ariaLabel": {
          "en": "Riemann-sum rectangles approximating the area under a curve",
          "ar": null
        },
