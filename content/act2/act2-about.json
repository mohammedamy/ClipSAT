        "body": {
          "en": "ACT Math 2 is an advanced subject-level mathematics course for students who have completed standard ACT Math preparation and wish to extend their skills into pre-calculus territory — the topics that appear in the hardest ACT questions and on ACT subject tests.",
          "ar": null
        }
      },
      {
        "kind": "callout",
