      "id": "appc-p1",
      "number": 1,
      "question": {
        "en": "State the amplitude, period, phase shift, and midline of \\(f(x)=3\\sin(2x-\\pi)+1\\).",
        "ar": null
      },
      "difficulty": "Medium",
      "solution": {
        "en": "<p>Amplitude 3, period \\(\\pi\\), phase shift \\(\\pi/2\\) right, midline \\(y=1.\\)</p>",
        "ar": null
      }
    },
    {
      "id": "appc-p2",
      "number": 2,
      "question": {
        "en": "A population doubles every 12 years, starting from \\(P_0=500\\). When does it reach 4000?",
        "ar": null
      },
      "difficulty": "Hard",
      "solution": {
        "en": "<p>\\(P(t)=500\\cdot2^{t/12}=4000\\Rightarrow 2^{t/12}=8=2^3\\Rightarrow t=36\\) years.</p>",
        "ar": null
      }
    },
    {
      "id": "appc-p3",
      "number": 3,
      "question": {
        "en": "Find all zeros of \\(p(x)=x^3-2x^2-x+2.\\)",
        "ar": null
      },
      "difficulty": "Medium",
      "solution": {
        "en": "<p>\\(p(1)=0\\Rightarrow(x-1)(x-2)(x+1).\\) Zeros: \\(x=1,2,-1.\\)</p>",
        "ar": null
      }
    },
    {
      "id": "appc-p4",
      "number": 4,
      "question": {
        "en": "Solve \\(\\ln(2x+1)=3\\).",
        "ar": null
      },
      "difficulty": "Easy",
      "solution": {
        "en": "<p>\\(2x+1=e^3\\Rightarrow x=\\dfrac{e^3-1}{2}\\approx9.04.\\)</p>",
        "ar": null
      }
    },
    {
      "id": "appc-p5",
      "number": 5,
      "question": {
        "en": "The half-life of Carbon-14 is 5730 years. (a) Write \\(A(t)\\). (b) How much of 200 g remains after 11 460 years? (c) When is only 10% left?",
        "ar": null
      },
      "difficulty": "Hard",
      "solution": {
        "en": "<p>(a) \\(A(t)=200\\cdot\\left(\\tfrac{1}{2}\\right)^{t/5730}.\\)</p><p>(b) \\(t=2\\times5730\\): \\(A=200\\cdot(1/4)=50\\) g.</p><p>(c) \\((1/2)^{t/5730}=0.1\\Rightarrow t=5730\\cdot\\dfrac{\\ln0.1}{\\ln0.5}\\approx19{,}035\\) years.</p>",
        "ar": null
      }
    },
    {
      "id": "appc-p6",
      "number": 6,
      "question": {
        "en": "A particle moves along \\(x(t)=2t+1,\\;y(t)=t^2-3.\\) Find the Cartesian equation of the path.",
        "ar": null
      },
      "difficulty": "Medium",
      "solution": {
        "en": "<p>\\(t=\\dfrac{x-1}{2}.\\quad y=\\left(\\dfrac{x-1}{2}\\right)^2-3=\\dfrac{(x-1)^2}{4}-3.\\) A parabola.</p>",
        "ar": null
      }
    }
  ]
}
