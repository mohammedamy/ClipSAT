  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "Integrating standard functions, definite integrals, and the area under a curve.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ Reference — Standard integrals",
          "ar": null
        },
        "body": {
          "en": "\\( \\displaystyle\\int x^{n}\\,dx=\\dfrac{x^{n+1}}{n+1}+C \\) (\\( n\\neq-1 \\)); \\( \\displaystyle\\int e^{x}\\,dx=e^{x}+C \\); \\( \\displaystyle\\int\\tfrac1x\\,dx=\\ln|x|+C \\). A definite integral gives the signed area: \\( F(b)-F(a) \\).",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Power",
              "ar": null
            },
            "value": {
              "en": "\\( \\tfrac{x^{n+1}}{n+1}+C \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Exponential",
              "ar": null
            },
            "value": {
              "en": "\\( e^{x}+C \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Reciprocal",
              "ar": null
            },
            "value": {
              "en": "\\( \\ln|x|+C \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Area",
              "ar": null
            },
            "value": {
              "en": "\\( F(b)-F(a) \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 5.A",
          "ar": null
        },
        "body": {
          "en": "<p>Find \\( \\displaystyle\\int 6x^{2}\\,dx \\).</p>\\[ 2x^{3}+C. \\]",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 5.B",
          "ar": null
        },
        "body": {
          "en": "<p>Find the area under \\( y=x^{2} \\) from \\( 0 \\) to \\( 3 \\).</p>\\[ \\left[\\tfrac{x^{3}}{3}\\right]_{0}^{3}=9. \\]",
          "ar": null
        }
      },
      {
        "kind": "practiceProblem",
        "question": {
          "en": "Find \\(\\displaystyle\\int x\\sin x\\,dx\\).",
          "ar": null
        },
        "solution": {
          "en": "Integration by parts: \\(u=x\\), \\(dv=\\sin x\\,dx\\Rightarrow v=-\\cos x\\). \\(\\int x\\sin x\\,dx=-x\\cos x+\\int\\cos x\\,dx=-x\\cos x+\\sin x+c\\).",
          "ar": null
        }
      }
    ]
  },
