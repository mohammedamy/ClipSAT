  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "Reciprocal ratios, the double-angle formulae, and solving trigonometric equations.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ Reference — Identities",
          "ar": null
        },
        "body": {
          "en": "\\( \\sec\\theta=\\dfrac{1}{\\cos\\theta} \\). Double angle: \\( \\sin2\\theta=2\\sin\\theta\\cos\\theta \\) and \\( \\cos2\\theta=2\\cos^{2}\\theta-1 \\). The tangent curve has period \\( 180^{\\circ} \\).",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Reciprocal",
              "ar": null
            },
            "value": {
              "en": "\\( \\sec\\theta=\\tfrac{1}{\\cos\\theta} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Sine double",
              "ar": null
            },
            "value": {
              "en": "\\( 2\\sin\\theta\\cos\\theta \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Cosine double",
              "ar": null
            },
            "value": {
              "en": "\\( 2\\cos^{2}\\theta-1 \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Period of tan",
              "ar": null
            },
            "value": {
              "en": "\\( 180^{\\circ} \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 3.A",
          "ar": null
        },
        "body": {
          "en": "<p>Write \\( \\cos2\\theta \\) in terms of \\( \\cos\\theta \\).</p>\\[ \\cos2\\theta=2\\cos^{2}\\theta-1. \\]",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 3.B",
          "ar": null
        },
        "body": {
          "en": "<p>Solve \\( \\cos\\theta=0 \\) for \\( 0^{\\circ}\\le\\theta\\le180^{\\circ} \\).</p>\\[ \\theta=90^{\\circ}. \\]",
          "ar": null
        }
      },
      {
        "kind": "practiceProblem",
        "question": {
          "en": "Express \\(3\\sin\\theta+4\\cos\\theta\\) in the form \\(R\\sin(\\theta+\\alpha)\\) where \\(R>0\\) and \\(0<\\alpha<90°\\).",
          "ar": null
        },
        "solution": {
          "en": "\\(R=\\sqrt{9+16}=5\\). \\(\\tan\\alpha=4/3\\Rightarrow\\alpha=53.13°\\). So \\(5\\sin(\\theta+53.13°)\\).",
          "ar": null
        }
      }
    ]
  },
  "quizWidget": {
    "enabled": true
  }
}
