  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "Arithmetic and geometric progressions, sums to infinity, and the binomial expansion.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ Reference — Progressions",
          "ar": null
        },
        "body": {
          "en": "AP term \\( a+(n-1)d \\); GP term \\( ar^{\\,n-1} \\). A convergent GP \\( (|r|&lt;1) \\) sums to \\( \\dfrac{a}{1-r} \\). The sum of the first \\( n \\) integers is \\( \\dfrac{n(n+1)}{2} \\).",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "AP term",
              "ar": null
            },
            "value": {
              "en": "\\( a+(n-1)d \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "GP term",
              "ar": null
            },
            "value": {
              "en": "\\( ar^{\\,n-1} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "GP to infinity",
              "ar": null
            },
            "value": {
              "en": "\\( \\dfrac{a}{1-r} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "First n integers",
              "ar": null
            },
            "value": {
              "en": "\\( \\dfrac{n(n+1)}{2} \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 6.A",
          "ar": null
        },
        "body": {
          "en": "<p>Find the 10th term of \\( 2,5,8,\\dots \\)</p><p>\\( a=2,\\ d=3 \\):</p>\\[ 2+9(3)=29. \\]",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 6.B",
          "ar": null
        },
        "body": {
          "en": "<p>Find the sum to infinity of \\( 1+\\tfrac12+\\tfrac14+\\dots \\)</p>\\[ \\frac{1}{1-\\tfrac12}=2. \\]",
          "ar": null
        }
      },
      {
        "kind": "practiceProblem",
        "question": {
          "en": "Find the first three non-zero terms of the Maclaurin series for \\(e^{2x}\\). State the range of validity.",
          "ar": null
        },
        "solution": {
          "en": "\\(e^{2x}=1+2x+\\dfrac{(2x)^2}{2!}+\\cdots=1+2x+2x^2+\\cdots\\). Valid for all \\(x\\in\\mathbb{R}\\).",
          "ar": null
        }
      }
    ]
  },
  "quizWidget": {
    "enabled": true
  }
}
