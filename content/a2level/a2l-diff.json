  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "Differentiating standard functions and applying the chain, product and quotient rules.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ Reference — Rules",
          "ar": null
        },
        "body": {
          "en": "\\( \\tfrac{d}{dx}e^{x}=e^{x} \\), \\( \\tfrac{d}{dx}\\ln x=\\tfrac1x \\), \\( \\tfrac{d}{dx}\\sin x=\\cos x \\). Chain: \\( \\tfrac{dy}{dx}=\\tfrac{dy}{du}\\tfrac{du}{dx} \\). Product: \\( (uv)'=u'v+uv' \\). Quotient: \\( \\left(\\tfrac{u}{v}\\right)'=\\dfrac{u'v-uv'}{v^{2}} \\).",
          "ar": null
        }
      },
      {
        "kind": "text",
        "body": {
          "en": "Slide the point along \\( y=x^{3}-3x \\). The amber line is the tangent; its gradient is \\( 3x^{2}-3 \\).",
          "ar": null
        }
      },
      {
        "kind": "explorer",
        "title": {
          "en": "⊙ Explorer · The tangent gradient",
          "ar": null
        },
        "canvasId": "a2DerivCanvas",
        "ariaLabel": {
          "en": "The tangent to a cubic at a movable point",
          "ar": null
        },
        "dataPanel": {
          "btnId": "a2DerivDataBtn",
          "panelId": "a2DerivDataPanel",
          "descId": "a2DerivDataDesc",
          "rowsId": "a2DerivDataRows",
          "caption": {
            "en": "Sampled points on f(x) and the tangent line at x₀",
            "ar": null
          },
          "columns": [
            {
              "en": "x",
              "ar": null
            },
            {
              "en": "f(x)",
              "ar": null
            },
            {
              "en": "tangent y",
              "ar": null
            }
          ]
        },
        "controls": [
          {
            "id": "a2DerivX",
            "label": {
              "en": "Point <b>x =</b>",
              "ar": null
            },
            "min": -2.2,
            "max": 2.2,
            "value": 1,
            "step": 0.1,
            "valueDisplayId": "a2DerivXV",
            "ariaLabel": {
              "en": "Point x",
              "ar": null
            }
          }
        ],
        "readouts": [
          {
            "id": "a2DerivSlope",
            "label": {
              "en": "gradient dy/dx",
              "ar": null
            },
            "colorClass": "amber",
            "value": "—"
          }
        ],
        "note": {
          "en": "The gradient is zero at the turning points, where \\( 3x^{2}-3=0 \\), i.e. \\( x=\\pm1 \\).",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Exponential",
              "ar": null
            },
            "value": {
              "en": "\\( \\tfrac{d}{dx}e^{x}=e^{x} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Chain",
              "ar": null
            },
            "value": {
              "en": "\\( \\tfrac{dy}{du}\\tfrac{du}{dx} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Product",
              "ar": null
            },
            "value": {
              "en": "\\( u'v+uv' \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Quotient",
              "ar": null
            },
            "value": {
              "en": "\\( \\dfrac{u'v-uv'}{v^{2}} \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 4.A",
          "ar": null
        },
        "body": {
          "en": "<p>Differentiate \\( y=(2x+1)^{3} \\).</p><p>Chain rule:</p>\\[ 3(2x+1)^{2}\\cdot2=6(2x+1)^{2}. \\]",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 4.B",
          "ar": null
        },
        "body": {
          "en": "<p>Differentiate \\( y=\\dfrac{x}{x+1} \\).</p>\\[ \\frac{(x+1)-x}{(x+1)^{2}}=\\frac{1}{(x+1)^{2}}. \\]",
          "ar": null
        }
      },
      {
        "kind": "practiceProblem",
        "question": {
          "en": "A curve is defined parametrically by \\(x=t^2+1\\), \\(y=2t^3-3t\\). Find \\(\\dfrac{dy}{dx}\\) in terms of \\(t\\) and the value at \\(t=1\\).",
          "ar": null
        },
        "solution": {
          "en": "\\(\\dfrac{dx}{dt}=2t\\), \\(\\dfrac{dy}{dt}=6t^2-3\\). \\(\\dfrac{dy}{dx}=\\dfrac{6t^2-3}{2t}\\). At \\(t=1\\): \\(\\dfrac{3}{2}\\).",
          "ar": null
        }
      }
    ]
  },
  "quizWidget": {
    "enabled": true
  }
}
