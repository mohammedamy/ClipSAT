      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 7.A",
          "ar": null
        },
        "body": {
          "en": "<p>Find \\( (1,2)+(3,1) \\).</p>\\[ (4,\\,3). \\]",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 7.B",
          "ar": null
        },
        "body": {
          "en": "<p>Find the magnitude of \\( (6,8) \\).</p>\\[ \\sqrt{36+64}=10. \\]",
          "ar": null
        }
      },
      {
        "kind": "practiceProblem",
        "question": {
          "en": "Lines \\(\\ell_1\\) and \\(\\ell_2\\) have direction vectors \\(\\mathbf{d_1}=\\begin{pmatrix}2\\\\1\\\\-1\\end{pmatrix}\\) and \\(\\mathbf{d_2}=\\begin{pmatrix}1\\\\-1\\\\3\\end{pmatrix}\\). Find the acute angle between them.",
          "ar": null
        },
        "solution": {
          "en": "\\(\\mathbf{d_1}\\cdot\\mathbf{d_2}=2-1-3=-2\\). \\(|\\mathbf{d_1}|=\\sqrt6\\), \\(|\\mathbf{d_2}|=\\sqrt{11}\\). \\(\\cos\\theta=\\dfrac{2}{\\sqrt{66}}\\Rightarrow\\theta=\\arccos\\!\\left(\\dfrac{2}{\\sqrt{66}}\\right)\\approx75.7°\\).",
          "ar": null
        }
      }
    ]
  },
