  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "The built-in Desmos graphing calculator is the Digital SAT's secret weapon. Many “solve” and “system” questions become a glance at a graph.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "note",
        "label": {
          "en": "Desmos moves worth knowing",
          "ar": null
        },
        "body": {
          "en": "Type an equation to graph it instantly; click a curve to read its <strong>intercepts</strong>; graph two equations and click the <strong>intersection</strong> to solve a system; build a <strong>table</strong> for data; and add a <strong>slider</strong> for “for what value of \\( k \\)” questions.",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Graph",
              "ar": null
            },
            "value": {
              "en": "type the equation",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Intersect",
              "ar": null
            },
            "value": {
              "en": "click the crossing point",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Table",
              "ar": null
            },
            "value": {
              "en": "plot data points",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Slider",
              "ar": null
            },
            "value": {
              "en": "solve for a parameter",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ On grid-in answers",
          "ar": null
        },
        "body": {
          "en": "Student-produced responses accept fractions or decimals — enter \\( \\tfrac{3}{8} \\) or \\( .375 \\), and avoid rounding unless the question tells you to. If several answers are valid, any one is accepted.",
          "ar": null
        }
      }
    ]
  },
  "quizWidget": {
    "enabled": true
  }
}
