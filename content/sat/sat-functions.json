{
  "id": "sat-functions",
  "chapterNumber": "8",
  "title": {
    "en": "Functions &amp; Function Notation",
    "ar": null
  },
  "chapterTag": {
    "variant": "category",
    "className": "sat-domain-tag",
    "emoji": "📌",
