{
  "heading": "Exam practice",
  "icon": "⊘",
  "items": [
    {
      "number": 1,
      "question": {
        "en": "For \\( x=\\cos t,\\ y=\\sin t \\), find \\( \\dfrac{dy}{dx} \\) at \\( t=\\tfrac{\\pi}{2} \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>\\( \\dfrac{dy}{dx}=\\dfrac{\\cos t}{-\\sin t}=-\\cot t \\); at \\( t=\\tfrac{\\pi}{2} \\), \\( \\cot\\tfrac{\\pi}{2}=0 \\).</p>\\[ \\frac{dy}{dx}=0. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "FRQ"
    },
    {
      "number": 2,
      "question": {
        "en": "Does \\( \\displaystyle\\sum_{n=1}^{\\infty}\\frac{1}{n^2} \\) converge or diverge?",
        "ar": null
      },
      "solution": {
        "en": "<p>A \\( p \\)-series with \\( p=2&gt;1 \\), so it <strong>converges</strong> (in fact to \\( \\pi^2/6 \\)).</p>",
        "ar": null
      },
      "difficulty": "Basic",
      "levelLabel": "MCQ"
    },
    {
      "number": 3,
      "question": {
        "en": "Find the area enclosed by the polar curve \\( r=2 \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>\\( A=\\tfrac12\\displaystyle\\int_0^{2\\pi} r^2\\,d\\theta=\\tfrac12\\int_0^{2\\pi}4\\,d\\theta=\\tfrac12\\cdot 4\\cdot 2\\pi=4\\pi \\) — the circle of radius 2.</p>",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "FRQ"
    },
    {
      "number": 4,
      "question": {
        "en": "Differentiate \\( y=x^4-3x^2 \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ y'=4x^3-6x. \\]",
        "ar": null
      },
      "difficulty": "Basic",
      "levelLabel": "MCQ"
    },
    {
      "number": 5,
      "question": {
        "en": "Evaluate \\( \\displaystyle\\int_0^{2} 6x^2\\,dx \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ \\big[2x^3\\big]_0^{2}=16. \\]",
        "ar": null
      },
      "difficulty": "Basic",
      "levelLabel": "MCQ"
    },
    {
      "number": 6,
      "question": {
        "en": "Evaluate \\( \\displaystyle\\lim_{x\\to 0}\\frac{\\tan x}{x} \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ 1. \\]",
        "ar": null
      },
      "difficulty": "Basic",
      "levelLabel": "MCQ"
    },
    {
      "number": 7,
      "question": {
        "en": "Differentiate \\( y=e^{x^2} \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ y'=2x\\,e^{x^2}. \\]",
        "ar": null
      },
      "difficulty": "Basic",
      "levelLabel": "MCQ"
    },
    {
      "number": 8,
      "question": {
        "en": "Evaluate \\( \\displaystyle\\int x\\,e^{x^2}\\,dx \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>Let \\( u=x^2 \\), \\( x\\,dx=\\tfrac12\\,du \\):</p>\\[ \\tfrac12 e^{x^2}+C. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 9,
      "question": {
        "en": "Differentiate \\( y=\\arctan x \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ y'=\\frac{1}{1+x^2}. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 10,
      "question": {
        "en": "Evaluate \\( \\displaystyle\\int \\frac{1}{1+x^2}\\,dx \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ \\arctan x+C. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 11,
      "question": {
        "en": "Evaluate \\( \\displaystyle\\int x\\,e^{x}\\,dx \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>By parts:</p>\\[ e^{x}(x-1)+C. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "FRQ"
    },
    {
      "number": 12,
      "question": {
        "en": "Evaluate \\( \\displaystyle\\int \\ln x\\,dx \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ x\\ln x-x+C. \\]",
        "ar": null
      },
      "difficulty": "Advanced",
      "levelLabel": "FRQ"
    },
    {
      "number": 13,
      "question": {
        "en": "Evaluate \\( \\displaystyle\\int x\\sin x\\,dx \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>By parts, \\( u=x,\\ dv=\\sin x\\,dx \\):</p>\\[ -x\\cos x+\\sin x+C. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "FRQ"
    },
    {
      "number": 14,
      "question": {
        "en": "Evaluate \\( \\displaystyle\\int \\frac{1}{x^2-1}\\,dx \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>Partial fractions \\( \\tfrac12\\big(\\tfrac{1}{x-1}-\\tfrac{1}{x+1}\\big) \\):</p>\\[ \\tfrac12\\ln\\left|\\frac{x-1}{x+1}\\right|+C. \\]",
        "ar": null
      },
      "difficulty": "Advanced",
      "levelLabel": "FRQ"
    },
    {
      "number": 15,
      "question": {
        "en": "Evaluate \\( \\displaystyle\\int_1^{\\infty}\\frac{1}{x^2}\\,dx \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>Improper: \\( \\big[-\\tfrac1x\\big]_1^{\\infty}=0-(-1) \\):</p>\\[ 1. \\]",
        "ar": null
      },
      "difficulty": "Advanced",
      "levelLabel": "FRQ"
    },
    {
      "number": 16,
      "question": {
        "en": "Evaluate \\( \\displaystyle\\int_0^{\\infty} e^{-x}\\,dx \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ \\big[-e^{-x}\\big]_0^{\\infty}=0-(-1)=1. \\]",
        "ar": null
      },
      "difficulty": "Advanced",
      "levelLabel": "FRQ"
    },
    {
      "number": 17,
      "question": {
        "en": "Evaluate \\( \\displaystyle\\sum_{n=0}^{\\infty}\\Big(\\tfrac12\\Big)^{n} \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ \\frac{1}{1-\\tfrac12}=2. \\]",
        "ar": null
      },
      "difficulty": "Basic",
      "levelLabel": "MCQ"
    },
    {
      "number": 18,
      "question": {
        "en": "Evaluate \\( \\displaystyle\\sum_{n=0}^{\\infty}\\Big(\\tfrac13\\Big)^{n} \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ \\frac{1}{1-\\tfrac13}=\\frac32. \\]",
        "ar": null
      },
      "difficulty": "Basic",
      "levelLabel": "MCQ"
    },
    {
      "number": 19,
      "question": {
        "en": "Evaluate \\( \\displaystyle\\sum_{n=1}^{\\infty}\\Big(\\tfrac25\\Big)^{n} \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>First term \\( \\tfrac25 \\), ratio \\( \\tfrac25 \\):</p>\\[ \\frac{2/5}{1-2/5}=\\frac23. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 20,
      "question": {
        "en": "Does \\( \\displaystyle\\sum_{n=1}^{\\infty}\\frac1n \\) converge?",
        "ar": null
      },
      "solution": {
        "en": "<p>The harmonic series:</p>\\[ \\text{diverges}. \\]",
        "ar": null
      },
      "difficulty": "Basic",
      "levelLabel": "MCQ"
    },
    {
      "number": 21,
      "question": {
        "en": "Does \\( \\displaystyle\\sum_{n=0}^{\\infty}(0.9)^{n} \\) converge, and to what?",
        "ar": null
      },
      "solution": {
        "en": "<p>Geometric with \\( |r|&lt;1 \\):</p>\\[ \\frac{1}{1-0.9}=10. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 22,
      "question": {
        "en": "Does \\( \\displaystyle\\sum_{n=1}^{\\infty}\\frac{1}{\\sqrt{n}} \\) converge?",
        "ar": null
      },
      "solution": {
        "en": "<p>\\( p \\)-series with \\( p=\\tfrac12\\le 1 \\):</p>\\[ \\text{diverges}. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 23,
      "question": {
        "en": "Does \\( \\displaystyle\\sum_{n=1}^{\\infty}\\frac{n}{n+1} \\) converge?",
        "ar": null
      },
      "solution": {
        "en": "<p>Terms \\( \\to 1\\neq 0 \\), so by the \\( n \\)th-term test:</p>\\[ \\text{diverges}. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 24,
      "question": {
        "en": "Evaluate \\( \\displaystyle\\sum_{n=0}^{\\infty} 3\\Big(\\tfrac14\\Big)^{n} \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ \\frac{3}{1-\\tfrac14}=4. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 25,
      "question": {
        "en": "For what \\( x \\) does \\( \\displaystyle\\sum_{n=0}^{\\infty}\\frac{x^n}{n!} \\) converge?",
        "ar": null
      },
      "solution": {
        "en": "<p>Ratio test: \\( \\big|\\tfrac{x}{n+1}\\big|\\to 0&lt;1 \\) always:</p>\\[ \\text{all real } x. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "FRQ"
    },
    {
      "number": 26,
      "question": {
        "en": "Write the Maclaurin series for \\( e^{x} \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ e^{x}=\\sum_{n=0}^{\\infty}\\frac{x^{n}}{n!}=1+x+\\tfrac{x^2}{2}+\\cdots. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 27,
      "question": {
        "en": "Give the first three nonzero terms of the Maclaurin series for \\( \\sin x \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ x-\\frac{x^3}{6}+\\frac{x^5}{120}. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "FRQ"
    },
    {
      "number": 28,
      "question": {
        "en": "Give the first three terms of the Maclaurin series for \\( \\cos x \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ 1-\\frac{x^2}{2}+\\frac{x^4}{24}. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "FRQ"
    },
    {
      "number": 29,
      "question": {
        "en": "Use a two-term Maclaurin polynomial for \\( e^{x} \\) to approximate \\( e^{0.1} \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>\\( e^{x}\\approx 1+x \\) at \\( x=0.1 \\):</p>\\[ 1+0.1=1.1. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "FRQ"
    },
    {
      "number": 30,
      "question": {
        "en": "Find the interval of convergence of \\( \\displaystyle\\sum_{n=0}^{\\infty} x^{n} \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>Geometric, converges for \\( |x|&lt;1 \\):</p>\\[ (-1,1). \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "FRQ"
    },
    {
      "number": 31,
      "question": {
        "en": "Find the interval of convergence of \\( \\displaystyle\\sum_{n=1}^{\\infty}\\frac{x^n}{n} \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>Ratio test gives \\( |x|&lt;1 \\). Endpoints: \\( x=1 \\) diverges (harmonic), \\( x=-1 \\) converges (alternating):</p>\\[ [-1,1). \\]",
        "ar": null
      },
      "difficulty": "Advanced",
      "levelLabel": "FRQ"
    },
    {
      "number": 32,
      "question": {
        "en": "Evaluate \\( \\displaystyle\\sum_{n=1}^{\\infty}\\frac{1}{n(n+1)} \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>Telescoping: \\( \\tfrac1n-\\tfrac{1}{n+1} \\):</p>\\[ \\sum_{n=1}^{\\infty}\\Big(\\tfrac1n-\\tfrac{1}{n+1}\\Big)=1. \\]",
        "ar": null
      },
      "difficulty": "Advanced",
      "levelLabel": "FRQ"
    },
    {
      "number": 33,
      "question": {
        "en": "Does \\( \\displaystyle\\sum_{n=1}^{\\infty}\\frac{(-1)^n}{n} \\) converge?",
        "ar": null
      },
      "solution": {
        "en": "<p>The alternating harmonic series satisfies the alternating series test:</p>\\[ \\text{converges}. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 34,
      "question": {
        "en": "Find the radius of convergence of \\( \\displaystyle\\sum_{n=0}^{\\infty}\\frac{x^n}{2^n} \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>Geometric in \\( \\tfrac{x}{2} \\); converges for \\( \\big|\\tfrac{x}{2}\\big|&lt;1 \\):</p>\\[ R=2. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "FRQ"
    },
    {
      "number": 35,
      "question": {
        "en": "For \\( x=t^2,\\ y=t^3 \\), find \\( \\dfrac{dy}{dx} \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ \\frac{dy}{dx}=\\frac{3t^2}{2t}=\\frac{3t}{2}. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 36,
      "question": {
        "en": "For \\( x=e^{t},\\ y=e^{2t} \\), find \\( \\dfrac{dy}{dx} \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ \\frac{dy}{dx}=\\frac{2e^{2t}}{e^{t}}=2e^{t}. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 37,
      "question": {
        "en": "For \\( x=t^2,\\ y=2t \\), find \\( \\dfrac{dy}{dx} \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ \\frac{dy}{dx}=\\frac{2}{2t}=\\frac1t. \\]",
        "ar": null
      },
      "difficulty": "Basic",
      "levelLabel": "MCQ"
    },
    {
      "number": 38,
      "question": {
        "en": "For \\( x=3t,\\ y=t^2-1 \\), find \\( \\dfrac{dy}{dx} \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ \\frac{dy}{dx}=\\frac{2t}{3}. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 39,
      "question": {
        "en": "Find the arc length of \\( x=t,\\ y=t \\) for \\( t\\in[0,1] \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ L=\\int_0^{1}\\sqrt{1^2+1^2}\\,dt=\\sqrt2. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "FRQ"
    },
    {
      "number": 40,
      "question": {
        "en": "For \\( x=t^3,\\ y=t^2 \\), find \\( \\dfrac{dy}{dx} \\) at \\( t=1 \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ \\frac{2t}{3t^2}\\Big|_{t=1}=\\frac23. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 41,
      "question": {
        "en": "Find the speed of a particle with \\( x=t^2,\\ y=t^2 \\) at \\( t=1 \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>Speed \\( =\\sqrt{(2t)^2+(2t)^2}=2\\sqrt2\\,t \\) at \\( t=1 \\):</p>\\[ 2\\sqrt2. \\]",
        "ar": null
      },
      "difficulty": "Advanced",
      "levelLabel": "FRQ"
    },
    {
      "number": 42,
      "question": {
        "en": "Convert the polar point \\( \\big(2,\\tfrac{\\pi}{2}\\big) \\) to rectangular coordinates.",
        "ar": null
      },
      "solution": {
        "en": "<p>\\( x=2\\cos\\tfrac{\\pi}{2}=0,\\ y=2\\sin\\tfrac{\\pi}{2}=2 \\):</p>\\[ (0,2). \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 43,
      "question": {
        "en": "Find the area enclosed by \\( r=4 \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ \\tfrac12\\int_0^{2\\pi}16\\,d\\theta=16\\pi. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 44,
      "question": {
        "en": "Convert the rectangular point \\( (0,-3) \\) to polar coordinates.",
        "ar": null
      },
      "solution": {
        "en": "<p>\\( r=3 \\), and the point is on the negative \\( y \\)-axis:</p>\\[ \\big(3,\\tfrac{3\\pi}{2}\\big). \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 45,
      "question": {
        "en": "Find the area enclosed by the cardioid \\( r=1+\\cos\\theta \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ \\tfrac12\\int_0^{2\\pi}\\big(1+\\cos\\theta\\big)^2\\,d\\theta=\\frac{3\\pi}{2}. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "FRQ"
    },
    {
      "number": 46,
      "question": {
        "en": "Convert the rectangular point \\( (1,1) \\) to polar coordinates.",
        "ar": null
      },
      "solution": {
        "en": "<p>\\( r=\\sqrt2 \\), \\( \\theta=\\arctan 1=\\tfrac{\\pi}{4} \\):</p>\\[ \\big(\\sqrt2,\\tfrac{\\pi}{4}\\big). \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 47,
      "question": {
        "en": "Find the area enclosed by \\( r=3 \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ \\tfrac12\\int_0^{2\\pi}9\\,d\\theta=9\\pi. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    },
    {
      "number": 48,
      "question": {
        "en": "The polar curve \\( r=2\\cos\\theta \\) is a circle. Find its enclosed area.",
        "ar": null
      },
      "solution": {
        "en": "<p>It is a circle of radius 1; equivalently \\( \\tfrac12\\int_{-\\pi/2}^{\\pi/2}4\\cos^2\\theta\\,d\\theta \\):</p>\\[ \\pi. \\]",
        "ar": null
      },
      "difficulty": "Advanced",
      "levelLabel": "FRQ"
    },
    {
      "number": 49,
      "question": {
        "en": "Solve \\( \\dfrac{dy}{dx}=3y \\) with \\( y(0)=1 \\).",
        "ar": null
      },
      "solution": {
        "en": "\\[ y=e^{3x}. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "FRQ"
    },
    {
      "number": 50,
      "question": {
        "en": "Solve \\( \\dfrac{dy}{dx}=-2y \\) with \\( y(0)=10 \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>Exponential decay, \\( k=-2 \\):</p>\\[ y=10e^{-2x}. \\]",
        "ar": null
      },
      "difficulty": "Intermediate",
      "levelLabel": "MCQ"
    }
  ]
}
