          },
          {
            "label": {
              "en": "Unit 10",
              "ar": null
            },
            "value": {
              "en": "Infinite sequences & series",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "text",
        "body": {
          "en": "The exam format matches AB (multiple choice 50%, free response 50%), and a BC result also reports an <strong>AB subscore</strong>.",
