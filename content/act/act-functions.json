              "en": "vertex",
              "ar": null
            },
            "colorClass": "amber",
            "value": "—"
          },
          {
            "id": "actFuncAxis",
            "label": {
              "en": "axis of symmetry",
              "ar": null
            },
            "colorClass": "indigo",
            "value": "—"
          }
        ],
        "note": {
          "en": "Moving \\( h \\) slides the curve left/right; \\( k \\) slides it up/down.",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Evaluate",
              "ar": null
            },
            "value": {
              "en": "\\( f(a) \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Composite",
              "ar": null
            },
            "value": {
              "en": "\\( f(g(x)) \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Vertex form",
              "ar": null
            },
            "value": {
              "en": "\\( a(x-h)^{2}+k \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Rate of change",
              "ar": null
            },
            "value": {
              "en": "\\( \\dfrac{f(b)-f(a)}{b-a} \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 3.A",
          "ar": null
        },
        "body": {
          "en": "If \\( f(x)=x^{2}-1 \\), find \\( f(3) \\). \\[ 9-1=8. \\]",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 3.B",
          "ar": null
        },
        "body": {
          "en": "If \\( f(x)=2x+1 \\) and \\( g(x)=x^{2} \\), find \\( f(g(2)) \\). <p>\\( g(2)=4 \\), then \\( f(4)=9 \\):</p>\\[ 9. \\]",
          "ar": null
        }
      },
      {
        "kind": "practiceProblem",
        "question": {
          "en": "If \\(f(x) = x^2 - 1\\) and \\(g(x) = 2x + 3\\), find \\(f(g(1))\\).",
          "ar": null
        },
        "solution": {
          "en": "\\(g(1) = 5\\). \\(f(5) = 25 - 1 = 24\\).",
          "ar": null
        }
      }
    ]
  },
