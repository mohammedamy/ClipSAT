  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "Averages and spread, basic counting, and the probability of simple and combined events.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ Reference — Data & chance",
          "ar": null
        },
        "body": {
          "en": "Mean is total over count; the median is the middle value. Probability \\( =\\dfrac{\\text{favourable}}{\\text{total}} \\); independent events multiply: \\( P(A\\text{ and }B)=P(A)\\cdot P(B) \\).",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Mean",
              "ar": null
            },
            "value": {
              "en": "\\( \\dfrac{\\text{sum}}{\\text{count}} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Median",
              "ar": null
            },
            "value": {
              "en": "middle value",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Probability",
              "ar": null
            },
            "value": {
              "en": "\\( \\dfrac{\\text{fav}}{\\text{total}} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Independent",
              "ar": null
            },
            "value": {
              "en": "\\( P(A)\\cdot P(B) \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 7.A",
          "ar": null
        },
        "body": {
          "en": "Find the mean of \\( 4,\\,8,\\,10,\\,18 \\). \\[ \\frac{40}{4}=10. \\]",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 7.B",
          "ar": null
        },
        "body": {
          "en": "A fair coin is tossed twice. Find \\( P(\\text{two heads}) \\). \\[ \\tfrac12\\cdot\\tfrac12=\\tfrac14. \\]",
          "ar": null
        }
      },
      {
        "kind": "practiceProblem",
        "question": {
          "en": "A data set is: 4, 7, 7, 9, 12, 15. Find the mean, median, and range.",
          "ar": null
        },
        "solution": {
          "en": "Mean \\(= 54/6 = 9\\). Median \\(= (7+9)/2 = 8\\). Range \\(= 15-4 = 11\\).",
          "ar": null
        }
      }
    ]
  },
