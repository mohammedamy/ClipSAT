{
  "id": "act-coordgeo",
  "chapterNumber": "4",
  "title": {
    "en": "Coordinate Geometry",
    "ar": null
  },
  "chapterTag": {
    "variant": "category",
    "className": "act-tag",
    "badgeClassName": "act-wt",
    "emoji": "🗻",
    "category": "Coordinate Geometry",
    "weightBadge": "12–15%",
    "topics": [
      "Slope & equations of lines",
      "Distance & midpoint",
      "Circles",
      "Parabolas"
    ]
  },
  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "Lines in the plane: slope, intercepts, distance and midpoint, and the equations of lines.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ Reference — The coordinate plane",
          "ar": null
        },
        "body": {
          "en": "Slope \\( m=\\dfrac{y_2-y_1}{x_2-x_1} \\); line \\( y=mx+b \\). Distance \\( \\sqrt{(x_2-x_1)^2+(y_2-y_1)^2} \\); midpoint \\( \\left(\\tfrac{x_1+x_2}{2},\\tfrac{y_1+y_2}{2}\\right) \\).",
          "ar": null
        }
      },
      {
        "kind": "text",
        "body": {
          "en": "Adjust slope \\( m \\) and intercept \\( b \\) of \\( y=mx+b \\); the amber dots are the intercepts.",
          "ar": null
        }
      },
      {
        "kind": "explorer",
        "title": {
          "en": "⊙ Explorer · Slope & intercepts",
          "ar": null
        },
        "canvasId": "actLineCanvas",
        "ariaLabel": {
          "en": "A line y equals m x plus b with adjustable slope and intercept",
          "ar": null
        },
        "dataPanel": {
          "btnId": "actLineDataBtn",
          "panelId": "actLineDataPanel",
          "descId": "actLineDataDesc",
          "rowsId": "actLineDataRows",
          "caption": {
            "en": "Sampled points along the current line",
            "ar": null
          },
          "columns": [
            {
              "en": "x",
              "ar": null
            },
            {
              "en": "y",
              "ar": null
            }
          ]
        },
        "controls": [
          {
            "id": "actM",
            "valueDisplayId": "actMV",
            "label": {
              "en": "Slope <b>m =</b>",
              "ar": null
            },
            "ariaLabel": {
              "en": "Slope m",
              "ar": null
            },
            "min": -3,
            "max": 3,
            "value": 1,
            "step": 0.5
          },
          {
            "id": "actB",
            "valueDisplayId": "actBV",
            "label": {
              "en": "Intercept <b>b =</b>",
              "ar": null
            },
            "ariaLabel": {
              "en": "Intercept b",
              "ar": null
            },
            "min": -5,
            "max": 5,
            "value": 0,
            "step": 1
          }
        ],
        "readouts": [
          {
            "id": "actLineSlope",
            "label": {
              "en": "slope",
              "ar": null
            },
            "colorClass": "indigo",
            "value": "—"
          },
          {
            "id": "actLineYint",
            "label": {
              "en": "y-intercept",
              "ar": null
            },
            "colorClass": "amber",
            "value": "—"
          },
          {
            "id": "actLineXint",
            "label": {
              "en": "x-intercept",
              "ar": null
            },
            "colorClass": "amber",
            "value": "—"
          }
        ],
        "note": {
          "en": "Parallel lines share a slope; perpendicular slopes multiply to \\( -1 \\).",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Slope",
              "ar": null
            },
            "value": {
              "en": "\\( \\dfrac{y_2-y_1}{x_2-x_1} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Distance",
              "ar": null
            },
            "value": {
              "en": "\\( \\sqrt{\\Delta x^{2}+\\Delta y^{2}} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Midpoint",
              "ar": null
            },
            "value": {
              "en": "\\( \\left(\\tfrac{x_1+x_2}{2},\\tfrac{y_1+y_2}{2}\\right) \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Line",
              "ar": null
            },
            "value": {
              "en": "\\( y=mx+b \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 4.A",
          "ar": null
        },
        "body": {
          "en": "Find the distance between \\( (0,0) \\) and \\( (3,4) \\). \\[ \\sqrt{9+16}=5. \\]",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 4.B",
          "ar": null
        },
        "body": {
          "en": "Find the midpoint of \\( (2,4) \\) and \\( (6,8) \\). \\[ (4,\\,6). \\]",
          "ar": null
        }
      },
      {
        "kind": "practiceProblem",
        "question": {
          "en": "What is the equation of the circle with centre \\((-2, 4)\\) and radius \\(5\\)?",
          "ar": null
        },
        "solution": {
          "en": "\\((x+2)^2 + (y-4)^2 = 25\\).",
          "ar": null
        }
      }
    ]
  },
  "quizWidget": {
    "enabled": true
  }
}
