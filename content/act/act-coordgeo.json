              "ar": null
            },
            "min": -5,
            "max": 5,
            "value": 0,
            "step": 1
          }
        ],
        "readouts": [
          {
            "id": "actLineSlope",
            "label": {
              "en": "slope",
              "ar": null
            },
            "colorClass": "indigo",
            "value": "—"
          },
          {
            "id": "actLineYint",
            "label": {
              "en": "y-intercept",
              "ar": null
            },
            "colorClass": "amber",
            "value": "—"
          },
          {
            "id": "actLineXint",
            "label": {
              "en": "x-intercept",
              "ar": null
            },
            "colorClass": "amber",
            "value": "—"
          }
        ],
        "note": {
          "en": "Parallel lines share a slope; perpendicular slopes multiply to \\( -1 \\).",
          "ar": null
        }
      },
      {
        "kind": "figure",
        "figure": {
          "type": "fn",
          "title": "Perpendicular Lines: Negative Reciprocal Slopes",
          "xrange": [
            -1,
            5
          ],
          "yrange": [
            -2,
            6
          ],
          "fns": [
            {
              "fn": "2*x - 1",
              "color": "var(--fig-indigo-2)",
              "label": "L₁: y = 2x - 1 (m = 2)"
            },
            {
              "fn": "-0.5*x + 4",
              "color": "var(--fig-amber)",
              "label": "L₂: y = -0.5x + 4 (m = -1/2)"
            }
          ],
          "points": [
            {
              "x": 2,
              "y": 3,
              "label": "Intersection (2, 3)"
            }
          ],
          "hlines": [
            {
              "y": 0,
              "color": "var(--fig-muted)",
              "dash": "4,3",
              "label": "y = 0"
            }
          ]
        },
        "caption": {
          "en": "Perpendicular lines \\( L_1 \\) and \\( L_2 \\) intersecting at right angles at \\( (2, 3) \\). The product of their slopes satisfies \\( m_1 \\cdot m_2 = 2 \\cdot (-0.5) = -1 \\) (negative reciprocals).",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Slope",
              "ar": null
            },
            "value": {
              "en": "\\( \\dfrac{y_2-y_1}{x_2-x_1} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Distance",
              "ar": null
            },
            "value": {
              "en": "\\( \\sqrt{\\Delta x^{2}+\\Delta y^{2}} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Midpoint",
              "ar": null
            },
            "value": {
              "en": "\\( \\left(\\tfrac{x_1+x_2}{2},\\tfrac{y_1+y_2}{2}\\right) \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Line",
              "ar": null
            },
            "value": {
              "en": "\\( y=mx+b \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "warn",
        "label": {
          "en": "⚠️ Classic ACT Traps: Coordinate Geometry",
          "ar": null
        },
        "body": {
          "en": "<ul><li><strong>Perpendicular Slopes:</strong> Perpendicular lines have slopes that are negative reciprocals: \\( m_2 = -\\frac{1}{m_1} \\). A line perpendicular to \\( y = \\frac{2}{3}x - 5 \\) has slope \\( -\\frac{3}{2} \\), NOT \\( \\frac{3}{2} \\) and NOT \\( -\\frac{2}{3} \\).</li><li><strong>Circle Equation Center Signs:</strong> The equation \\( (x - h)^2 + (y - k)^2 = r^2 \\) subtracts coordinates. A circle with equation \\( (x + 3)^2 + (y - 4)^2 = 49 \\) has center \\( (-3, 4) \\) and radius \\( r = 7 \\), NOT \\( 49 \\)!</li><li><strong>Finding an Missing Endpoint from Midpoint:</strong> If \\( M(x_m, y_m) \\) is the midpoint of \\( \\overline{AB} \\) and you know \\( A(x_a, y_a) \\), do NOT average \\( A \\) and \\( M \\)! Use the step method: \\( x_b = 2x_m - x_a \\) and \\( y_b = 2y_m - y_a \\).</li><li><strong>Horizontal and Vertical Lines:</strong> Horizontal lines have slope \\( m = 0 \\) and equation \\( y = c \\); vertical lines have <strong>undefined slope</strong> and equation \\( x = c \\).</li></ul>",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 4.A",
          "ar": null
        },
        "body": {
          "en": "Find the distance between \\( (0,0) \\) and \\( (3,4) \\). \\[ \\sqrt{9+16}=5. \\]",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 4.B",
          "ar": null
        },
        "body": {
          "en": "Find the midpoint of \\( (2,4) \\) and \\( (6,8) \\). \\[ (4,\\,6). \\]",
          "ar": null
        }
      },
      {
        "kind": "practiceProblem",
        "question": {
          "en": "What is the equation of the circle with centre \\((-2, 4)\\) and radius \\(5\\)?",
          "ar": null
        },
        "solution": {
          "en": "\\((x+2)^2 + (y-4)^2 = 25\\).",
          "ar": null
        }
      },
      {
        "kind": "practiceProblem",
        "question": {
          "en": "Point \\(M(3, -2)\\) is the midpoint of line segment \\(\\overline{AB}\\). If point \\(A\\) has coordinates \\((-1, 4)\\), what are the coordinates of point \\(B\\)?",
          "ar": null
        },
        "solution": {
          "en": "Using the midpoint formula for each coordinate:<br>\\(x_M = \\frac{x_A + x_B}{2} \\Rightarrow 3 = \\frac{-1 + x_B}{2} \\Rightarrow 6 = -1 + x_B \\Rightarrow x_B = 7\\).<br>\\(y_M = \\frac{y_A + y_B}{2} \\Rightarrow -2 = \\frac{4 + y_B}{2} \\Rightarrow -4 = 4 + y_B \\Rightarrow y_B = -8\\).<br>Coordinates of \\(B\\): <strong>(7, -8)</strong>.",
          "ar": null
        }
      }
    ]
  },
