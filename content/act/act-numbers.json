  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "Pre-algebra fundamentals: fractions and decimals, percentages, ratios and proportions, factors and multiples.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ Reference — Proportional reasoning",
          "ar": null
        },
        "body": {
          "en": "Percent of a number: \\( \\tfrac{p}{100}\\times N \\). A ratio \\( a:b \\) splits a total into \\( a+b \\) equal parts. Set up a proportion \\( \\tfrac{a}{b}=\\tfrac{c}{d} \\) and cross-multiply.",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Percent of",
              "ar": null
            },
            "value": {
              "en": "\\( \\tfrac{p}{100}\\times N \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Percent change",
              "ar": null
            },
            "value": {
              "en": "\\( \\tfrac{\\text{new}-\\text{old}}{\\text{old}} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Ratio parts",
              "ar": null
            },
            "value": {
              "en": "total \\( \\div (a+b) \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Proportion",
              "ar": null
            },
            "value": {
              "en": "cross-multiply",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 1.A",
          "ar": null
        },
        "body": {
          "en": "What is \\( 15\\% \\) of \\( 200 \\)? \\[ 0.15\\times200=30. \\]",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 1.B",
          "ar": null
        },
        "body": {
          "en": "Split \\( 30 \\) in the ratio \\( 2:3 \\). Find the smaller part. <p>Five parts, each \\( 6 \\); smaller is 2 parts:</p>\\[ 12. \\]",
          "ar": null
        }
      },
      {
        "kind": "practiceProblem",
        "question": {
          "en": "A jacket costs $120 after a 25% discount. What was the original price?",
          "ar": null
        },
        "solution": {
          "en": "Let original = \\(x\\). \\(0.75x = 120 \\Rightarrow x = 160\\). Original price: <strong>$160</strong>.",
          "ar": null
        }
      }
    ]
  },
