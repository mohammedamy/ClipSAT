  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "Right-triangle ratios, the values of common angles, and reading the sine curve.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ Reference — SOH-CAH-TOA",
          "ar": null
        },
        "body": {
          "en": "\\( \\sin\\theta=\\dfrac{\\text{opp}}{\\text{hyp}} \\), \\( \\cos\\theta=\\dfrac{\\text{adj}}{\\text{hyp}} \\), \\( \\tan\\theta=\\dfrac{\\text{opp}}{\\text{adj}} \\). Common values: \\( \\sin30^{\\circ}=\\tfrac12 \\), \\( \\cos60^{\\circ}=\\tfrac12 \\), \\( \\tan45^{\\circ}=1 \\).",
          "ar": null
        }
      },
      {
        "kind": "text",
        "body": {
          "en": "Slide the angle \\( \\theta \\) along the sine curve. The readouts give \\( \\sin\\theta \\) and \\( \\cos\\theta \\).",
          "ar": null
        }
      },
      {
        "kind": "explorer",
        "title": {
          "en": "⊙ Explorer · The sine curve",
          "ar": null
        },
        "canvasId": "actTrigCanvas",
        "ariaLabel": {
          "en": "The sine curve with a movable angle marker",
          "ar": null
        },
        "dataPanel": {
          "btnId": "actTrigDataBtn",
          "panelId": "actTrigDataPanel",
          "descId": "actTrigDataDesc",
          "rowsId": "actTrigDataRows",
          "caption": {
            "en": "sin(θ) sampled every 45° around the circle",
            "ar": null
          },
          "columns": [
            {
              "en": "θ",
              "ar": null
            },
            {
              "en": "sin(θ)",
              "ar": null
            }
          ]
        },
        "controls": [
          {
            "id": "actAngle",
            "valueDisplayId": "actAngleV",
            "label": {
              "en": "Angle <b>θ =</b>",
              "ar": null
            },
            "ariaLabel": {
              "en": "Angle θ",
              "ar": null
            },
            "min": 0,
            "max": 360,
            "value": 30,
            "step": 5
          }
        ],
        "readouts": [
          {
            "id": "actSin",
            "label": {
              "en": "sin θ",
              "ar": null
            },
            "colorClass": "indigo"
          },
          {
            "id": "actCos",
            "label": {
              "en": "cos θ",
              "ar": null
            },
            "colorClass": "amber"
          }
        ],
        "note": {
          "en": "Sine peaks at \\( 90^{\\circ} \\), is zero at \\( 0^{\\circ} \\) and \\( 180^{\\circ} \\), and bottoms at \\( 270^{\\circ} \\).",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Sine",
              "ar": null
            },
            "value": {
              "en": "\\( \\tfrac{\\text{opp}}{\\text{hyp}} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Cosine",
              "ar": null
            },
            "value": {
              "en": "\\( \\tfrac{\\text{adj}}{\\text{hyp}} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Tangent",
              "ar": null
            },
            "value": {
              "en": "\\( \\tfrac{\\text{opp}}{\\text{adj}} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Identity",
              "ar": null
            },
            "value": {
              "en": "\\( \\sin^{2}\\theta+\\cos^{2}\\theta=1 \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 6.A",
          "ar": null
        },
        "body": {
          "en": "A right triangle has opposite \\( 3 \\) and hypotenuse \\( 5 \\). Find \\( \\sin\\theta \\). \\[ \\sin\\theta=\\tfrac{3}{5}. \\]",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 6.B",
          "ar": null
        },
        "body": {
          "en": "Evaluate \\( \\tan45^{\\circ} \\). \\[ 1. \\]",
          "ar": null
        }
      },
      {
        "kind": "practiceProblem",
        "question": {
          "en": "In right triangle \\(ABC\\) with \\(C = 90°\\), \\(a = 5\\), \\(c = 13\\). Find \\(\\sin A\\), \\(\\cos A\\), \\(\\tan A\\).",
          "ar": null
        },
        "solution": {
          "en": "\\(b = \\sqrt{169-25} = 12\\). \\(\\sin A = 5/13\\), \\(\\cos A = 12/13\\), \\(\\tan A = 5/12\\).",
          "ar": null
        }
      }
    ]
  },
  "quizWidget": {
    "enabled": true
  }
}
