  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "Linear equations, quadratics, exponents, radicals and absolute value — the algebraic core of the test.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ Reference — Algebra essentials",
          "ar": null
        },
        "body": {
          "en": "Quadratic formula \\( x=\\dfrac{-b\\pm\\sqrt{b^{2}-4ac}}{2a} \\); difference of squares \\( a^{2}-b^{2}=(a-b)(a+b) \\). Exponents: \\( a^{m}a^{n}=a^{m+n} \\). Absolute value \\( |x|=c \\) gives \\( x=\\pm c \\).",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Quadratic formula",
              "ar": null
            },
            "value": {
              "en": "\\( \\dfrac{-b\\pm\\sqrt{b^{2}-4ac}}{2a} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Difference of squares",
              "ar": null
            },
            "value": {
              "en": "\\( (a-b)(a+b) \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Exponents",
              "ar": null
            },
            "value": {
              "en": "\\( a^{m}a^{n}=a^{m+n} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Absolute value",
              "ar": null
            },
            "value": {
              "en": "\\( x=\\pm c \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 2.A",
          "ar": null
        },
        "body": {
          "en": "Solve \\( 3(x-2)=12 \\). <p>\\( x-2=4 \\):</p>\\[ x=6. \\]",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 2.B",
          "ar": null
        },
        "body": {
          "en": "Simplify \\( \\sqrt{50} \\). \\[ \\sqrt{25\\cdot 2}=5\\sqrt{2}. \\]",
          "ar": null
        }
      },
      {
        "kind": "practiceProblem",
        "question": {
          "en": "For what values of \\(x\\) is \\(|2x - 3| < 7\\)?",
          "ar": null
        },
        "solution": {
          "en": "\\(-7 < 2x-3 < 7 \\Rightarrow -4 < 2x < 10 \\Rightarrow -2 < x < 5\\).",
          "ar": null
        }
      }
    ]
  },
