      {
        "kind": "text",
        "body": {
          "en": "The EST I Mathematics section tests core algebraic reasoning, problem-solving, and quantitative analysis in two parts — one without a calculator and one with. It is the primary university-admissions standardised test for international and American-diploma students across the Middle East.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "note",
        "label": {
          "en": "What to expect",
          "ar": null
        },
        "body": {
          "en": "The EST I Math test runs for <strong>90 minutes</strong> across two sections: <strong>Section I</strong> (30 min, no calculator — focuses on algebra and number sense) and <strong>Section II</strong> (60 min, calculator permitted — broader topics). The test contains <strong>45 multiple-choice</strong> questions and <strong>13 short constructed-response</strong> items.",
          "ar": null
        }
      },
