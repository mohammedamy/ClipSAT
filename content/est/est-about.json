      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ Three tactics that score",
          "ar": null
        },
        "body": {
          "en": "Master linear equations cold for the no-calculator section. On Section II, write down formulas before you compute. For constructed responses, double-check rounding — the EST often asks for exact fractions.",
          "ar": null
