      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 7.A",
          "ar": null
        },
        "body": {
          "en": "In a right triangle, the hypotenuse is 13 and one leg is 5. Find \\( \\sin\\theta \\) for the angle opposite the leg of length 12. \\[ \\text{other leg}=\\sqrt{13^2-5^2}=12,\\quad \\sin\\theta=\\frac{12}{13}. \\]",
          "ar": null
        }
      },
      {
