  "items": [
    {
      "number": "D1",
      "question": {
        "en": "Solve \\( \\dfrac{dy}{dx}=-2y \\), \\( y(0)=4 \\). Find \\( y(1) \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>\\( \\dfrac{dy}{y}=-2\\,dx \\Rightarrow \\ln|y|=-2x+C \\Rightarrow y=Ae^{-2x} \\). \\( y(0)=A=4 \\), so \\[ y=4e^{-2x},\\qquad y(1)=4e^{-2}\\approx0.541. \\]</p>",
        "ar": null
      },
      "difficulty": "Basic"
    },
    {
      "number": "D2",
      "question": {
        "en": "Solve \\( \\dfrac{dy}{dx}=x^2 \\), \\( y(1)=2 \\). Find \\( y(2) \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>\\( dy=x^2\\,dx \\Rightarrow y=\\dfrac{x^3}{3}+C \\). \\( y(1)=\\dfrac13+C=2\\Rightarrow C=\\dfrac53 \\). So \\[ y=\\frac{x^3}{3}+\\frac53,\\qquad y(2)=\\frac83+\\frac53=\\frac{13}{3}. \\]</p>",
        "ar": null
      },
      "difficulty": "Basic"
    },
    {
      "number": "D3",
      "question": {
        "en": "Solve \\( \\dfrac{dy}{dx}=\\dfrac{y}{x} \\) for \\( x,y&gt;0 \\), with \\( y(1)=2 \\). Find \\( y(4) \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>\\( \\dfrac{dy}{y}=\\dfrac{dx}{x} \\Rightarrow \\ln y=\\ln x+C \\Rightarrow y=Ax \\). \\( y(1)=A=2 \\), so \\[ y=2x,\\qquad y(4)=8. \\]</p>",
        "ar": null
      },
      "difficulty": "Intermediate"
    },
    {
      "number": "D4",
      "question": {
        "en": "Solve \\( \\dfrac{dy}{dx}=xy^2 \\), \\( y(0)=\\dfrac12 \\). Find \\( y(1) \\).",
        "ar": null
      },
      "solution": {
        "en": "<p>\\( \\dfrac{dy}{y^2}=x\\,dx \\Rightarrow -\\dfrac1y=\\dfrac{x^2}{2}+C \\). \\( y(0)=\\tfrac12 \\Rightarrow -2=C \\). So \\( -\\dfrac1y=\\dfrac{x^2}{2}-2 \\Rightarrow y=\\dfrac{-1}{\\tfrac{x^2}{2}-2}=\\dfrac{2}{4-x^2} \\), and \\[ y(1)=\\frac{2}{3}. \\]</p>",
        "ar": null
      },
      "difficulty": "Advanced"
    }
  ]
