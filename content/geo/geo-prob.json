  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "Probability measures the chance of an event, including area-based (geometric) models.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ Reference — Probability",
          "ar": null
        },
        "body": {
          "en": "<p>\\( P=\\tfrac{\\text{favourable}}{\\text{total}} \\). Geometric probability compares lengths or areas. Independent events multiply, and \\( P(\\text{not }A)=1-P(A) \\).</p>",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Probability",
              "ar": null
            },
            "value": {
              "en": "\\( \\tfrac{\\text{fav}}{\\text{total}} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Geometric",
              "ar": null
            },
            "value": {
              "en": "ratio of areas",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Independent",
              "ar": null
            },
            "value": {
              "en": "\\( P(A)P(B) \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Complement",
              "ar": null
            },
            "value": {
              "en": "\\( 1-P \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 11.A",
          "ar": null
        },
        "body": {
          "en": "<p>A point lands in a \\( 10\\times10 \\) square. Find the chance it lands in a \\( 2\\times2 \\) corner.</p>\\[ \\frac{4}{100}=0.04. \\]",
          "ar": null
        }
      }
    ]
  }
