{
  "id": "geo-coord",
  "chapterNumber": "10",
  "title": {
    "en": "Coordinate Geometry",
    "ar": null
  },
  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "Placing figures on the plane lets us use distance, midpoint and slope to prove geometric facts.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ Reference — On the plane",
          "ar": null
        },
        "body": {
          "en": "<p>Distance \\( \\sqrt{(x_2-x_1)^{2}+(y_2-y_1)^{2}} \\); midpoint \\( \\left(\\tfrac{x_1+x_2}{2},\\tfrac{y_1+y_2}{2}\\right) \\). Parallel lines share a slope; perpendicular slopes multiply to \\( -1 \\).</p>",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Distance",
              "ar": null
            },
            "value": {
              "en": "\\( \\sqrt{\\Delta x^{2}+\\Delta y^{2}} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Midpoint",
              "ar": null
            },
            "value": {
              "en": "average the ends",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Parallel",
              "ar": null
            },
            "value": {
              "en": "equal slopes",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Perpendicular",
              "ar": null
            },
            "value": {
              "en": "\\( m_1m_2=-1 \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "explorer",
        "title": {
          "en": "⊙ Explorer · Distance, midpoint &amp; slope",
          "ar": null
        },
        "canvasId": "geoDistCanvas",
        "ariaLabel": {
          "en": "Two points on the plane joined by a segment, with the midpoint marked",
          "ar": null
        },
        "dataPanel": {
          "btnId": "geoDistDataBtn",
          "panelId": "geoDistDataPanel",
          "descId": "geoDistDataDesc",
          "rowsId": "geoDistDataRows",
          "caption": {
            "en": "The two points and the segment's distance, midpoint and slope",
            "ar": null
          },
          "columns": [
            { "en": "quantity", "ar": null },
            { "en": "value", "ar": null }
          ]
        },
        "controls": [
          {
            "id": "geoDistX1",
            "label": { "en": "A<sub>x</sub>:", "ar": null },
            "min": -8, "max": 8, "value": 0, "step": 0.5,
            "valueDisplayId": "geoDistX1val",
            "ariaLabel": { "en": "Point A x-coordinate", "ar": null }
          },
          {
            "id": "geoDistY1",
            "label": { "en": "A<sub>y</sub>:", "ar": null },
            "min": -8, "max": 8, "value": 0, "step": 0.5,
            "valueDisplayId": "geoDistY1val",
            "ariaLabel": { "en": "Point A y-coordinate", "ar": null }
          },
          {
            "id": "geoDistX2",
            "label": { "en": "B<sub>x</sub>:", "ar": null },
            "min": -8, "max": 8, "value": 6, "step": 0.5,
            "valueDisplayId": "geoDistX2val",
            "ariaLabel": { "en": "Point B x-coordinate", "ar": null }
          },
          {
            "id": "geoDistY2",
            "label": { "en": "B<sub>y</sub>:", "ar": null },
            "min": -8, "max": 8, "value": 8, "step": 0.5,
            "valueDisplayId": "geoDistY2val",
            "ariaLabel": { "en": "Point B y-coordinate", "ar": null }
          }
        ],
        "readouts": [
          {
            "id": "geoDistD",
            "label": { "en": "distance AB", "ar": null },
            "colorClass": "indigo",
            "value": "10.000"
          },
          {
            "id": "geoDistMid",
            "label": { "en": "midpoint", "ar": null },
            "colorClass": "amber",
            "value": "(3.00, 4.00)"
          }
        ],
        "note": {
          "en": "Default A = (0, 0), B = (6, 8) matches Worked example 10.A exactly (distance 10). Drag either point and watch the distance and midpoint formulas from the Reference box update live.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 10.A",
          "ar": null
        },
        "body": {
          "en": "<p>Find the distance from \\( (0,0) \\) to \\( (6,8) \\).</p>\\[ \\sqrt{36+64}=10. \\]",
          "ar": null
        }
      }
    ]
  }
}
