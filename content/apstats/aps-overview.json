          "en": "<table style=\"font-size:.82rem;border-collapse:collapse;margin-top:10px;width:100%\"><tr style=\"background:var(--paper-2)\"><th style=\"padding:5px 10px;border:1px solid var(--line);text-align:left\">Unit</th><th style=\"padding:5px 10px;border:1px solid var(--line);text-align:left\">Title</th><th style=\"padding:5px 10px;border:1px solid var(--line)\">Exam %</th><th style=\"padding:5px 10px;border:1px solid var(--line);text-align:left\">Key Topics</th></tr><tr><td style=\"padding:5px 10px;border:1px solid var(--line)\">U1</td><td style=\"padding:5px 10px;border:1px solid var(--line)\">Exploring Data</td><td style=\"padding:5px 10px;border:1px solid var(--line);text-align:center\">15–23%</td><td style=\"padding:5px 10px;border:1px solid var(--line)\">Categorical &amp; quantitative variables, distributions, summary stats, normal model</td></tr><tr><td style=\"padding:5px 10px;border:1px solid var(--line)\">U2</td><td style=\"padding:5px 10px;border:1px solid var(--line)\">Sampling &amp; Experimentation</td><td style=\"padding:5px 10px;border:1px solid var(--line);text-align:center\">12–15%</td><td style=\"padding:5px 10px;border:1px solid var(--line)\">Sampling methods, experimental design, bias, confounding</td></tr><tr><td style=\"padding:5px 10px;border:1px solid var(--line)\">U3</td><td style=\"padding:5px 10px;border:1px solid var(--line)\">Probability &amp; Distributions</td><td style=\"padding:5px 10px;border:1px solid var(--line);text-align:center\">30–40% (U3+U4+U5)</td><td style=\"padding:5px 10px;border:1px solid var(--line)\">Probability rules, geometric &amp; binomial distributions, sampling distributions</td></tr><tr><td style=\"padding:5px 10px;border:1px solid var(--line)\">U4</td><td style=\"padding:5px 10px;border:1px solid var(--line)\">Statistical Inference</td><td style=\"padding:5px 10px;border:1px solid var(--line);text-align:center\">25–35%</td><td style=\"padding:5px 10px;border:1px solid var(--line)\">Confidence intervals, significance tests for means &amp; proportions, chi-square, regression</td></tr></table>",
