        "label": {
          "en": "About AP Statistics",
          "ar": null
        },
        "body": {
          "en": "AP Statistics introduces students to the major concepts and tools for collecting, analysing, and drawing conclusions from data. The course follows four interconnected themes: <strong>Exploring Data</strong>, <strong>Sampling and Experimentation</strong>, <strong>Probability and Distributions</strong>, and <strong>Statistical Inference</strong>.",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Unit 1",
              "ar": null
            },
            "value": {
              "en": "Exploring data — graphical displays, measures of centre and spread, bivariate data, linear regression.",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Unit 2",
              "ar": null
            },
            "value": {
              "en": "Sampling and experimentation — study design, bias, randomisation, experimental control.",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Unit 3",
              "ar": null
            },
            "value": {
              "en": "Probability — rules, random variables, Normal and Binomial distributions, sampling distributions, CLT.",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Unit 4",
              "ar": null
            },
            "value": {
              "en": "Inference — confidence intervals, hypothesis tests, chi-square tests, regression inference.",
              "ar": null
            }
          }
        ]
