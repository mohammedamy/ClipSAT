  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "EST II trigonometry goes beyond right-triangle ratios to include the unit circle, radian measure, graphing, and trigonometric identities.",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Pythagorean identity",
              "ar": null
            },
            "value": {
              "en": "\\( \\sin^2\\theta+\\cos^2\\theta=1 \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Double angle sin",
              "ar": null
            },
            "value": {
              "en": "\\( \\sin 2\\theta=2\\sin\\theta\\cos\\theta \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Period of sin/cos",
              "ar": null
            },
            "value": {
              "en": "\\( 2\\pi \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Radian–degree",
              "ar": null
            },
            "value": {
              "en": "\\( 180^\\circ=\\pi \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 5.A",
          "ar": null
        },
        "body": {
          "en": "Simplify \\( \\dfrac{\\sin^2\\theta}{1-\\cos\\theta} \\). \\[ \\frac{1-\\cos^2\\theta}{1-\\cos\\theta}=\\frac{(1-\\cos\\theta)(1+\\cos\\theta)}{1-\\cos\\theta}=1+\\cos\\theta. \\]",
          "ar": null
        }
      },
      {
        "kind": "explorer",
        "title": {
          "en": "⊙ Explorer · The unit circle, in radians",
          "ar": null
        },
        "canvasId": "est2UcCanvas",
