        "kind": "text",
        "body": {
          "en": "Circle theorems and coordinate geometry of conic sections are significant topics on the EST II Mathematics subject test.",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Circle equation",
              "ar": null
            },
            "value": {
              "en": "\\( (x-h)^2+(y-k)^2=r^2 \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Arc length",
              "ar": null
            },
            "value": {
              "en": "\\( r\\theta \\) (θ in radians)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Sector area",
              "ar": null
            },
            "value": {
              "en": "\\( \\tfrac{1}{2}r^2\\theta \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Inscribed angle",
              "ar": null
            },
            "value": {
              "en": "\\( =\\tfrac{1}{2}\\times \\text{central angle} \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 6.A",
          "ar": null
        },
        "body": {
          "en": "Write the equation of a circle with centre \\( (3,-2) \\) and radius 5. \\[ (x-3)^2+(y+2)^2=25. \\]",
          "ar": null
        }
      },
