  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "EST II places heavy emphasis on function behaviour, including composite and inverse functions, domain and range analysis, and the properties of logarithms.",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Composition",
              "ar": null
            },
            "value": {
              "en": "\\( (f\\circ g)(x)=f(g(x)) \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Inverse",
              "ar": null
            },
            "value": {
              "en": "\\( f(f^{-1}(x))=x \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Log product",
              "ar": null
            },
            "value": {
              "en": "\\( \\log_b(mn)=\\log_b m+\\log_b n \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Change of base",
              "ar": null
            },
            "value": {
              "en": "\\( \\log_b a=\\dfrac{\\ln a}{\\ln b} \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 2.A — Inverse",
          "ar": null
        },
        "body": {
          "en": "Find \\( f^{-1}(x) \\) for \\( f(x)=3x-2 \\). \\[ y=3x-2 \\implies x=\\frac{y+2}{3} \\implies f^{-1}(x)=\\frac{x+2}{3}. \\]",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 2.B — Logarithm",
          "ar": null
        },
        "body": {
          "en": "Solve \\( \\log_2(x+3)=5 \\). \\[ x+3=2^5=32 \\implies x=29. \\]",
          "ar": null
        }
      },
