      {
        "kind": "practiceProblem",
        "question": {
          "en": "Given \\(f(x) = e^x\\) and \\(g(x) = \\ln(x+1)\\), find the domain of \\(g(f(x))\\) and simplify.",
          "ar": null
        },
        "solution": {
          "en": "\\(g(f(x)) = \\ln(e^x+1)\\). Since \\(e^x > 0\\) for all \\(x\\), \\(e^x+1 > 1 > 0\\). Domain: all reals. Cannot simplify further.",
          "ar": null
        }
      }
