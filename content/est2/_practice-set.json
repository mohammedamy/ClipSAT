      "question": {
        "en": "Factor completely: \\( x^3 - 4x \\).",
        "ar": null
      },
      "difficulty": "Intermediate",
      "solution": {
        "en": "\\[ x(x^2-4)=x(x-2)(x+2). \\]",
        "ar": null
