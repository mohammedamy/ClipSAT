        "ar": null
      },
      "difficulty": "Intermediate",
      "solution": {
        "en": "\\[ \\dfrac{(x-3)(x+3)}{(x-3)(x+2)}=\\dfrac{x+3}{x+2},\\quad x\\neq 3. \\]",
        "ar": null
      }
