  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "Summarising data with averages and spread, and the probability of simple events.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ Reference — Data &amp; chance",
          "ar": null
        },
        "body": {
          "en": "Mean is total over count; the median is the middle of the ordered data; range is largest minus smallest. Probability \\( =\\dfrac{\\text{favourable}}{\\text{total}} \\).",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Mean",
              "ar": null
            },
            "value": {
              "en": "\\( \\dfrac{\\sum x}{n} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Median",
              "ar": null
            },
            "value": {
              "en": "middle value",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Range",
              "ar": null
            },
            "value": {
              "en": "max − min",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Probability",
              "ar": null
            },
            "value": {
              "en": "\\( \\dfrac{\\text{fav}}{\\text{total}} \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 7.A",
          "ar": null
        },
        "body": {
          "en": "<p>Find the mean of \\( 2,\\,4,\\,6,\\,8 \\).</p>\\[ \\frac{20}{4}=5. \\]",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 7.B",
          "ar": null
        },
        "body": {
          "en": "<p>Find the median of \\( 3,\\,7,\\,9,\\,12,\\,20 \\).</p>\\[ 9. \\]",
          "ar": null
        }
      },
      {
        "kind": "practiceProblem",
        "question": {
          "en": "Events \\(A\\) and \\(B\\) are such that \\(P(A)=0.4\\), \\(P(B)=0.5\\), \\(P(A\\cup B)=0.7\\). Find \\(P(A\\cap B)\\) and state whether \\(A\\) and \\(B\\) are independent.",
          "ar": null
        },
        "solution": {
          "en": "\\(P(A\\cap B)=0.4+0.5-0.7=0.2\\). For independence: \\(P(A)\\cdot P(B)=0.2=P(A\\cap B)\\) ✓. \\(A\\) and \\(B\\) are independent.",
          "ar": null
        }
      }
    ]
  },
