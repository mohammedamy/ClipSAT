  "content": {
    "blocks": [
      {
        "kind": "text",
        "body": {
          "en": "Exact values, the identity linking sine and cosine, and solving simple trigonometric equations.",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "thm",
        "label": {
          "en": "▲ Reference — Trig essentials",
          "ar": null
        },
        "body": {
          "en": "\\( \\sin^{2}\\theta+\\cos^{2}\\theta=1 \\) and \\( \\tan\\theta=\\dfrac{\\sin\\theta}{\\cos\\theta} \\). Exact values: \\( \\sin30^{\\circ}=\\tfrac12 \\), \\( \\cos30^{\\circ}=\\tfrac{\\sqrt3}{2} \\), \\( \\sin60^{\\circ}=\\tfrac{\\sqrt3}{2} \\). The sine and cosine curves have period \\( 360^{\\circ} \\).",
          "ar": null
        }
      },
      {
        "kind": "cards",
        "items": [
          {
            "label": {
              "en": "Identity",
              "ar": null
            },
            "value": {
              "en": "\\( \\sin^{2}\\theta+\\cos^{2}\\theta=1 \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Tangent",
              "ar": null
            },
            "value": {
              "en": "\\( \\tfrac{\\sin\\theta}{\\cos\\theta} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Exact",
              "ar": null
            },
            "value": {
              "en": "\\( \\sin60^{\\circ}=\\tfrac{\\sqrt3}{2} \\)",
              "ar": null
            }
          },
          {
            "label": {
              "en": "Period",
              "ar": null
            },
            "value": {
              "en": "\\( 360^{\\circ} \\)",
              "ar": null
            }
          }
        ]
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 5.A",
          "ar": null
        },
        "body": {
          "en": "<p>Solve \\( \\sin\\theta=\\tfrac12 \\) for \\( 0^{\\circ}\\le\\theta\\le180^{\\circ} \\).</p>\\[ \\theta=30^{\\circ},\\ 150^{\\circ}. \\]",
          "ar": null
        }
      },
      {
        "kind": "callout",
        "style": "example",
        "label": {
          "en": "Worked example 5.B",
          "ar": null
        },
        "body": {
          "en": "<p>State the exact value of \\( \\sin60^{\\circ} \\).</p>\\[ \\tfrac{\\sqrt3}{2}. \\]",
          "ar": null
        }
      },
      {
        "kind": "practiceProblem",
        "question": {
          "en": "Solve \\(2\\sin^2\\theta-\\sin\\theta-1=0\\) for \\(0°\\leq\\theta\\leq360°\\).",
          "ar": null
        },
        "solution": {
          "en": "Factor: \\((2\\sin\\theta+1)(\\sin\\theta-1)=0\\Rightarrow\\sin\\theta=-\\tfrac{1}{2}\\) or \\(\\sin\\theta=1\\). Solutions: \\(\\theta=90°,210°,330°\\).",
          "ar": null
        }
      }
    ]
  },
