{
  "variant": "compact",
  "heading": "Practice Set",
  "items": [
    {
      "id": "pc-p1",
      "number": 1,
      "question": {
        "en": "If \\(\\sin\\theta=\\dfrac{3}{5}\\) and \\(\\theta\\) is in Quadrant I, find \\(\\cos\\theta\\), \\(\\tan\\theta\\), and \\(\\sin 2\\theta\\).",
        "ar": null
      },
      "difficulty": "Medium",
      "solution": {
        "en": "<p>\\(\\cos\\theta=\\sqrt{1-9/25}=4/5.\\quad\\tan\\theta=(3/5)/(4/5)=3/4.\\quad\\sin2\\theta=2(3/5)(4/5)=24/25.\\)</p>",
        "ar": null
      }
    },
    {
      "id": "pc-p2",
      "number": 2,
      "question": {
        "en": "Write the equation of the ellipse with foci at \\((\\pm 3,0)\\) and vertices at \\((\\pm 5,0)\\).",
        "ar": null
      },
      "difficulty": "Medium",
      "solution": {
        "en": "<p>\\(c=3,\\;a=5,\\;b^2=a^2-c^2=16.\\quad\\dfrac{x^2}{25}+\\dfrac{y^2}{16}=1.\\)</p>",
        "ar": null
      }
    },
    {
      "id": "pc-p3",
      "number": 3,
      "question": {
        "en": "Convert \\(r=4\\cos\\theta\\) to Cartesian form and identify the curve.",
        "ar": null
      },
      "difficulty": "Hard",
      "solution": {
        "en": "<p>\\(r^2=4r\\cos\\theta\\Rightarrow x^2+y^2=4x\\Rightarrow(x-2)^2+y^2=4.\\) Circle, centre \\((2,0)\\), radius 2.</p>",
        "ar": null
      }
    },
    {
      "id": "pc-p4",
      "number": 4,
      "question": {
        "en": "Find the sum of the geometric series \\(12+8+\\tfrac{16}{3}+\\cdots\\)",
        "ar": null
      },
      "difficulty": "Medium",
      "solution": {
        "en": "<p>\\(r=2/3,\\;|r|&lt;1.\\quad S_\\infty=12/(1-2/3)=36.\\)</p>",
        "ar": null
      }
    },
    {
      "id": "pc-p5",
      "number": 5,
      "question": {
        "en": "Solve \\(\\log_2(x+3)+\\log_2(x-3)=4\\).",
        "ar": null
      },
      "difficulty": "Easy",
      "solution": {
        "en": "<p>\\(\\log_2[(x+3)(x-3)]=4\\Rightarrow x^2-9=16\\Rightarrow x=5.\\) (Reject \\(-5\\): \\(\\log\\) undefined.)</p>",
        "ar": null
      }
    },
    {
      "id": "pc-p6",
      "number": 6,
      "question": {
        "en": "Find the vertical and horizontal asymptotes of \\(f(x)=\\dfrac{3x^2+1}{x^2-4}\\) and describe end behaviour.",
        "ar": null
      },
      "difficulty": "Hard",
      "solution": {
        "en": "<p>Vertical: \\(x=\\pm2.\\) Horizontal: degrees equal, \\(y=3/1=3.\\) As \\(x\\to\\pm\\infty\\), \\(f(x)\\to 3\\) from above (since numerator grows slightly faster for large \\(|x|\\)).</p>",
        "ar": null
      }
    },
    {
      "id": "pc-p7",
      "number": 7,
      "question": {
        "en": "Find the angle between \\(\\mathbf{u}=\\langle 1,\\sqrt{3}\\rangle\\) and \\(\\mathbf{v}=\\langle 2,0\\rangle\\).",
        "ar": null
      },
      "difficulty": "Medium",
      "solution": {
        "en": "<p>\\(\\mathbf{u}\\cdot\\mathbf{v}=2.\\;|\\mathbf{u}|=2,\\;|\\mathbf{v}|=2.\\;\\cos\\theta=2/4=1/2.\\;\\theta=60°.\\)</p>",
        "ar": null
      }
    }
  ]
}
