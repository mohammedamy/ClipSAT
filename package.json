{
  "name": "clipsat",
  "version": "1.0.0",
  "description": "ClipSAT — Math by Mr. Mohamed Abdallah",
  "scripts": {
    "build": "node scripts/validate-content.js && node scripts/validate-ix.js && node build.js && npx @11ty/eleventy",
    "start": "npx @11ty/eleventy --serve",
    "extract": "node build.js",
    "validate-content": "node scripts/validate-content.js",
    "validate-ix": "node scripts/validate-ix.js",
    "test:e2e": "playwright test",
    "test:unit": "node scripts/test-answer-check.js && node scripts/test-figures.js",
    "contact-sheets": "node scripts/generate-contact-sheets.js",
    "lighthouse": "node scripts/lighthouse-audit.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.48.0",
    "ajv": "^8.20.0",
    "cheerio": "^1.2.0",
    "csso": "^5.0.5",
    "katex": "0.16.11",
    "uglify-js": "^3.19.3"
  },
  "engines": {
    "node": ">=18"
  }
}
