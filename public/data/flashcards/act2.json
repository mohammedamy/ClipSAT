[{"id":"act2:act2-about:Formula:0","ch":"act2-about","chEn":"Test format & strategy","chAr":"نظام الاختبار واستراتيجية الحل","tag":"Formula","f":"Prerequisite","f_ar":"Prerequisite","b":"ACT Math (standard course)","b_ar":"ACT Math (standard course)"},{"id":"act2:act2-about:Formula:1","ch":"act2-about","chEn":"Test format & strategy","chAr":"نظام الاختبار واستراتيجية الحل","tag":"Formula","f":"Level","f_ar":"Level","b":"Pre-calculus and beyond","b_ar":"Pre-التفاضل والتكامل and beyond"},{"id":"act2:act2-about:Formula:2","ch":"act2-about","chEn":"Test format & strategy","chAr":"نظام الاختبار واستراتيجية الحل","tag":"Formula","f":"Ideal for","f_ar":"Ideal for","b":"Score 28+ target students","b_ar":"Score 28+ target students"},{"id":"act2:act2-numbers:Formula:3","ch":"act2-numbers","chEn":"Advanced Number Theory","chAr":"نظرية الأعداد المتقدمة والخصائص الحسابية","tag":"Formula","f":"GCD / LCM Rule","f_ar":"GCD / LCM Rule (نظرية الأعداد المتقدمة والخصائص الحسابية)","b":"\\( \\gcd(a,b)\\cdot\\text{lcm}(a,b) = ab \\)","b_ar":"\\( \\gcd(a,b)\\cdot\\text{lcm}(a,b) = ab \\)"},{"id":"act2:act2-numbers:Formula:4","ch":"act2-numbers","chEn":"Advanced Number Theory","chAr":"نظرية الأعداد المتقدمة والخصائص الحسابية","tag":"Formula","f":"Congruence","f_ar":"Congruence (نظرية الأعداد المتقدمة والخصائص الحسابية)","b":"\\( a \\equiv b \\pmod{m} \\iff m \\mid (a-b) \\)","b_ar":"\\( a \\equiv b \\pmod{m} \\iff m \\mid (a-b) \\)"},{"id":"act2:act2-numbers:Formula:5","ch":"act2-numbers","chEn":"Advanced Number Theory","chAr":"نظرية الأعداد المتقدمة والخصائص الحسابية","tag":"Formula","f":"Arithmetic Sum","f_ar":"Arithmetic Sum (نظرية الأعداد المتقدمة والخصائص الحسابية)","b":"\\( S_n = \\frac{n}{2}(a_1 + a_n) \\)","b_ar":"\\( S_n = \\frac{n}{2}(a_1 + a_n) \\)"},{"id":"act2:act2-numbers:Formula:6","ch":"act2-numbers","chEn":"Advanced Number Theory","chAr":"نظرية الأعداد المتقدمة والخصائص الحسابية","tag":"Formula","f":"Infinite Geometric","f_ar":"Infinite Geometric (نظرية الأعداد المتقدمة والخصائص الحسابية)","b":"\\( S_\\infty = \\frac{a_1}{1 - r} \\quad (|r|<1) \\)","b_ar":"\\( S_\\infty = \\frac{a_1}{1 - r} \\quad (|r|<1) \\)"},{"id":"act2:act2-algebra:Formula:7","ch":"act2-algebra","chEn":"Advanced Algebra & Systems","chAr":"الجبر المتقدم وأنظمة المعادلات","tag":"Formula","f":"Determinant","f_ar":"المحدد","b":"\\( \\det = ad - bc \\)","b_ar":"\\( \\det = ad - bc \\)"},{"id":"act2:act2-algebra:Formula:8","ch":"act2-algebra","chEn":"Advanced Algebra & Systems","chAr":"الجبر المتقدم وأنظمة المعادلات","tag":"Formula","f":"Matrix Inverse","f_ar":"المصفوفة Inverse","b":"\\( A^{-1} = \\frac{1}{\\det}\\begin{pmatrix}d & -b \\\\ -c & a\\end{pmatrix} \\)","b_ar":"\\( A^{-1} = \\frac{1}{\\det}\\begin{pmatrix}d & -b \\\\ -c & a\\end{pmatrix} \\)"},{"id":"act2:act2-algebra:Formula:9","ch":"act2-algebra","chEn":"Advanced Algebra & Systems","chAr":"الجبر المتقدم وأنظمة المعادلات","tag":"Formula","f":"Remainder Theorem","f_ar":"Remainder مبرهنة","b":"\\( P(c) = \\text{remainder of } \\frac{P(x)}{x-c} \\)","b_ar":"\\( P(c) = \\text{remainder of } \\frac{P(x)}{x-c} \\)"},{"id":"act2:act2-algebra:Formula:10","ch":"act2-algebra","chEn":"Advanced Algebra & Systems","chAr":"الجبر المتقدم وأنظمة المعادلات","tag":"Formula","f":"Change of Base","f_ar":"Change of Base (الجبر المتقدم وأنظمة المعادلات)","b":"\\( \\log_b x = \\frac{\\ln x}{\\ln b} \\)","b_ar":"\\( \\log_b x = \\frac{\\ln x}{\\ln b} \\)"},{"id":"act2:act2-functions:Formula:11","ch":"act2-functions","chEn":"Advanced Functions","chAr":"الدوال المتقدمة وتركيب الدوال","tag":"Formula","f":"Rational Function","f_ar":"Rational الدالة","b":"\\( f(x) = \\frac{P(x)}{Q(x)} \\)","b_ar":"\\( f(x) = \\frac{P(x)}{Q(x)} \\)"},{"id":"act2:act2-functions:Formula:12","ch":"act2-functions","chEn":"Advanced Functions","chAr":"الدوال المتقدمة وتركيب الدوال","tag":"Formula","f":"Horizontal Asymptote","f_ar":"Horizontal خط التقارب","b":"compare degrees \\( \\deg P \\) vs \\( \\deg Q \\)","b_ar":"compare degrees \\(\\deg P\\) vs \\(\\deg Q\\) (الدوال المتقدمة وتركيب الدوال)"},{"id":"act2:act2-functions:Formula:13","ch":"act2-functions","chEn":"Advanced Functions","chAr":"الدوال المتقدمة وتركيب الدوال","tag":"Formula","f":"Inverse Function","f_ar":"Inverse الدالة","b":"reflect across \\( y = x \\)","b_ar":"reflect across \\(y = x\\) (الدوال المتقدمة وتركيب الدوال)"},{"id":"act2:act2-functions:Formula:14","ch":"act2-functions","chEn":"Advanced Functions","chAr":"الدوال المتقدمة وتركيب الدوال","tag":"Formula","f":"Even / Odd Symmetries","f_ar":"Even / Odd Symmetries (الدوال المتقدمة وتركيب الدوال)","b":"\\( f(-x) = \\pm f(x) \\)","b_ar":"\\( f(-x) = \\pm f(x) \\)"},{"id":"act2:act2-trig:Formula:15","ch":"act2-trig","chEn":"Advanced Trigonometry","chAr":"حساب المثلثات المتقدم والمتطابقات","tag":"Formula","f":"Sum formula sin","f_ar":"Sum الصيغة sin","b":"\\( \\sin(A\\pm B)=\\sin A\\cos B\\pm\\cos A\\sin B \\)","b_ar":"\\( \\sin(A\\pm B)=\\sin A\\cos B\\pm\\cos A\\sin B \\)"},{"id":"act2:act2-trig:Formula:16","ch":"act2-trig","chEn":"Advanced Trigonometry","chAr":"حساب المثلثات المتقدم والمتطابقات","tag":"Formula","f":"Sum formula cos","f_ar":"Sum الصيغة cos","b":"\\( \\cos(A\\pm B)=\\cos A\\cos B\\mp\\sin A\\sin B \\)","b_ar":"\\( \\cos(A\\pm B)=\\cos A\\cos B\\mp\\sin A\\sin B \\)"},{"id":"act2:act2-trig:Formula:17","ch":"act2-trig","chEn":"Advanced Trigonometry","chAr":"حساب المثلثات المتقدم والمتطابقات","tag":"Formula","f":"Law of sines","f_ar":"Law of sines (حساب المثلثات المتقدم والمتطابقات)","b":"\\( \\dfrac{a}{\\sin A}=\\dfrac{b}{\\sin B}=\\dfrac{c}{\\sin C} \\)","b_ar":"\\( \\dfrac{a}{\\sin A}=\\dfrac{b}{\\sin B}=\\dfrac{c}{\\sin C} \\)"},{"id":"act2:act2-trig:Formula:18","ch":"act2-trig","chEn":"Advanced Trigonometry","chAr":"حساب المثلثات المتقدم والمتطابقات","tag":"Formula","f":"Inverse trig","f_ar":"Inverse trig (حساب المثلثات المتقدم والمتطابقات)","b":"\\( \\sin^{-1},\\cos^{-1},\\tan^{-1} \\)","b_ar":"\\( \\sin^{-1},\\cos^{-1},\\tan^{-1} \\)"},{"id":"act2:act2-precalc:Definition:19","ch":"act2-precalc","chEn":"Pre-Calculus Concepts","chAr":"مفاهيم ما قبل التفاضل والتكامل","tag":"Definition","f":"Deep Conceptual Intuition — Pre-Calculus Concepts","f_ar":"الحدس المفاهيمي العميق — Pre-التفاضل والتكامل Concepts","b":"<p><strong>Local Linearization &amp; Differentiability:</strong> A function \\(f\\) is differentiable at \\(x = a\\) if and only if the difference quotient \\(\\lim_{h \\to 0} \\dfrac{f(a+h) - f(a)}{h}\\) exists as a finite real number. Differentiability at \\(x = a\\) strictly implies continuity at \\(x = a\\), but the converse fails at sharp corners (e.g. \\(|x - 2|\\)), vertical tangents, or jump discontinuities.</p>","b_ar":"<p><strong>Local Linearization &amp; Differentiability:</strong> A function \\(f\\) is differentiable at \\(x = a\\) if and only if the difference quotient \\(\\lim_{h \\to 0} \\dfrac{f(a+h) - f(a)}{h}\\) exists as a finite real number. Differentiability at \\(x = a\\) strictly implies continuity at \\(x = a\\), but the converse fails at sharp corners (e.g. \\(|x - 2|\\)), vertical tangents, or jump discontinuities.</p>"},{"id":"act2:act2-precalc:Formula:20","ch":"act2-precalc","chEn":"Pre-Calculus Concepts","chAr":"مفاهيم ما قبل التفاضل والتكامل","tag":"Formula","f":"Limit intuition","f_ar":"النهاية intuition","b":"\\( \\lim_{x\\to a}f(x) \\) — value \\( f \\) approaches","b_ar":"\\(\\lim_{x\\to a}f(x)\\) — value \\(f\\) approaches (مفاهيم ما قبل التفاضل والتكامل)"},{"id":"act2:act2-precalc:Formula:21","ch":"act2-precalc","chEn":"Pre-Calculus Concepts","chAr":"مفاهيم ما قبل التفاضل والتكامل","tag":"Formula","f":"Geometric series","f_ar":"Geometric المتسلسلة","b":"\\( \\dfrac{a_1}{1-r},\\ |r|<1 \\)","b_ar":"\\( \\dfrac{a_1}{1-r},\\ |r|<1 \\)"},{"id":"act2:act2-precalc:Formula:22","ch":"act2-precalc","chEn":"Pre-Calculus Concepts","chAr":"مفاهيم ما قبل التفاضل والتكامل","tag":"Formula","f":"Binomial theorem","f_ar":"Binomial المبرهنة","b":"\\( (a+b)^n=\\sum\\binom{n}{k}a^{n-k}b^k \\)","b_ar":"\\( (a+b)^n=\\sum\\binom{n}{k}a^{n-k}b^k \\)"},{"id":"act2:act2-precalc:Formula:23","ch":"act2-precalc","chEn":"Pre-Calculus Concepts","chAr":"مفاهيم ما قبل التفاضل والتكامل","tag":"Formula","f":"Parametric","f_ar":"Parametric (مفاهيم ما قبل التفاضل والتكامل)","b":"\\( x=f(t),\\ y=g(t) \\)","b_ar":"\\( x=f(t),\\ y=g(t) \\)"},{"id":"act2:act2-coordgeo:Formula:24","ch":"act2-coordgeo","chEn":"Advanced Coordinate Geometry","chAr":"الهندسة الإحداثية المتقدمة والقطوع","tag":"Formula","f":"Parabola (vertical)","f_ar":"القطع المكافئ (vertical)","b":"\\( (x-h)^2=4p(y-k) \\)","b_ar":"\\( (x-h)^2=4p(y-k) \\)"},{"id":"act2:act2-coordgeo:Formula:25","ch":"act2-coordgeo","chEn":"Advanced Coordinate Geometry","chAr":"الهندسة الإحداثية المتقدمة والقطوع","tag":"Formula","f":"Ellipse","f_ar":"القطع الناقص","b":"\\( \\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}=1 \\)","b_ar":"\\( \\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}=1 \\)"},{"id":"act2:act2-coordgeo:Formula:26","ch":"act2-coordgeo","chEn":"Advanced Coordinate Geometry","chAr":"الهندسة الإحداثية المتقدمة والقطوع","tag":"Formula","f":"Hyperbola","f_ar":"القطع الزائد","b":"\\( \\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2}=1 \\)","b_ar":"\\( \\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2}=1 \\)"},{"id":"act2:act2-coordgeo:Formula:27","ch":"act2-coordgeo","chEn":"Advanced Coordinate Geometry","chAr":"الهندسة الإحداثية المتقدمة والقطوع","tag":"Formula","f":"Polar","f_ar":"Polar (الهندسة الإحداثية المتقدمة والقطوع)","b":"\\( x=r\\cos\\theta,\\ y=r\\sin\\theta \\)","b_ar":"\\( x=r\\cos\\theta,\\ y=r\\sin\\theta \\)"},{"id":"act2:act2-planegeo:Formula:28","ch":"act2-planegeo","chEn":"Advanced Plane Geometry","chAr":"الهندسة المستوية والفراغية المتقدمة","tag":"Formula","f":"Inscribed angle","f_ar":"Inscribed الزاوية","b":"\\( \\angle ACB = \\tfrac{1}{2} \\angle AOB \\)","b_ar":"\\( \\angle ACB = \\tfrac{1}{2} \\angle AOB \\)"},{"id":"act2:act2-planegeo:Formula:29","ch":"act2-planegeo","chEn":"Advanced Plane Geometry","chAr":"الهندسة المستوية والفراغية المتقدمة","tag":"Formula","f":"Power of a point","f_ar":"Power of a point (الهندسة المستوية والفراغية المتقدمة)","b":"\\( PT^2 = PA \\cdot PB \\)","b_ar":"\\( PT^2 = PA \\cdot PB \\)"},{"id":"act2:act2-planegeo:Formula:30","ch":"act2-planegeo","chEn":"Advanced Plane Geometry","chAr":"الهندسة المستوية والفراغية المتقدمة","tag":"Formula","f":"Heron's formula","f_ar":"Heron's الصيغة","b":"\\( \\sqrt{s(s-a)(s-b)(s-c)} \\)","b_ar":"\\( \\sqrt{s(s-a)(s-b)(s-c)} \\)"},{"id":"act2:act2-planegeo:Formula:31","ch":"act2-planegeo","chEn":"Advanced Plane Geometry","chAr":"الهندسة المستوية والفراغية المتقدمة","tag":"Formula","f":"Regular polygon area","f_ar":"Regular polygon المساحة","b":"\\( A = \\tfrac{1}{2} a P \\)","b_ar":"\\( A = \\tfrac{1}{2} a P \\)"},{"id":"act2:act2-stats:Formula:32","ch":"act2-stats","chEn":"Statistics, Counting & Probability","chAr":"الإحصاء وطرق العد والاحتمالات","tag":"Formula","f":"Permutations","f_ar":"Permutations (الإحصاء وطرق العد والاحتمالات)","b":"\\( _nP_r=\\dfrac{n!}{(n-r)!} \\)","b_ar":"\\( _nP_r=\\dfrac{n!}{(n-r)!} \\)"},{"id":"act2:act2-stats:Formula:33","ch":"act2-stats","chEn":"Statistics, Counting & Probability","chAr":"الإحصاء وطرق العد والاحتمالات","tag":"Formula","f":"Combinations","f_ar":"Combinations (الإحصاء وطرق العد والاحتمالات)","b":"\\( \\binom{n}{r}=\\dfrac{n!}{r!(n-r)!} \\)","b_ar":"\\( \\binom{n}{r}=\\dfrac{n!}{r!(n-r)!} \\)"},{"id":"act2:act2-stats:Formula:34","ch":"act2-stats","chEn":"Statistics, Counting & Probability","chAr":"الإحصاء وطرق العد والاحتمالات","tag":"Formula","f":"Bayes (simple)","f_ar":"Bayes (simple) (الإحصاء وطرق العد والاحتمالات)","b":"\\( P(A|B)=\\dfrac{P(B|A)P(A)}{P(B)} \\)","b_ar":"\\( P(A|B)=\\dfrac{P(B|A)P(A)}{P(B)} \\)"},{"id":"act2:act2-stats:Formula:35","ch":"act2-stats","chEn":"Statistics, Counting & Probability","chAr":"الإحصاء وطرق العد والاحتمالات","tag":"Formula","f":"Expected value","f_ar":"Expected value (الإحصاء وطرق العد والاحتمالات)","b":"\\( E=\\sum x_i P(x_i) \\)","b_ar":"\\( E=\\sum x_i P(x_i) \\)"}]