[{"id":"est:est-about:Formula:0","ch":"est-about","chEn":"Test format & strategy","chAr":"نظام اختبار EST I واستراتيجيات الحل","tag":"Formula","f":"Section I","f_ar":"Section I (نظام اختبار EST I واستراتيجيات الحل)","b":"30 min · no calculator","b_ar":"30 min · no calculator (نظام اختبار EST I واستراتيجيات الحل)"},{"id":"est:est-about:Formula:1","ch":"est-about","chEn":"Test format & strategy","chAr":"نظام اختبار EST I واستراتيجيات الحل","tag":"Formula","f":"Section II","f_ar":"Section II (نظام اختبار EST I واستراتيجيات الحل)","b":"60 min · calculator OK","b_ar":"60 min · calculator OK (نظام اختبار EST I واستراتيجيات الحل)"},{"id":"est:est-about:Formula:2","ch":"est-about","chEn":"Test format & strategy","chAr":"نظام اختبار EST I واستراتيجيات الحل","tag":"Formula","f":"Score","f_ar":"Score (نظام اختبار EST I واستراتيجيات الحل)","b":"200–800","b_ar":"200–800"},{"id":"est:est-algebra:Formula:3","ch":"est-algebra","chEn":"Heart of Algebra","chAr":"قلب الجبر: المعادلات والأنظمة الخطية","tag":"Formula","f":"Slope-intercept","f_ar":"الميل-المقطع","b":"\\( y=mx+b \\)","b_ar":"\\( y=mx+b \\)"},{"id":"est:est-algebra:Formula:4","ch":"est-algebra","chEn":"Heart of Algebra","chAr":"قلب الجبر: المعادلات والأنظمة الخطية","tag":"Formula","f":"Standard Form Slope","f_ar":"Standard Form الميل","b":"\\( m = -\\dfrac{A}{B} \\)","b_ar":"\\( m = -\\dfrac{A}{B} \\)"},{"id":"est:est-algebra:Formula:5","ch":"est-algebra","chEn":"Heart of Algebra","chAr":"قلب الجبر: المعادلات والأنظمة الخطية","tag":"Formula","f":"Absolute value","f_ar":"Absolute value (قلب الجبر: المعادلات والأنظمة الخطية)","b":"\\( |x-a|=b \\Rightarrow x=a\\pm b \\)","b_ar":"\\( |x-a|=b \\Rightarrow x=a\\pm b \\)"},{"id":"est:est-algebra:Formula:6","ch":"est-algebra","chEn":"Heart of Algebra","chAr":"قلب الجبر: المعادلات والأنظمة الخطية","tag":"Formula","f":"Perpendicular","f_ar":"Perpendicular (قلب الجبر: المعادلات والأنظمة الخطية)","b":"\\( m_\\perp = -\\dfrac{1}{m} \\)","b_ar":"\\( m_\\perp = -\\dfrac{1}{m} \\)"},{"id":"est:est-quadratics:Formula:7","ch":"est-quadratics","chEn":"Quadratics & Polynomials","chAr":"المعادلات التربيعية وكثيرات الحدود","tag":"Formula","f":"Quadratic Formula","f_ar":"Quadratic الصيغة","b":"\\( x = \\dfrac{-b \\pm \\sqrt{b^2 - 4ac}}{2a} \\)","b_ar":"\\( x = \\dfrac{-b \\pm \\sqrt{b^2 - 4ac}}{2a} \\)"},{"id":"est:est-quadratics:Formula:8","ch":"est-quadratics","chEn":"Quadratics & Polynomials","chAr":"المعادلات التربيعية وكثيرات الحدود","tag":"Formula","f":"Vertex Coordinates","f_ar":"الرأس الإحداثيات","b":"\\( h = -\\dfrac{b}{2a},\\; k = f(h) \\)","b_ar":"\\( h = -\\dfrac{b}{2a},\\; k = f(h) \\)"},{"id":"est:est-quadratics:Formula:9","ch":"est-quadratics","chEn":"Quadratics & Polynomials","chAr":"المعادلات التربيعية وكثيرات الحدود","tag":"Formula","f":"Discriminant","f_ar":"Discriminant (المعادلات التربيعية وكثيرات الحدود)","b":"\\( \\Delta = b^2 - 4ac \\)","b_ar":"\\( \\Delta = b^2 - 4ac \\)"},{"id":"est:est-quadratics:Formula:10","ch":"est-quadratics","chEn":"Quadratics & Polynomials","chAr":"المعادلات التربيعية وكثيرات الحدود","tag":"Formula","f":"Vieta's Formulas","f_ar":"Vieta's الصيغ","b":"\\( r_1+r_2=-\\dfrac{b}{a},\\; r_1 r_2=\\dfrac{c}{a} \\)","b_ar":"\\( r_1+r_2=-\\dfrac{b}{a},\\; r_1 r_2=\\dfrac{c}{a} \\)"},{"id":"est:est-functions:Formula:11","ch":"est-functions","chEn":"Functions & Graphs","chAr":"الدوال والتمثيلات البيانية","tag":"Formula","f":"Composition","f_ar":"Composition (الدوال والتمثيلات البيانية)","b":"\\( (f \\circ g)(x) = f(g(x)) \\)","b_ar":"\\( (f \\circ g)(x) = f(g(x)) \\)"},{"id":"est:est-functions:Formula:12","ch":"est-functions","chEn":"Functions & Graphs","chAr":"الدوال والتمثيلات البيانية","tag":"Formula","f":"Inverse Function","f_ar":"Inverse الدالة","b":"\\( f(a)=b \\iff f^{-1}(b)=a \\)","b_ar":"\\( f(a)=b \\iff f^{-1}(b)=a \\)"},{"id":"est:est-functions:Formula:13","ch":"est-functions","chEn":"Functions & Graphs","chAr":"الدوال والتمثيلات البيانية","tag":"Formula","f":"Horizontal Shift","f_ar":"Horizontal Shift (الدوال والتمثيلات البيانية)","b":"\\( f(x - h) \\implies \\text{right } h \\)","b_ar":"\\( f(x - h) \\implies \\text{right } h \\)"},{"id":"est:est-functions:Formula:14","ch":"est-functions","chEn":"Functions & Graphs","chAr":"الدوال والتمثيلات البيانية","tag":"Formula","f":"Vertical Shift","f_ar":"Vertical Shift (الدوال والتمثيلات البيانية)","b":"\\( f(x) + k \\implies \\text{up } k \\)","b_ar":"\\( f(x) + k \\implies \\text{up } k \\)"},{"id":"est:est-data:Formula:15","ch":"est-data","chEn":"Ratios, Rates & Data","chAr":"النسب والمعدلات وتحليل البيانات","tag":"Formula","f":"Percent Change","f_ar":"Percent Change (النسب والمعدلات وتحليل البيانات)","b":"\\( \\dfrac{\\text{new} - \\text{old}}{\\text{old}} \\times 100\\% \\)","b_ar":"\\( \\dfrac{\\text{new} - \\text{old}}{\\text{old}} \\times 100\\% \\)"},{"id":"est:est-data:Formula:16","ch":"est-data","chEn":"Ratios, Rates & Data","chAr":"النسب والمعدلات وتحليل البيانات","tag":"Formula","f":"Multiplier Method","f_ar":"Multiplier Method (النسب والمعدلات وتحليل البيانات)","b":"\\( P_{\\text{fin}} = P_0(1 \\pm r_1)(1 \\pm r_2) \\)","b_ar":"\\( P_{\\text{fin}} = P_0(1 \\pm r_1)(1 \\pm r_2) \\)"},{"id":"est:est-data:Formula:17","ch":"est-data","chEn":"Ratios, Rates & Data","chAr":"النسب والمعدلات وتحليل البيانات","tag":"Formula","f":"Direct Variation","f_ar":"Direct Variation (النسب والمعدلات وتحليل البيانات)","b":"\\( y = kx \\iff \\dfrac{y}{x} = k \\)","b_ar":"\\( y = kx \\iff \\dfrac{y}{x} = k \\)"},{"id":"est:est-data:Formula:18","ch":"est-data","chEn":"Ratios, Rates & Data","chAr":"النسب والمعدلات وتحليل البيانات","tag":"Formula","f":"Inverse Variation","f_ar":"Inverse Variation (النسب والمعدلات وتحليل البيانات)","b":"\\( xy = k \\iff y = \\dfrac{k}{x} \\)","b_ar":"\\( xy = k \\iff y = \\dfrac{k}{x} \\)"},{"id":"est:est-stats:Formula:19","ch":"est-stats","chEn":"Statistics & Probability","chAr":"الإحصاء والاحتمالات","tag":"Formula","f":"Sample Mean","f_ar":"Sample Mean (الإحصاء والاحتمالات)","b":"\\( \\bar{x} = \\dfrac{\\sum x_i}{n} \\)","b_ar":"\\( \\bar{x} = \\dfrac{\\sum x_i}{n} \\)"},{"id":"est:est-stats:Formula:20","ch":"est-stats","chEn":"Statistics & Probability","chAr":"الإحصاء والاحتمالات","tag":"Formula","f":"IQR","f_ar":"IQR (الإحصاء والاحتمالات)","b":"\\( \\text{IQR} = Q_3 - Q_1 \\)","b_ar":"\\( \\text{IQR} = Q_3 - Q_1 \\)"},{"id":"est:est-stats:Formula:21","ch":"est-stats","chEn":"Statistics & Probability","chAr":"الإحصاء والاحتمالات","tag":"Formula","f":"Addition Rule","f_ar":"Addition Rule (الإحصاء والاحتمالات)","b":"\\( P(A\\cup B)=P(A)+P(B)-P(A\\cap B) \\)","b_ar":"\\( P(A\\cup B)=P(A)+P(B)-P(A\\cap B) \\)"},{"id":"est:est-stats:Formula:22","ch":"est-stats","chEn":"Statistics & Probability","chAr":"الإحصاء والاحتمالات","tag":"Formula","f":"Independent Events","f_ar":"Independent Events (الإحصاء والاحتمالات)","b":"\\( P(A\\cap B)=P(A)\\cdot P(B) \\)","b_ar":"\\( P(A\\cap B)=P(A)\\cdot P(B) \\)"},{"id":"est:est-geometry:Formula:23","ch":"est-geometry","chEn":"Geometry","chAr":"الهندسة المستوية والفراغية","tag":"Formula","f":"Circle Standard Form","f_ar":"الدائرة Standard Form","b":"\\( (x - h)^2 + (y - k)^2 = r^2 \\)","b_ar":"\\( (x - h)^2 + (y - k)^2 = r^2 \\)"},{"id":"est:est-geometry:Formula:24","ch":"est-geometry","chEn":"Geometry","chAr":"الهندسة المستوية والفراغية","tag":"Formula","f":"Arc Length (Degrees)","f_ar":"Arc Length (Degrees) (الهندسة المستوية والفراغية)","b":"\\( s = \\dfrac{\\theta}{360^\\circ}(2\\pi r) \\)","b_ar":"\\( s = \\dfrac{\\theta}{360^\\circ}(2\\pi r) \\)"},{"id":"est:est-geometry:Formula:25","ch":"est-geometry","chEn":"Geometry","chAr":"الهندسة المستوية والفراغية","tag":"Formula","f":"Sector Area (Degrees)","f_ar":"Sector المساحة (Degrees)","b":"\\( A = \\dfrac{\\theta}{360^\\circ}(\\pi r^2) \\)","b_ar":"\\( A = \\dfrac{\\theta}{360^\\circ}(\\pi r^2) \\)"},{"id":"est:est-geometry:Formula:26","ch":"est-geometry","chEn":"Geometry","chAr":"الهندسة المستوية والفراغية","tag":"Formula","f":"Pythagorean Theorem","f_ar":"Pythagorean مبرهنة","b":"\