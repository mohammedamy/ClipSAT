[{"id":"est2:est2-about:Formula:0","ch":"est2-about","chEn":"Test format & strategy","chAr":"نظام الاختبار واستراتيجية الحل","tag":"Formula","f":"Level","f_ar":"Level","b":"Advanced secondary / pre-calculus","b_ar":"Advanced secondary / pre-التفاضل والتكامل"},{"id":"est2:est2-about:Formula:1","ch":"est2-about","chEn":"Test format & strategy","chAr":"نظام الاختبار واستراتيجية الحل","tag":"Formula","f":"Topics","f_ar":"الموضوعات","b":"Algebra · Geometry · Trig · Stats","b_ar":"الجبر · الهندسة · Trig · Stats"},{"id":"est2:est2-about:Formula:2","ch":"est2-about","chEn":"Test format & strategy","chAr":"نظام الاختبار واستراتيجية الحل","tag":"Formula","f":"Depth","f_ar":"Depth","b":"Beyond EST I","b_ar":"Beyond EST I"},{"id":"est2:est2-algebra:Formula:3","ch":"est2-algebra","chEn":"Advanced Algebra","chAr":"الجبر المتقدم والمعادلات","tag":"Formula","f":"Rational Form","f_ar":"Rational Form (الجبر المتقدم والمعادلات)","b":"\\( \\dfrac{P(x)}{Q(x)},\\; Q(x) \\neq 0 \\)","b_ar":"\\( \\dfrac{P(x)}{Q(x)},\\; Q(x) \\neq 0 \\)"},{"id":"est2:est2-algebra:Formula:4","ch":"est2-algebra","chEn":"Advanced Algebra","chAr":"الجبر المتقدم والمعادلات","tag":"Formula","f":"Remainder Theorem","f_ar":"Remainder مبرهنة","b":"\\( R = P(c) \\text{ for } P(x) \\div (x - c) \\)","b_ar":"\\( R = P(c) \\text{ for } P(x) \\div (x - c) \\)"},{"id":"est2:est2-algebra:Formula:5","ch":"est2-algebra","chEn":"Advanced Algebra","chAr":"الجبر المتقدم والمعادلات","tag":"Formula","f":"Factor Theorem","f_ar":"Factor مبرهنة","b":"\\( (x - c) \\mid P(x) \\iff P(c) = 0 \\)","b_ar":"\\( (x - c) \\mid P(x) \\iff P(c) = 0 \\)"},{"id":"est2:est2-algebra:Formula:6","ch":"est2-algebra","chEn":"Advanced Algebra","chAr":"الجبر المتقدم والمعادلات","tag":"Formula","f":"Absolute Value","f_ar":"Absolute Value (الجبر المتقدم والمعادلات)","b":"\\( |u| \\le c \\iff -c \\le u \\le c \\)","b_ar":"\\( |u| \\le c \\iff -c \\le u \\le c \\)"},{"id":"est2:est2-functions:Formula:7","ch":"est2-functions","chEn":"Functions: Composite, Inverse & Logarithmic","chAr":"الدوال المركبة والعكسية واللوغاريتمية","tag":"Formula","f":"Composition","f_ar":"Composition (الدوال المركبة والعكسية واللوغاريتمية)","b":"\\( (f\\circ g)(x)=f(g(x)) \\)","b_ar":"\\( (f\\circ g)(x)=f(g(x)) \\)"},{"id":"est2:est2-functions:Formula:8","ch":"est2-functions","chEn":"Functions: Composite, Inverse & Logarithmic","chAr":"الدوال المركبة والعكسية واللوغاريتمية","tag":"Formula","f":"Inverse Identity","f_ar":"Inverse المتطابقة","b":"\\( f(f^{-1}(x))=x \\)","b_ar":"\\( f(f^{-1}(x))=x \\)"},{"id":"est2:est2-functions:Formula:9","ch":"est2-functions","chEn":"Functions: Composite, Inverse & Logarithmic","chAr":"الدوال المركبة والعكسية واللوغاريتمية","tag":"Formula","f":"Log Product Law","f_ar":"Log Product Law (الدوال المركبة والعكسية واللوغاريتمية)","b":"\\( \\log_b(xy)=\\log_b x+\\log_b y \\)","b_ar":"\\( \\log_b(xy)=\\log_b x+\\log_b y \\)"},{"id":"est2:est2-functions:Formula:10","ch":"est2-functions","chEn":"Functions: Composite, Inverse & Logarithmic","chAr":"الدوال المركبة والعكسية واللوغاريتمية","tag":"Formula","f":"Change of Base","f_ar":"Change of Base (الدوال المركبة والعكسية واللوغاريتمية)","b":"\\( \\log_b a=\\dfrac{\\ln a}{\\ln b} \\)","b_ar":"\\( \\log_b a=\\dfrac{\\ln a}{\\ln b} \\)"},{"id":"est2:est2-sequences:Definition:11","ch":"est2-sequences","chEn":"Sequences, Series & Complex Numbers","chAr":"المتتابعات والمتسلسلات والأعداد المركبة","tag":"Definition","f":"Deep Conceptual Intuition — Sequences, Series & Complex Numbers","f_ar":"الحدس المفاهيمي العميق — المتتاليات, المتسلسلة & Complex Numbers","b":"<p><strong>Algebraic &amp; Geometric Duality of \\(\\mathbb{C}\\):</strong> Every complex number \\(z = x + iy\\) corresponds bijectively to a point \\((x, y)\\) in the Argand plane with modulus \\(r = |z| = \\sqrt{x^2 + y^2}\\) and principal argument \\(\\theta = \\arg(z) \\in (-\\pi, \\pi]\\). In exponential Euler form, \\(z = re^{i\\theta} = r(\\cos\\theta + i\\sin\\theta)\\), multiplication scales moduli and adds arguments: \\(z_1 z_2 = r_1 r_2 e^{i(\\theta_1 + \\theta_2)}\\).</p>","b_ar":"<p><strong>Algebraic &amp; Geometric Duality of \\(\\mathbb{C}\\):</strong> Every complex number \\(z = x + iy\\) corresponds bijectively to a point \\((x, y)\\) in the Argand plane with modulus \\(r = |z| = \\sqrt{x^2 + y^2}\\) and principal argument \\(\\theta = \\arg(z) \\in (-\\pi, \\pi]\\). In exponential Euler form, \\(z = re^{i\\theta} = r(\\cos\\theta + i\\sin\\theta)\\), multiplication scales moduli and adds arguments: \\(z_1 z_2 = r_1 r_2 e^{i(\\theta_1 + \\theta_2)}\\).</p>"},{"id":"est2:est2-sequences:Formula:12","ch":"est2-sequences","chEn":"Sequences, Series & Complex Numbers","chAr":"المتتابعات والمتسلسلات والأعداد المركبة","tag":"Formula","f":"Arithmetic \\(a_n\\)","f_ar":"Arithmetic \\(a_n\\) (المتتابعات والمتسلسلات والأعداد المركبة)","b":"\\( a_n = a_1 + (n-1)d \\)","b_ar":"\\( a_n = a_1 + (n-1)d \\)"},{"id":"est2:est2-sequences:Formula:13","ch":"est2-sequences","chEn":"Sequences, Series & Complex Numbers","chAr":"المتتابعات والمتسلسلات والأعداد المركبة","tag":"Formula","f":"Geometric \\(a_n\\)","f_ar":"Geometric \\(a_n\\) (المتتابعات والمتسلسلات والأعداد المركبة)","b":"\\( a_n = a_1 \\cdot r^{n-1} \\)","b_ar":"\\( a_n = a_1 \\cdot r^{n-1} \\)"},{"id":"est2:est2-sequences:Formula:14","ch":"est2-sequences","chEn":"Sequences, Series & Complex Numbers","chAr":"المتتابعات والمتسلسلات والأعداد المركبة","tag":"Formula","f":"Arithmetic Sum","f_ar":"Arithmetic Sum (المتتابعات والمتسلسلات والأعداد المركبة)","b":"\\( S_n = \\dfrac{n}{2}(a_1 + a_n) \\)","b_ar":"\\( S_n = \\dfrac{n}{2}(a_1 + a_n) \\)"},{"id":"est2:est2-sequences:Formula:15","ch":"est2-sequences","chEn":"Sequences, Series & Complex Numbers","chAr":"المتتابعات والمتسلسلات والأعداد المركبة","tag":"Formula","f":"Infinite Sum","f_ar":"Infinite Sum (المتتابعات والمتسلسلات والأعداد المركبة)","b":"\\( S_\\infty = \\dfrac{a_1}{1 - r},\\; |r| < 1 \\)","b_ar":"\\( S_\\infty = \\dfrac{a_1}{1 - r},\\; |r| < 1 \\)"},{"id":"est2:est2-geometry:Formula:16","ch":"est2-geometry","chEn":"Lines, Triangles & Polygons","chAr":"المستقيمات والمثلثات والمضلعات","tag":"Formula","f":"Triangle Angle Sum","f_ar":"المثلث الزاوية Sum","b":"\\( \\sum \\theta = 180^\\circ \\)","b_ar":"\\( \\sum \\theta = 180^\\circ \\)"},{"id":"est2:est2-geometry:Formula:17","ch":"est2-geometry","chEn":"Lines, Triangles & Polygons","chAr":"المستقيمات والمثلثات والمضلعات","tag":"Formula","f":"Polygon Interior Sum","f_ar":"Polygon Interior Sum (المستقيمات والمثلثات والمضلعات)","b":"\\( (n-2) \\times 180^\\circ \\)","b_ar":"\\( (n-2) \\times 180^\\circ \\)"},{"id":"est2:est2-geometry:Formula:18","ch":"est2-geometry","chEn":"Lines, Triangles & Polygons","chAr":"المستقيمات والمثلثات والمضلعات","tag":"Formula","f":"Trig Triangle Area","f_ar":"Trig المثلث المساحة","b":"\\( \\text{Area} = \\tfrac{1}{2}ab\\sin C \\)","b_ar":"\\( \\text{Area} = \\tfrac{1}{2}ab\\sin C \\)"},{"id":"est2:est2-geometry:Formula:19","ch":"est2-geometry","chEn":"Lines, Triangles & Polygons","chAr":"المستقيمات والمثلثات والمضلعات","tag":"Formula","f":"Law of Cosines","f_ar":"Law of Cosines (المستقيمات والمثلثات والمضلعات)","b":"\\( c^2 = a^2+b^2-2ab\\cos C \\)","b_ar":"\\( c^2 = a^2+b^2-2ab\\cos C \\)"},{"id":"est2:est2-trig:Formula:20","ch":"est2-trig","chEn":"Trigonometry","chAr":"حساب المثلثات والقوانين المثلثية","tag":"Formula","f":"Pythagorean Identity","f_ar":"Pythagorean المتطابقة","b":"\\( \\sin^2\\theta + \\cos^2\\theta = 1 \\)","b_ar":"\\( \\sin^2\\theta + \\cos^2\\theta = 1 \\)"},{"id":"est2:est2-trig:Formula:21","ch":"est2-trig","chEn":"Trigonometry","chAr":"حساب المثلثات والقوانين المثلثية","tag":"Formula","f":"Double-Angle Sine","f_ar":"Double-الزاوية Sine","b":"\\( \\sin(2\\theta) = 2\\sin\\theta\\cos\\theta \\)","b_ar":"\\( \\sin(2\\theta) = 2\\sin\\theta\\cos\\theta \\)"},{"id":"est2:est2-trig:Formula:22","ch":"est2-trig","chEn":"Trigonometry","chAr":"حساب المثلثات والقوانين المثلثية","tag":"Formula","f":"Double-Angle Cosine","f_ar":"Double-الزاوية Cosine","b":"\\( \\cos(2\\theta) = \\cos^2\\theta - \\sin^2\\theta \\)","b_ar":"\\( \\cos(2\\theta) = \\cos^2\\theta - \\sin^2\\theta \\)"},{"id":"est2:est2-trig:Formula:23","ch":"est2-trig","chEn":"Trigonometry","chAr":"حساب المثلثات والقوانين المثلثية","tag":"Formula","f":"Radian Equivalence","f_ar":"Radian Equivalence (حساب المثلثات والقوانين المثلثية)","b":"\\( 180^\\circ = \\pi\\text{ rad} \\)","b_ar":"\\( 180^\\circ = \\pi\\text{ rad} \\)"},{"id":"est2:est2-circles:Formula:24","ch":"est2-circles","chEn":"Circles & Conic Sections","chAr":"الدوائر والقطوع المخروطية","tag":"Formula","f":"Circle Equation","f_ar":"الدائرة المعادلة","b":"\\( (x-h)^2+(y-k)^2=r^2 \\)","b_ar":"\\( (x-h)^2+(y-k)^2=r^2 \\)"},{"id":"est2:est2-circles:Formula:25","ch":"est2-circles","chEn":"Circles & Conic Sections","chAr":"الدوائر والقطوع المخروطية","tag":"Formula","f":"Tangent Slope","f_ar":"Tangent الميل","b":"\\( m_{\\text{tangent}} = -\\dfrac{1}{m_{\\text{radius}}} \\)","b_ar":"\\( m_{\\text{tangent}} = -\\dfrac{1}{m_{\\text{radius}}} \\)"},{"id":"est2:est2-circles:Formula:26","ch":"est2-circles","chEn":"Circles & Conic Sections","chAr":"الدوائر والقطوع المخروطية","tag":"Formula","f":"Ellipse Foci","f_ar":"القطع الناقص Foci","b":"\\( c^2 = a^2 - b^2 \\)","b_ar":"\\( c^2 = a^2 - b^2 \\)"},{"id":"est2:est2-circles:Formula:27","ch":"est2-circles","chEn":"Circles & Conic Sections","chAr":"الدوائر والقطوع المخروطية","tag":"Formula","f":"Hyperbola Foci","f_ar":"القطع الزائد Foci","b":"\\( c^2 = a^2 + b^2 \\)","b_ar":"\\( c^2 = a^2 + b^2 \\)"},{"id":"est2:est2-solids:Formula:28","ch":"est2-solids","chEn":"Solid Geometry & Similarity","chAr":"الهندسة الفراغية والتشابه","tag":"Formula","f":"Sphere Volume","f_ar":"Sphere الحجم","b":"\\( V = \\tfrac{4}{3}\\pi r^3 \\)","b_ar":"\\( V = \\tfrac{4}{3}\\pi r^3 \\)"},{"id":"est2:est2-solids:Formula:29","ch":"est2-solids","chEn":"Solid Geometry & Similarity","chAr":"الهندسة الفراغية والتشابه","tag":"Formula","f":"Cone Volume","f_ar":"Cone الحجم","b":"\\( V = \\tfrac{1}{3}\\pi r^2 h \\)","b_ar":"\\( V = \\tfrac{1}{3}\\pi r^2 h \\)"},{"id":"est2:est2-solids:Formula:30","ch":"est2-solids","chEn":"Solid Geometry & Similarity","chAr":"الهندسة الفراغية والتشابه","tag":"Formula","f":"Cylinder Volume","f_ar":"Cylinder الحجم","b":"\\( V = \\pi r^2 h \\)","b_ar":"\\( V = \\pi r^2 h \\)"},{"id":"est2:est2-solids:Formula:31","ch":"est2-solids","chEn":"Solid Geometry & Similarity","chAr":"الهندسة الفراغية والتشابه","tag":"Formula","f":"Similarity Scaling","f_ar":"Similarity Scaling (الهندسة الفراغية والتشابه)","b":"Lengths \\(k\\) : Areas \\(k^2\\) : Vols \\(k^3\\)","b_ar":"Lengths \\(k\\) : Areas \\(k^2\\) : Vols \\(k^3\\)"},{"id":"est2:est2-stats:Formula:32","ch":"est2-stats","chEn":"Statistics & Probability","chAr":"الإحصاء والاحتمالات والتوافيق","tag":"Formula","f":"Permutations","f_ar":"Permutations (الإحصاء والاحتمالات والتوافيق)","b":"\\( _nP_r=\\dfrac{n!}{(n-r)!} \\)","b_ar":"\\( _nP_r=\\dfrac{n!}{(n-r)!} \\)"},{"id":"est2:est2-stats:Formula:33","ch":"est2-stats","chEn":"Statistics & Probability","chAr":"الإحصاء والاحتمالات والتوافيق","tag":"Formula","f":"Combinations","f_ar":"Combinations (الإحصاء والاحتمالات والتوافيق)","b":"\\( \\binom{n}{r}=\\dfrac{n!}{r!(n-r)!} \\)","b_ar":"\\( \\binom{n}{r}=\\dfrac{n!}{r!(n-r)!} \\)"},{"id":"est2:est2-stats:Formula:34","ch":"est2-stats","chEn":"Statistics & Probability","chAr":"الإحصاء والاحتمالات والتوافيق","tag":"Formula","f":"Conditional Prob","f_ar":"Conditional Prob (الإحصاء والاحتمالات والتوافيق)","b":"\\( P(A|B)=\\dfrac{P(A\\cap B)}{P(B)} \\)","b_ar":"\\( P(A|B)=\\dfrac{P(A\\cap B)}{P(B)} \\)"},{"id":"est2:est2-stats:Formula:35","ch":"est2-stats","chEn":"Statistics & Probability","chAr":"الإحصاء والاحتمالات والتوافيق","tag":"Formula","f":"Data Transformation","f_ar":"Data Transformation (الإحصاء والاحتمالات والتوافيق)","b":"\\( \\sigma_{\\text{new}} = |a|\\sigma_{\\text{old}} \\)","b_ar":"\\( \\sigma_{\\text{new}} = |a|\\sigma_{\\text{old}} \\)"}]