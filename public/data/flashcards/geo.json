[{"id":"geo:geo-foundations:Definition:0","ch":"geo-foundations","chEn":"Foundations &amp; Reasoning","chAr":"الأسس الهندسية والاستدلال المنطقي والبراهين","tag":"Definition","f":"Definition 1.1 — Angle pairs","f_ar":"تعريف 1.1 — الزاوية pairs","b":"<p>Two angles are <strong>complementary</strong> if they sum to \\( 90^{\\circ} \\) and <strong>supplementary</strong> if they sum to \\( 180^{\\circ} \\). A <strong>linear pair</strong> (adjacent angles on a straight line) is always supplementary, and <strong>vertical angles</strong> (opposite at an intersection) are always equal.</p>","b_ar":"<p>Two angles are <strong>complementary</strong> if they sum to \\( 90^{\\circ} \\) and <strong>supplementary</strong> if they sum to \\( 180^{\\circ} \\). A <strong>linear pair</strong> (adjacent angles on a straight line) is always supplementary, and <strong>vertical angles</strong> (opposite at an intersection) are always equal.</p>"},{"id":"geo:geo-foundations:Formula:1","ch":"geo-foundations","chEn":"Foundations &amp; Reasoning","chAr":"الأسس الهندسية والاستدلال المنطقي والبراهين","tag":"Formula","f":"Midpoint","f_ar":"Midpoint (الأسس الهندسية والاستدلال المنطقي والبراهين)","b":"\\( M=\\Big(\\tfrac{x_1+x_2}{2},\\tfrac{y_1+y_2}{2}\\Big) \\)","b_ar":"\\( M=\\Big(\\tfrac{x_1+x_2}{2},\\tfrac{y_1+y_2}{2}\\Big) \\)"},{"id":"geo:geo-foundations:Formula:2","ch":"geo-foundations","chEn":"Foundations &amp; Reasoning","chAr":"الأسس الهندسية والاستدلال المنطقي والبراهين","tag":"Formula","f":"Complementary","f_ar":"Complementary (الأسس الهندسية والاستدلال المنطقي والبراهين)","b":"\\( \\alpha+\\beta=90^{\\circ} \\)","b_ar":"\\( \\alpha+\\beta=90^{\\circ} \\)"},{"id":"geo:geo-foundations:Formula:3","ch":"geo-foundations","chEn":"Foundations &amp; Reasoning","chAr":"الأسس الهندسية والاستدلال المنطقي والبراهين","tag":"Formula","f":"Supplementary","f_ar":"Supplementary (الأسس الهندسية والاستدلال المنطقي والبراهين)","b":"\\( \\alpha+\\beta=180^{\\circ} \\)","b_ar":"\\( \\alpha+\\beta=180^{\\circ} \\)"},{"id":"geo:geo-foundations:Formula:4","ch":"geo-foundations","chEn":"Foundations &amp; Reasoning","chAr":"الأسس الهندسية والاستدلال المنطقي والبراهين","tag":"Formula","f":"Vertical angles","f_ar":"Vertical angles (الأسس الهندسية والاستدلال المنطقي والبراهين)","b":"equal in measure","b_ar":"equal in measure (الأسس الهندسية والاستدلال المنطقي والبراهين)"},{"id":"geo:geo-lines:Theorem:5","ch":"geo-lines","chEn":"Lines &amp; Angles","chAr":"المستقيمات المتوازية والقواطع والزوايا","tag":"Theorem","f":"Reference — Parallel lines &amp; a transversal","f_ar":"Reference — Parallel lines &amp; a transversal","b":"<p><strong>Corresponding</strong> angles are equal; <strong>alternate</strong> (interior or exterior) angles are equal; <strong>co-interior</strong> (same-side interior) angles are supplementary, summing to \\( 180^{\\circ} \\).</p>","b_ar":"<p><strong>Corresponding</strong> angles are equal; <strong>alternate</strong> (interior or exterior) angles are equal; <strong>co-interior</strong> (same-side interior) angles are supplementary, summing to \\( 180^{\\circ} \\).</p>"},{"id":"geo:geo-lines:Formula:6","ch":"geo-lines","chEn":"Lines &amp; Angles","chAr":"المستقيمات المتوازية والقواطع والزوايا","tag":"Formula","f":"Corresponding","f_ar":"Corresponding (المستقيمات المتوازية والقواطع والزوايا)","b":"equal","b_ar":"equal (المستقيمات المتوازية والقواطع والزوايا)"},{"id":"geo:geo-lines:Formula:7","ch":"geo-lines","chEn":"Lines &amp; Angles","chAr":"المستقيمات المتوازية والقواطع والزوايا","tag":"Formula","f":"Alternate","f_ar":"Alternate (المستقيمات المتوازية والقواطع والزوايا)","b":"equal","b_ar":"equal (المستقيمات المتوازية والقواطع والزوايا)"},{"id":"geo:geo-lines:Formula:8","ch":"geo-lines","chEn":"Lines &amp; Angles","chAr":"المستقيمات المتوازية والقواطع والزوايا","tag":"Formula","f":"Co-interior","f_ar":"Co-interior (المستقيمات المتوازية والقواطع والزوايا)","b":"sum to \\( 180^{\\circ} \\)","b_ar":"sum to \\(180^{\\circ}\\) (المستقيمات المتوازية والقواطع والزوايا)"},{"id":"geo:geo-lines:Formula:9","ch":"geo-lines","chEn":"Lines &amp; Angles","chAr":"المستقيمات المتوازية والقواطع والزوايا","tag":"Formula","f":"Angles on a line","f_ar":"Angles on a line (المستقيمات المتوازية والقواطع والزوايا)","b":"sum to \\( 180^{\\circ} \\)","b_ar":"sum to \\(180^{\\circ}\\) (المستقيمات المتوازية والقواطع والزوايا)"},{"id":"geo:geo-triangles:Theorem:10","ch":"geo-triangles","chEn":"Triangles &amp; Congruence","chAr":"المثلثات ونظريات التطابق","tag":"Theorem","f":"Reference — Triangle facts","f_ar":"Reference — المثلث facts","b":"<p>Interior angles sum to \\( 180^{\\circ} \\). An <strong>exterior angle</strong> equals the sum of the two remote interior angles. Triangles are congruent by <strong>SSS, SAS, ASA, AAS</strong>, or <strong>HL</strong> (right triangles).</p>","b_ar":"<p>Interior angles sum to \\( 180^{\\circ} \\). An <strong>exterior angle</strong> equals the sum of the two remote interior angles. Triangles are congruent by <strong>SSS, SAS, ASA, AAS</strong>, or <strong>HL</strong> (right triangles).</p>"},{"id":"geo:geo-triangles:Formula:11","ch":"geo-triangles","chEn":"Triangles &amp; Congruence","chAr":"المثلثات ونظريات التطابق","tag":"Formula","f":"Angle sum","f_ar":"الزاوية sum","b":"\\( A+B+C=180^{\\circ} \\)","b_ar":"\\( A+B+C=180^{\\circ} \\)"},{"id":"geo:geo-triangles:Formula:12","ch":"geo-triangles","chEn":"Triangles &amp; Congruence","chAr":"المثلثات ونظريات التطابق","tag":"Formula","f":"Exterior angle","f_ar":"Exterior الزاوية","b":"\\( =\\) sum of remote interior","b_ar":"\\(=\\) sum of remote interior (المثلثات ونظريات التطابق)"},{"id":"geo:geo-triangles:Formula:13","ch":"geo-triangles","chEn":"Triangles &amp; Congruence","chAr":"المثلثات ونظريات التطابق","tag":"Formula","f":"Isosceles","f_ar":"Isosceles (المثلثات ونظريات التطابق)","b":"base angles equal","b_ar":"القاعدة الزوايا متساوي"},{"id":"geo:geo-triangles:Formula:14","ch":"geo-triangles","chEn":"Triangles &amp; Congruence","chAr":"المثلثات ونظريات التطابق","tag":"Formula","f":"Congruence","f_ar":"Congruence (المثلثات ونظريات التطابق)","b":"SSS · SAS · ASA · AAS · HL","b_ar":"SSS · SAS · ASA · AAS · HL (المثلثات ونظريات التطابق)"},{"id":"geo:geo-similarity:Formula:15","ch":"geo-similarity","chEn":"Similarity & Proportional Reasoning","chAr":"التشابه والتناسب الهندسي","tag":"Formula","f":"Linear Ratio","f_ar":"Linear Ratio (التشابه والتناسب الهندسي)","b":"\\( \\dfrac{s_2}{s_1} = k \\)","b_ar":"\\( \\dfrac{s_2}{s_1} = k \\)"},{"id":"geo:geo-similarity:Formula:16","ch":"geo-similarity","chEn":"Similarity & Proportional Reasoning","chAr":"التشابه والتناسب الهندسي","tag":"Formula","f":"Perimeter Ratio","f_ar":"المحيط Ratio","b":"\\( \\dfrac{P_2}{P_1} = k \\)","b_ar":"\\( \\dfrac{P_2}{P_1} = k \\)"},{"id":"geo:geo-similarity:Formula:17","ch":"geo-similarity","chEn":"Similarity & Proportional Reasoning","chAr":"التشابه والتناسب الهندسي","tag":"Formula","f":"Area Ratio","f_ar":"المساحة Ratio","b":"\\( \\dfrac{A_2}{A_1} = k^2 \\)","b_ar":"\\( \\dfrac{A_2}{A_1} = k^2 \\)"},{"id":"geo:geo-similarity:Formula:18","ch":"geo-similarity","chEn":"Similarity & Proportional Reasoning","chAr":"التشابه والتناسب الهندسي","tag":"Formula","f":"Volume Ratio","f_ar":"الحجم Ratio","b":"\\( \\dfrac{V_2}{V_1} = k^3 \\)","b_ar":"\\( \\dfrac{V_2}{V_1} = k^3 \\)"},{"id":"geo:geo-similarity:Theorem:19","ch":"geo-similarity","chEn":"Similarity & Proportional Reasoning","chAr":"التشابه والتناسب الهندسي","tag":"Theorem","f":"Theorem 4.5 — Angle Bisector Theorem","f_ar":"مبرهنة 4.5 — الزاوية Bisector مبرهنة","b":"<p>In any triangle \\( \\triangle ABC \\), the ray bisecting an interior angle divides the opposite side into two segments proportional to the other two adjacent sides:</p>\\[ \\text{If ray } AD \\text{ bisects } \\angle A \\text{ with } D \\text{ on } BC \\implies \\frac{BD}{DC} = \\frac{AB}{AC} \\]","b_ar":"<p>In any triangle \\( \\triangle ABC \\), the ray bisecting an interior angle divides the opposite side into two segments proportional to the other two adjacent sides:</p>\\[ \\text{If ray } AD \\text{ bisects } \\angle A \\text{ with } D \\text{ on } BC \\implies \\frac{BD}{DC} = \\frac{AB}{AC} \\]"},{"id":"geo:geo-right:Theorem:20","ch":"geo-right","chEn":"Right Triangles &amp; Trigonometry","chAr":"المثلثات القائمة وحساب المثلثات","tag":"Theorem","f":"Reference — Right-triangle toolkit","f_ar":"Reference — Right-triangle toolkit","b":"<p>Pythagoras: \\( a^{2}+b^{2}=c^{2} \\). A \\( 45\\text{\\text{-}}45\\text{\\text{-}}90 \\) triangle has sides \\( 1:1:\\sqrt2 \\); a \\( 30\\text{\\text{-}}60\\text{\\text{-}}90 \\) triangle has sides \\( 1:\\sqrt3:2 \\). Ratios: \\( \\sin=\\tfrac{\\text{opp}}{\\text{hyp}} \\), \\( \\cos=\\tfrac{\\text{adj}}{\\text{hyp}} \\), \\( \\tan=\\tfrac{\\text{opp}}{\\text{adj}} \\).</p>","b_ar":"<p>Pythagoras: \\( a^{2}+b^{2}=c^{2} \\). A \\( 45\\text{\\text{-}}45\\text{\\text{-}}90 \\) triangle has sides \\( 1:1:\\sqrt2 \\); a \\( 30\\text{\\text{-}}60\\text{\\text{-}}90 \\) triangle has sides \\( 1:\\sqrt3:2 \\). Ratios: \\( \\sin=\\tfrac{\\text{opp}}{\\text{hyp}} \\), \\( \\cos=\\tfrac{\\text{adj}}{\\text{hyp}} \\), \\( \\tan=\\tfrac{\\text{opp}}{\\text{adj}} \\).</p>"},{"id":"geo:geo-right:Formula:21","ch":"geo-right","chEn":"Right Triangles &amp; Trigonometry","chAr":"المثلثات القائمة وحساب المثلثات","tag":"Formula","f":"Pythagoras","f_ar":"Pythagoras (المثلثات القائمة وحساب المثلثات)","b":"\\( a^{2}+b^{2}=c^{2} \\)","b_ar":"\\( a^{2}+b^{2}=c^{2} \\)"},{"id":"geo:geo-right:Formula:22","ch":"geo-right","chEn":"Right Triangles &amp; Trigonometry","chAr":"المثلثات القائمة وحساب المثلثات","tag":"Formula","f":"45–45–90","f_ar":"45–45–90","b":"\\( 1:1:\\sqrt2 \\)","b_ar":"\\( 1:1:\\sqrt2 \\)"},{"id":"geo:geo-right:Formula:23","ch":"geo-right","chEn":"Right Triangles &amp; Trigonometry","chAr":"المثلثات القائمة وحساب المثلثات","tag":"Formula","f":"30–60–90","f_ar":"30–60–90","b":"\\( 1:\\sqrt3:2 \\)","b_ar":"\\( 1:\\sqrt3:2 \\)"},{"id":"geo:geo-right:Formula:24","ch":"geo-right","chEn":"Right Triangles &amp; Trigonometry","chAr":"المثلثات القائمة وحساب المثلثات","tag":"Formula","f":"Ratios","f_ar":"Ratios (المثلثات القائمة وحساب المثلثات)","b":"SOH-CAH-TOA","b_ar":"SOH-CAH-TOA (المثلثات القائمة وحساب المثلثات)"},{"id":"geo:geo-quads:Theorem:25","ch":"geo-quads","chEn":"Polygons &amp; Quadrilaterals","chAr":"المضلعات والأشكال الرباعية وخصائصها","tag":"Theorem","f":"Reference — Polygon angles","f_ar":"Reference — Polygon angles","b":"<p>Interior angles of an \\( n \\)-gon sum to \\( (n-2)\\times 180^{\\circ} \\); exterior angles always sum to \\( 360^{\\circ} \\). In a parallelogram, opposite sides and opposite angles are equal and the diagonals bisect each other.</p>","b_ar":"<p>Interior angles of an \\( n \\)-gon sum to \\( (n-2)\\times 180^{\\circ} \\); exterior angles always sum to \\( 360^{\\circ} \\). In a parallelogram, opposite sides and opposite angles are equal and the diagonals bisect each other.</p>"},{"id":"geo:geo-quads:Formula:26","ch":"geo-quads","chEn":"Polygons &amp; Quadrilaterals","chAr":"المضلعات والأشكال الرباعية وخصائصها","tag":"Formula","f":"Interior sum","f_ar":"Interior sum (المضلعات والأشكال الرباعية وخصائصها)","b":"\\( (n-2)\\,180^{\\circ} \\)","b_ar":"\\( (n-2)\\,180^{\\circ} \\)"},{"id":"geo:geo-quads:Formula:27","ch":"geo-quads","chEn":"Polygons &amp; Quadrilaterals","chAr":"المضلعات والأشكال الرباعية وخصائصها","tag":"Formula","f":"Regular interior","f_ar":"Regular interior (المضلعات والأشكال الرباعية وخصائصها)","b":"\\( \\dfrac{(n-2)180^{\\circ}}{n} \\)","b_ar":"\\( \\dfrac{(n-2)180^{\\circ}}{n} \\)"},{"id":"geo:geo-quads:Formula:28","ch":"geo-quads","chEn":"Polygons &amp; Quadrilaterals","chAr":"المضلعات والأشكال الرباعية وخصائصها","tag":"Formula","f":"Exterior angle","f_ar":"Exterior الزاوية","b":"\\( \\dfrac{360^{\\circ}}{n} \\)","b_ar":"\\( \\dfrac{360^{\\circ}}{n} \\)"},{"id":"geo:geo-quads:Formula:29","ch":"geo-quads","chEn":"Polygons &amp; Quadrilaterals","chAr":"المضلعات والأشكال الرباعية وخصائصها","tag":"Formula","f":"Parallelogram","f_ar":"Parallelogram (المضلعات والأشكال الرباعية وخصائصها)","b":"opposite angles equal","b_ar":"opposite angles equal"},{"id":"geo:geo-circles:Theorem:30","ch":"geo-circles","chEn":"Circles","chAr":"الدوائر والأوتار والمماسات والزوايا","tag":"Theorem","f":"Reference — Circle facts","f_ar":"Reference — الدائرة facts","b":"<p>Circumference \\( C=2\\pi r \\); area \\( A=\\pi r^{2} \\). The inscribed angle is half the central angle on the same arc, so the angle in a semicircle is \\( 90^{\\circ} \\). An arc and sector scale by \\( \\dfrac{\\theta}{360} \\).</p>","b_ar":"<p>Circumference \\( C=2\\pi r \\); area \\( A=\\pi r^{2} \\). The inscribed angle is half the central angle on the same arc, so the angle in a semicircle is \\( 90^{\\circ} \\). An arc and sector scale by \\( \\dfrac{\\theta}{360} \\).</p>"},{"id":"geo:geo-circles:Formula:31","ch":"geo-circles","chEn":"Circles","chAr":"الدوائر والأوتار والمماسات والزوايا","tag":"Formula","f":"Circumference","f_ar":"Circumference (الدوائر والأوتار والمماسات والزوايا)","b":"\\( C=2\\pi r \\)","b_ar":"\\( C=2\\pi r \\)"},{"id":"geo:geo-circles:Formula:32","ch":"geo-circles","chEn":"Circles","chAr":"الدوائر والأوتار والمماسات والزوايا","tag":"Formula","f":"Area","f_ar":"المساحة","b":"\\( A=\\pi r^{2} \\)","b_ar":"\\( A=\\pi r^{2} \\)"},{"id":"geo:geo-circles:Formula:33","ch":"geo-circles","chEn":"Circles","chAr":"الدوائر والأوتار والمماسات والزوايا","tag":"Formula","f":"Arc length","f_ar":"Arc length (الدوائر والأوتار والمماسات والزوايا)","b":"\\( \\dfrac{\\theta}{360}\\,2\\pi r \\)","b_ar":"\\( \\dfrac{\\theta}{360}\\,2\\pi r \\)"},{"id":"geo:geo-circles:Formula:34","ch":"geo-circles","chEn":"Circles","chAr":"الدوائر والأوتار والمماسات والزوايا","tag":"Formula","f":"Sector area","f_ar":"Sector المساحة","b":"\\( \\dfrac{\\theta}{360}\\,\\pi r^{2} \\)","b_ar":"\\( \\dfrac{\\theta}{360}\\,\\pi r^{2} \\)"},{"id":"geo:geo-solids:Theorem:35","ch":"geo-solids","chEn":"Area, Surface Area &amp; Volume","chAr":"المساحة والمساحة السطحية والحجوم للمجسمات","tag":"Theorem","f":"Reference — Key formulas","f_ar":"Reference — Key الصيغ","b":"<p>Rectangle area \\( A = bh \\); triangle \\( A = \\tfrac{1}{2} bh \\). Prism volume \\( V = A_{\\text{base}}\\times h \\); cylinder \\( V = \\pi r^{2}h \\); sphere \\( V = \\tfrac{4}{3}\\pi r^{3} \\); cone \\( V = \\tfrac{1}{3}\\pi r^{2}h \\).</p>","b_ar":"<p>Rectangle area \\( A = bh \\); triangle \\( A = \\tfrac{1}{2} bh \\). Prism volume \\( V = A_{\\text{base}}\\times h \\); cylinder \\( V = \\pi r^{2}h \\); sphere \\( V = \\tfrac{4}{3}\\pi r^{3} \\); cone \\( V = \\tfrac{1}{3}\\pi r^{2}h \\).</p>"},{"id":"geo:geo-solids:Formula:36","ch":"geo-solids","chEn":"Area, Surface Area &amp; Volume","chAr":"المساحة والمساحة السطحية والحجوم للمجسمات","tag":"Formula","f":"Rectangle","f_ar":"Rectangle (المساحة والمساحة السطحية والحجوم للمجسمات)","b":"\\( A=bh \\)","b_ar":"\\( A=bh \\)"},{"id":"geo:geo-solids:Formula:37","ch":"geo-solids","chEn":"Area, Surface Area &amp; Volume","chAr":"المساحة والمساحة السطحية والحجوم للمجسمات","tag":"Formula","f":"Triangle","f_ar":"المثلث","b":"\\( A=\\tfrac12 bh \\)","b_ar":"\\( A=\\tfrac12 bh \\)"},{"id":"geo:geo-solids:Formula:38","ch":"geo-solids","chEn":"Area, Surface Area &amp; Volume","chAr":"المساحة والمساحة السطحية والحجوم للمجسمات","tag":"Formula","f":"Prism / cylinder","f_ar":"Prism / cylinder (المساحة والمساحة السطحية والحجوم للمجسمات)","b":"\\( V=A_{\\text{base}}h \\)","b_ar":"\\( V=A_{\\text{base}}h \\)"},{"id":"geo:geo-solids:Formula:39","ch":"geo-solids","chEn":"Area, Surface Area &amp; Volume","chAr":"المساحة والمساحة السطحية والحجوم للمجسمات","tag":"Formula","f":"Sphere / cone","f_ar":"Sphere / cone (المساحة والمساحة السطحية والحجوم للمجسمات)","b":"\\( \\tfrac43\\pi r^{3},\\ \\tfrac13\\pi r^{2}h \\)","b_ar":"\\( \\tfrac43\\pi r^{3},\\ \\tfrac13\\pi r^{2}h \\)"},{"id":"geo:geo-transform:Theorem:40","ch":"geo-transform","chEn":"Transformations &amp; Symmetry","chAr":"التحويلات الهندسية والتماثل","tag":"Theorem","f":"Reference — Transformations","f_ar":"Reference — Transformations (التحويلات الهندسية والتماثل)","b":"<p>Translations, reflections and rotations are rigid motions that preserve distance. A dilation by factor \\( k \\) scales lengths by \\( k \\) and areas by \\( k^{2} \\).</p>","b_ar":"<p>Translations, reflections and rotations are rigid motions that preserve distance. A dilation by factor \\( k \\) scales lengths by \\( k \\) and areas by \\( k^{2} \\).</p>"},{"id":"geo:geo-transform:Formula:41","ch":"geo-transform","chEn":"Transformations &amp; Symmetry","chAr":"التحويلات الهندسية والتماثل","tag":"Formula","f":"Translation","f_ar":"Translation (التحويلات الهندسية والتماثل)","b":"slide","b_ar":"slide (التحويلات الهندسية والتماثل)"},{"id":"geo:geo-transform:Formula:42","ch":"geo-transform","chEn":"Transformations &amp; Symmetry","chAr":"التحويلات الهندسية والتماثل","tag":"Formula","f":"Reflection","f_ar":"Reflection (التحويلات الهندسية والتماثل)","b":"flip","b_ar":"flip (التحويلات الهندسية والتماثل)"},{"id":"geo:geo-transform:Formula:43","ch":"geo-transform","chEn":"Transformations &amp; Symmetry","chAr":"التحويلات الهندسية والتماثل","tag":"Formula","f":"Rotation","f_ar":"Rotation (التحويلات الهندسية والتماثل)","b":"turn","b_ar":"turn (التحويلات الهندسية والتماثل)"},{"id":"geo:geo-transform:Formula:44","ch":"geo-transform","chEn":"Transformations &amp; Symmetry","chAr":"التحويلات الهندسية والتماثل","tag":"Formula","f":"Dilation","f_ar":"Dilation (التحويلات الهندسية والتماثل)","b":"scale by \\( k \\)","b_ar":"scale by \\(k\\) (التحويلات الهندسية والتماثل)"}]