[{"id":"tahsili:tah-about:Formula:0","ch":"tah-about","chEn":"Test format & strategy","chAr":"شكل الاختبار والاستراتيجية","tag":"Formula","f":"Basis","f_ar":"الأساس","b":"secondary curriculum","b_ar":"منهج المرحلة الثانوية"},{"id":"tahsili:tah-about:Formula:1","ch":"tah-about","chEn":"Test format & strategy","chAr":"شكل الاختبار والاستراتيجية","tag":"Formula","f":"Span","f_ar":"النطاق","b":"algebra → calculus","b_ar":"الجبر ← التفاضل والتكامل"},{"id":"tahsili:tah-about:Theorem:2","ch":"tah-about","chEn":"Test format & strategy","chAr":"شكل الاختبار والاستراتيجية","tag":"Theorem","f":"How to prepare","f_ar":"كيف تستعد","b":"Work by topic, master the standard formulas, and practise recall under time pressure. The eight chapters below mirror the curriculum strands; each ends with worked examples, and the practice set blends all of them.","b_ar":"اعمل حسب الموضوع، وأتقن الصيغ القياسية، وتدرّب على الاسترجاع السريع تحت ضغط الوقت. تعكس الفصول الثمانية أدناه محاور المنهج؛ وينتهي كل فصل بأمثلة محلولة، وتمزج مجموعة التدريب بينها جميعًا."},{"id":"tahsili:tah-algebra:Formula:3","ch":"tah-algebra","chEn":"Algebra & Equations","chAr":"الجبر والمعادلات","tag":"Formula","f":"Quadratic formula","f_ar":"القانون العام","b":"\\( x = \\dfrac{-b \\pm \\sqrt{b^2 - 4ac}}{2a} \\)","b_ar":"\\( x = \\dfrac{-b \\pm \\sqrt{b^2 - 4ac}}{2a} \\)"},{"id":"tahsili:tah-algebra:Formula:4","ch":"tah-algebra","chEn":"Algebra & Equations","chAr":"الجبر والمعادلات","tag":"Formula","f":"Discriminant","f_ar":"المميّز \\(\\Delta\\)","b":"\\( \\Delta = b^2 - 4ac \\)","b_ar":"\\( \\Delta = b^2 - 4ac \\)"},{"id":"tahsili:tah-algebra:Formula:5","ch":"tah-algebra","chEn":"Algebra & Equations","chAr":"الجبر والمعادلات","tag":"Formula","f":"Sum of Roots","f_ar":"مجموع الجذرين","b":"\\( x_1 + x_2 = -\\dfrac{b}{a} \\)","b_ar":"\\( x_1 + x_2 = -\\dfrac{b}{a} \\)"},{"id":"tahsili:tah-algebra:Formula:6","ch":"tah-algebra","chEn":"Algebra & Equations","chAr":"الجبر والمعادلات","tag":"Formula","f":"Matrix Determinant","f_ar":"محددة المصفوفة","b":"\\( \\det(A) = ad - bc \\)","b_ar":"\\( \\det(A) = ad - bc \\)"},{"id":"tahsili:tah-functions:Formula:7","ch":"tah-functions","chEn":"Functions","chAr":"الدوال","tag":"Formula","f":"Transformation","f_ar":"التحويل الهندسي","b":"\\( y = a f(x - h) + k \\)","b_ar":"\\( y = a f(x - h) + k \\)"},{"id":"tahsili:tah-functions:Formula:8","ch":"tah-functions","chEn":"Functions","chAr":"الدوال","tag":"Formula","f":"Even Function","f_ar":"دالة زوجية","b":"\\( f(-x) = f(x) \\quad (y\\text{-axis}) \\)","b_ar":"\\( f(-x) = f(x) \\quad (y\\text{-axis}) \\)"},{"id":"tahsili:tah-functions:Formula:9","ch":"tah-functions","chEn":"Functions","chAr":"الدوال","tag":"Formula","f":"Odd Function","f_ar":"دالة فردية","b":"\\( f(-x) = -f(x) \\quad (\\text{origin}) \\)","b_ar":"\\( f(-x) = -f(x) \\quad (\\text{origin}) \\)"},{"id":"tahsili:tah-functions:Formula:10","ch":"tah-functions","chEn":"Functions","chAr":"الدوال","tag":"Formula","f":"Inverse Identity","f_ar":"الدالة العكسية","b":"\\( (f \\circ f^{-1})(x) = x \\)","b_ar":"\\( (f \\circ f^{-1})(x) = x \\)"},{"id":"tahsili:tah-sequences:Formula:11","ch":"tah-sequences","chEn":"Sequences & Series","chAr":"المتتاليات والمتسلسلات","tag":"Formula","f":"Arithmetic term","f_ar":"حد المتتابعة الحسابية","b":"\\( a_n = a_1 + (n - 1)d \\)","b_ar":"\\( a_n = a_1 + (n - 1)d \\)"},{"id":"tahsili:tah-sequences:Formula:12","ch":"tah-sequences","chEn":"Sequences & Series","chAr":"المتتاليات والمتسلسلات","tag":"Formula","f":"Arithmetic sum","f_ar":"مجموع الحسابية","b":"\\( S_n = \\dfrac{n}{2}(a_1 + a_n) \\)","b_ar":"\\( S_n = \\dfrac{n}{2}(a_1 + a_n) \\)"},{"id":"tahsili:tah-sequences:Formula:13","ch":"tah-sequences","chEn":"Sequences & Series","chAr":"المتتاليات والمتسلسلات","tag":"Formula","f":"Geometric term","f_ar":"حد المتتابعة الهندسية","b":"\\( a_n = a_1 r^{n-1} \\)","b_ar":"\\( a_n = a_1 r^{n-1} \\)"},{"id":"tahsili:tah-sequences:Formula:14","ch":"tah-sequences","chEn":"Sequences & Series","chAr":"المتتاليات والمتسلسلات","tag":"Formula","f":"Infinite sum","f_ar":"المجموع اللانهائي","b":"\\( S_\\infty = \\dfrac{a_1}{1 - r},\\; |r| < 1 \\)","b_ar":"\\( S_\\infty = \\dfrac{a_1}{1 - r},\\; |r| < 1 \\)"},{"id":"tahsili:tah-trig:Formula:15","ch":"tah-trig","chEn":"Trigonometry","chAr":"المثلثات","tag":"Formula","f":"Special angles","f_ar":"الزوايا الخاصة","b":"\\( \\sin 30^\\circ = \\tfrac{1}{2},\\; \\cos 60^\\circ = \\tfrac{1}{2} \\)","b_ar":"\\( \\sin 30^\\circ = \\tfrac{1}{2},\\; \\cos 60^\\circ = \\tfrac{1}{2} \\)"},{"id":"tahsili:tah-trig:Formula:16","ch":"tah-trig","chEn":"Trigonometry","chAr":"المثلثات","tag":"Formula","f":"Pythagorean Identity","f_ar":"متطابقة فيثاغورس","b":"\\( \\sin^2\\theta + \\cos^2\\theta = 1 \\)","b_ar":"\\( \\sin^2\\theta + \\cos^2\\theta = 1 \\)"},{"id":"tahsili:tah-trig:Formula:17","ch":"tah-trig","chEn":"Trigonometry","chAr":"المثلثات","tag":"Formula","f":"Law of Sines","f_ar":"قانون الجيوب","b":"\\( \\dfrac{\\sin A}{a} = \\dfrac{\\sin B}{b} = \\dfrac{\\sin C}{c} \\)","b_ar":"\\( \\dfrac{\\sin A}{a} = \\dfrac{\\sin B}{b} = \\dfrac{\\sin C}{c} \\)"},{"id":"tahsili:tah-trig:Formula:18","ch":"tah-trig","chEn":"Trigonometry","chAr":"المثلثات","tag":"Formula","f":"Wave Period","f_ar":"دورة الدالة","b":"\\( T = \\dfrac{2\\pi}{|B|} \\quad (\\sin,\\cos) \\)","b_ar":"\\( T = \\dfrac{2\\pi}{|B|} \\quad (\\sin,\\cos) \\)"},{"id":"tahsili:tah-geometry:Formula:19","ch":"tah-geometry","chEn":"Geometry & Coordinate Geometry","chAr":"الهندسة والهندسة الإحداثية","tag":"Formula","f":"Distance","f_ar":"المسافة","b":"\\( d = \\sqrt{\\Delta x^2 + \\Delta y^2} \\)","b_ar":"\\( d = \\sqrt{\\Delta x^2 + \\Delta y^2} \\)"},{"id":"tahsili:tah-geometry:Formula:20","ch":"tah-geometry","chEn":"Geometry & Coordinate Geometry","chAr":"الهندسة والهندسة الإحداثية","tag":"Formula","f":"Midpoint","f_ar":"نقطة المنتصف","b":"\\( M = \\big(\\tfrac{x_1+x_2}{2},\\tfrac{y_1+y_2}{2}\\big) \\)","b_ar":"\\( M = \\big(\\tfrac{x_1+x_2}{2},\\tfrac{y_1+y_2}{2}\\big) \\)"},{"id":"tahsili:tah-geometry:Formula:21","ch":"tah-geometry","chEn":"Geometry & Coordinate Geometry","chAr":"الهندسة والهندسة الإحداثية","tag":"Formula","f":"Perpendicular","f_ar":"ميل التعامد","b":"\\( m_1 \\cdot m_2 = -1 \\)","b_ar":"\\( m_1 \\cdot m_2 = -1 \\)"},{"id":"tahsili:tah-geometry:Formula:22","ch":"tah-geometry","chEn":"Geometry & Coordinate Geometry","chAr":"الهندسة والهندسة الإحداثية","tag":"Formula","f":"Circle Equation","f_ar":"معادلة الدائرة","b":"\\( (x-h)^2 + (y-k)^2 = r^2 \\)","b_ar":"\\( (x-h)^2 + (y-k)^2 = r^2 \\)"},{"id":"tahsili:tah-calc1:Formula:23","ch":"tah-calc1","chEn":"Limits & Derivatives","chAr":"النهايات والمشتقات","tag":"Formula","f":"Power rule","f_ar":"قاعدة القوة","b":"\\( \\dfrac{d}{dx}x^{n}=nx^{n-1} \\)","b_ar":"\\( \\dfrac{d}{dx}x^{n}=nx^{n-1} \\)"},{"id":"tahsili:tah-calc1:Formula:24","ch":"tah-calc1","chEn":"Limits & Derivatives","chAr":"النهايات والمشتقات","tag":"Formula","f":"Trig Derivatives","f_ar":"مشتقات المثلثات","b":"\\( (\\sin x)' = \\cos x,\\; (\\cos x)' = -\\sin x \\)","b_ar":"\\( (\\sin x)' = \\cos x,\\; (\\cos x)' = -\\sin x \\)"},{"id":"tahsili:tah-calc1:Formula:25","ch":"tah-calc1","chEn":"Limits & Derivatives","chAr":"النهايات والمشتقات","tag":"Formula","f":"Product Rule","f_ar":"مشتقة الضرب","b":"\\( (u \\cdot v)' = u'v + uv' \\)","b_ar":"\\( (u \\cdot v)' = u'v + uv' \\)"},{"id":"tahsili:tah-calc1:Formula:26","ch":"tah-calc1","chEn":"Limits & Derivatives","chAr":"النهايات والمشتقات","tag":"Formula","f":"Chain Rule","f_ar":"قاعدة السلسلة","b":"\\( [g(x)^n]' = n g(x)^{n-1} \\cdot g'(x) \\)","b_ar":"\\( [g(x)^n]' = n g(x)^{n-1} \\cdot g'(x) \\)"},{"id":"tahsili:tah-calc2:Definition:27","ch":"tah-calc2","chEn":"Integration & Applications","chAr":"التكامل وتطبيقاته","tag":"Definition","f":"Deep Conceptual Intuition — Integration & Applications","f_ar":"الفهم المفاهيمي العميق — التكامل وتطبيقاته","b":"<p><strong>Accumulation, Antiderivatives &amp; Differential Flows:</strong> By the Fundamental Theorem of Calculus, the accumulation function \\(A(x) = \\int_a^x f(t)\\,dt\\) satisfies \\(A'(x) = f(x)\\), linking instantaneous rates of change to net signed area. In first-order differential equations \\(\\dfrac{dy}{dx} = g(x)h(y)\\), separation of variables \\(\\int \\dfrac{1}{h(y)}\\,dy = \\int g(x)\\,dx + C\\) reconstructs the family of integral curves across the slope field.</p>","b_ar":"<p><strong>التراكم والتكامل والمعادلات التفاضلية:</strong> تربط النظرية الأساسية للتفاضل والتكامل بين المشتقة والمساحة الموجهة \\(\\frac{d}{dx}\\int_a^x f(t)\\,dt = f(x)\\).</p>"},{"id":"tahsili:tah-calc2:Formula:28","ch":"tah-calc2","chEn":"Integration & Applications","chAr":"التكامل وتطبيقاته","tag":"Formula","f":"Power rule","f_ar":"قاعدة القوة","b":"\\( \\displaystyle\\int x^n\\,dx = \\tfrac{x^{n+1}}{n+1} + C \\)","b_ar":"\\( \\displaystyle\\int x^n\\,dx = \\tfrac{x^{n+1}}{n+1} + C \\)"},{"id":"tahsili:tah-calc2:Formula:29","ch":"tah-calc2","chEn":"Integration & Applications","chAr":"التكامل وتطبيقاته","tag":"Formula","f":"Fundamental Theorem","f_ar":"النظرية الأساسية","b":"\\( \\displaystyle\\int_a^b f = F(b) - F(a) \\)","b_ar":"\\( \\displaystyle\\int_a^b f = F(b) - F(a) \\)"},{"id":"tahsili:tah-calc2:Formula:30","ch":"tah-calc2","chEn":"Integration & Applications","chAr":"التكامل وتطبيقاته","tag":"Formula","f":"Trig Integral","f_ar":"تكامل الجيب","b":"\\( \\displaystyle\\int \\sin x\\,dx = -\\cos x + C \\)","b_ar":"\\( \\displaystyle\\int \\sin x\\,dx = -\\cos x + C \\)"},{"id":"tahsili:tah-calc2:Formula:31","ch":"tah-calc2","chEn":"Integration & Applications","chAr":"التكامل وتطبيقاته","tag":"Formula","f":"Area Under Curve","f_ar":"المساحة تحت المنحنى","b":"\\( A = \\displaystyle\\int_a^b f(x)\\,dx \\)","b_ar":"\\( A = \\displaystyle\\int_a^b f(x)\\,dx \\)"},{"id":"tahsili:tah-explog:Formula:32","ch":"tah-explog","chEn":"Exponentials & Logarithms","chAr":"الأسس واللوغاريتمات","tag":"Formula","f":"Definition","f_ar":"التعريف الأساسي","b":"\\( \\log_b x = y \\iff b^y = x \\)","b_ar":"\\( \\log_b x = y \\iff b^y = x \\)"},{"id":"tahsili:tah-explog:Formula:33","ch":"tah-explog","chEn":"Exponentials & Logarithms","chAr":"الأسس واللوغاريتمات","tag":"Formula","f":"Product Law","f_ar":"خاصية الضرب","b":"\\( \\log_b(xy) = \\log_b x + \\log_b y \\)","b_ar":"\\( \\log_b(xy) = \\log_b x + \\log_b y \\)"},{"id":"tahsili:tah-explog:Formula:34","ch":"tah-explog","chEn":"Exponentials & Logarithms","chAr":"الأسس واللوغاريتمات","tag":"Formula","f":"Quotient Law","f_ar":"خاصية القسمة","b":"\\( \\log_b(x/y) = \\log_b x - \\log_b y \\)","b_ar":"\\( \\log_b(x/y) = \\log_b x - \\log_b y \\)"},{"id":"tahsili:tah-explog:Formula:35","ch":"tah-explog","chEn":"Exponentials & Logarithms","chAr":"الأسس واللوغاريتمات","tag":"Formula","f":"Power Law","f_ar":"خاصية القوة","b":"\\( \\log_b(x^k) = k\\log_b x \\)","b_ar":"\\( \\log_b(x^k) = k\\log_b x \\)"},{"id":"tahsili:tah-stats:Formula:36","ch":"tah-stats","chEn":"Statistics & Probability","chAr":"الإحصاء والاحتمالات","tag":"Formula","f":"Permutations","f_ar":"التباديل","b":"\\( _nP_r = \\dfrac{n!}{(n-r)!} \\)","b_ar":"\\( _nP_r = \\dfrac{n!}{(n-r)!} \\)"},{"id":"tahsili:tah-stats:Formula:37","ch":"tah-stats","chEn":"Statistics & Probability","chAr":"الإحصاء والاحتمالات","tag":"Formula","f":"Combinations","f_ar":"التوافيق","b":"\\( \\binom{n}{r} = \\dfrac{n!}{r!(n-r)!} \\)","b_ar":"\\( \\binom{n}{r} = \\dfrac{n!}{r!(n-r)!} \\)"},{"id":"tahsili:tah-stats:Formula:38","ch":"tah-stats","chEn":"Statistics & Probability","chAr":"الإحصاء والاحتمالات","tag":"Formula","f":"Conditional Prob","f_ar":"الاحتمال المشروط","b":"\\( P(A|B) = \\dfrac{P(A \\cap B)}{P(B)} \\)","b_ar":"\\( P(A|B) = \\dfrac{P(A \\cap B)}{P(B)} \\)"},{"id":"tahsili:tah-stats:Formula:39","ch":"tah-stats","chEn":"Statistics & Probability","chAr":"الإحصاء والاحتمالات","tag":"Formula","f":"Empirical Rule","f_ar":"القاعدة التجريبية","b":"\\( \\pm 1\\sigma \\approx 68\\%,\\; \\pm 2\\sigma \\approx 95\\% \\)","b_ar":"\\( \\pm 1\\sigma \\approx 68\\%,\\; \\pm 2\\sigma \\approx 95\\% \\)"}]