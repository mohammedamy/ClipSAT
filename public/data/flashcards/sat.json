ns &amp; Linear Inequalities","chAr":"الدوال الخطية والمتباينات الخطية","tag":"Formula","f":"Parallel","f_ar":"الموازي","b":"equal slopes","b_ar":"متساوي ميول"},{"id":"sat:sat-linfun:Formula:8","ch":"sat-linfun","chEn":"Linear Functions &amp; Linear Inequalities","chAr":"الدوال الخطية والمتباينات الخطية","tag":"Formula","f":"Perpendicular","f_ar":"العمودي","b":"\\( m_1m_2=-1 \\)","b_ar":"\\( m_1m_2=-1 \\)"},{"id":"sat:sat-quad:Formula:9","ch":"sat-quad","chEn":"Equivalent Expressions &amp; Quadratic Equations","chAr":"العبارات المتكافئة والمعادلات والدوال التربيعية","tag":"Formula","f":"Quadratic formula","f_ar":"القانون العام للمعادلة التربيعية","b":"\\( \\dfrac{-b\\pm\\sqrt{b^{2}-4ac}}{2a} \\)","b_ar":"\\( \\dfrac{-b\\pm\\sqrt{b^{2}-4ac}}{2a} \\)"},{"id":"sat:sat-quad:Formula:10","ch":"sat-quad","chEn":"Equivalent Expressions &amp; Quadratic Equations","chAr":"العبارات المتكافئة والمعادلات والدوال التربيعية","tag":"Formula","f":"Discriminant","f_ar":"المميز","b":"\\( b^{2}-4ac \\)","b_ar":"\\( b^{2}-4ac \\)"},{"id":"sat:sat-quad:Formula:11","ch":"sat-quad","chEn":"Equivalent Expressions &amp; Quadratic Equations","chAr":"العبارات المتكافئة والمعادلات والدوال التربيعية","tag":"Formula","f":"Vertex","f_ar":"رأس","b":"\\( x=-\\dfrac{b}{2a} \\)","b_ar":"\\( x=-\\dfrac{b}{2a} \\)"},{"id":"sat:sat-quad:Formula:12","ch":"sat-quad","chEn":"Equivalent Expressions &amp; Quadratic Equations","chAr":"العبارات المتكافئة والمعادلات والدوال التربيعية","tag":"Formula","f":"Difference of squares","f_ar":"الفرق بين مربعين","b":"\\( a^{2}-b^{2} \\)","b_ar":"\\( a^{2}-b^{2} \\)"},{"id":"sat:sat-quad:Formula:13","ch":"sat-quad","chEn":"Equivalent Expressions &amp; Quadratic Equations","chAr":"العبارات المتكافئة والمعادلات والدوال التربيعية","tag":"Formula","f":"\\(|f(x)|=k\\)","f_ar":"\\(|f(x)|=k\\)","b":"Two cases: \\(f(x)=\\pm k\\)","b_ar":"اثنان حالات: \\(f(x)=\\pm k\\)"},{"id":"sat:sat-quad:Formula:14","ch":"sat-quad","chEn":"Equivalent Expressions &amp; Quadratic Equations","chAr":"العبارات المتكافئة والمعادلات والدوال التربيعية","tag":"Formula","f":"|x|&lt;k","f_ar":"|x|&lt;k","b":"-k&lt;x&lt;k","b_ar":"-k&lt;x&lt;k"},{"id":"sat:sat-quad:Formula:15","ch":"sat-quad","chEn":"Equivalent Expressions &amp; Quadratic Equations","chAr":"العبارات المتكافئة والمعادلات والدوال التربيعية","tag":"Formula","f":"|x|&gt;k","f_ar":"|x|&gt;k","b":"x&lt;{-k} or x&gt;k","b_ar":"x&lt;{-k} أو x&gt;k"},{"id":"sat:sat-quad:Formula:16","ch":"sat-quad","chEn":"Equivalent Expressions &amp; Quadratic Equations","chAr":"العبارات المتكافئة والمعادلات والدوال التربيعية","tag":"Formula","f":"No solution","f_ar":"لا يوجد حل","b":"\\(|f(x)|=\\text{negative}\\)","b_ar":"\\(|f(x)|=\\text{negative}\\)"},{"id":"sat:sat-expoly:Formula:17","ch":"sat-expoly","chEn":"Exponentials, Radicals, Polynomials &amp; Rational Expressions","chAr":"الأسس والجذور وكثيرات الحدود والعبارات النسبية","tag":"Formula","f":"Product","f_ar":"حاصل الضرب","b":"\\( a^{m}a^{n}=a^{m+n} \\)","b_ar":"\\( a^{m}a^{n}=a^{m+n} \\)"},{"id":"sat:sat-expoly:Formula:18","ch":"sat-expoly","chEn":"Exponentials, Radicals, Polynomials &amp; Rational Expressions","chAr":"الأسس والجذور وكثيرات الحدود والعبارات النسبية","tag":"Formula","f":"Power","f_ar":"القوة","b":"\\( (a^{m})^{n}=a^{mn} \\)","b_ar":"\\( (a^{m})^{n}=a^{mn} \\)"},{"id":"sat:sat-expoly:Formula:19","ch":"sat-expoly","chEn":"Exponentials, Radicals, Polynomials &amp; Rational Expressions","chAr":"الأسس والجذور وكثيرات الحدود والعبارات النسبية","tag":"Formula","f":"Exponential","f_ar":"الأسية","b":"\\( y=a\\cdot b^{x} \\)","b_ar":"\\( y=a\\cdot b^{x} \\)"},{"id":"sat:sat-expoly:Formula:20","ch":"sat-expoly","chEn":"Exponentials, Radicals, Polynomials &amp; Rational Expressions","chAr":"الأسس والجذور وكثيرات الحدود والعبارات النسبية","tag":"Formula","f":"Simplify","f_ar":"بسّط","b":"cancel common factors","b_ar":"اختصر مشترك عوامل"},{"id":"sat:sat-expoly:Definition:21","ch":"sat-expoly","chEn":"Exponentials, Radicals, Polynomials &amp; Rational Expressions","