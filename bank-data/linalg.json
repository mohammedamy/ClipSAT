    { "type": "mcq", "domain": "Matrices & Matrix Algebra", "text": "For \\( n\\times n \\) matrices \\( A,B \\) with \\( n\\ge2 \\), which is true in general?", "choices": ["AB ≠ BA in general", "AB = BA always", "AB is never invertible", "AB = A + B"], "answer": 0, "sol": "Matrix multiplication is not commutative in general — order matters.", "difficulty": "hard" },
