      "questions": [
        {
          "q": "Simplify $\\dfrac{x^2-4}{x^2+x-6}$.",
          "answer": "$\\dfrac{x^2-4}{x^2+x-6}=\\dfrac{(x-2)(x+2)}{(x-2)(x+3)}=\\dfrac{x+2}{x+3},\\ x\\neq2$."
        },
        {
          "q": "Simplify $\\dfrac{x^2-5x+6}{x^2-9}$.",
          "answer": "$\\dfrac{x^2-5x+6}{x^2-9}=\\dfrac{(x-2)(x-3)}{(x-3)(x+3)}=\\dfrac{x-2}{x+3},\\ x\\neq3$."
        },
        {
          "q": "Combine into a single fraction: $\\dfrac{2}{x+1}+\\dfrac{3}{x-1}$.",
          "answer": "$\\dfrac{2}{x+1}+\\dfrac{3}{x-1}=\\dfrac{2(x-1)+3(x+1)}{(x+1)(x-1)}=\\dfrac{2x-2+3x+3}{x^2-1}=\\dfrac{5x+1}{x^2-1}$."
        },
        {
          "q": "Simplify $\\dfrac{3x^2-12}{x^2-4x+4}$.",
          "answer": "$\\dfrac{3x^2-12}{x^2-4x+4}=\\dfrac{3(x-2)(x+2)}{(x-2)^2}=\\dfrac{3(x+2)}{x-2},\\ x\\neq2$."
        }
      ]
