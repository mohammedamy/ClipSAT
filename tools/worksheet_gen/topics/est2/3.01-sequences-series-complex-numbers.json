      "heading": "Geometric series",
      "questions": [
        {
          "q": "Find the sum of the first 8 terms of the geometric sequence $2,\\,6,\\,18,\\ldots$",
          "answer": "$a_1=2$, $r=3$. $S_8=\\dfrac{2(3^8-1)}{3-1}=\\dfrac{2(6561-1)}{2}=6560$."
        },
        {
          "q": "Find the sum to infinity of $16-8+4-2+\\cdots$",
          "answer": "$a_1=16$, $r=-\\dfrac{1}{2}$. $S_\\infty=\\dfrac{16}{1-\\left(-\\dfrac{1}{2}\\right)}=\\dfrac{16}{3/2}=\\dfrac{32}{3}$."
        },
        {
          "q": "Express the repeating decimal $0.4\\overline{5}$ (that is, $0.45555\\ldots$) as a geometric series and find its exact fractional value.",
          "answer": "$0.4\\overline{5}=0.4+\\left(0.05+0.005+0.0005+\\cdots\\right)$. The bracketed part is geometric with $a_1=0.05$, $r=0.1$, summing to $\\dfrac{0.05}{0.9}=\\dfrac{1}{18}$. Total: $\\dfrac{2}{5}+\\dfrac{1}{18}=\\dfrac{36}{90}+\\dfrac{5}{90}=\\dfrac{41}{90}$."
        }
      ]
