{
  "track": "apab",
  "num": "2.02",
  "title": "Product, Quotient, and Trigonometric Derivatives",
  "sections": [
    {
      "heading": "The product rule",
      "questions": [
        {
          "q": "Differentiate $f(x)=(3x^2-1)(x^3+2x)$ using the product rule.",
          "answer": "$f'(x)=6x(x^3+2x)+(3x^2-1)(3x^2+2) = 6x^4+12x^2+9x^4+6x^2-3x^2-2 = 15x^4+15x^2-2$."
        },
        {
          "q": "Differentiate $f(x)=x^2\\sin x$.",
          "answer": "$f'(x)=2x\\sin x+x^2\\cos x$."
        },
        {
          "q": "Differentiate $f(x)=e^x\\cos x$.",
          "answer": "$f'(x)=e^x\\cos x - e^x\\sin x = e^x(\\cos x-\\sin x)$."
        }
      ]
    },
    {
      "heading": "The quotient rule",
      "questions": [
        {
          "q": "Differentiate $f(x)=\\frac{3x-1}{x+4}$.",
          "answer": "$f'(x)=\\frac{3(x+4)-(3x-1)(1)}{(x+4)^2}=\\frac{3x+12-3x+1}{(x+4)^2}=\\frac{13}{(x+4)^2}$."
        },
        {
          "q": "Differentiate $f(x)=\\frac{x^2}{x^2+1}$.",
          "answer": "$f'(x)=\\frac{2x(x^2+1)-x^2(2x)}{(x^2+1)^2}=\\frac{2x^3+2x-2x^3}{(x^2+1)^2}=\\frac{2x}{(x^2+1)^2}$."
        },
        {
          "q": "Differentiate $f(x)=\\frac{\\sin x}{x}$.",
          "answer": "$f'(x)=\\frac{x\\cos x-\\sin x}{x^2}$."
        }
      ]
    },
    {
      "heading": "Derivatives of the six trig functions",
      "questions": [
        {
          "q": "State the derivative of each trig function:",
          "parts": ["$\\frac{d}{dx}\\sin x$", "$\\frac{d}{dx}\\cos x$", "$\\frac{d}{dx}\\tan x$", "$\\frac{d}{dx}\\cot x$", "$\\frac{d}{dx}\\sec x$", "$\\frac{d}{dx}\\csc x$"],
          "cols": 3,
          "answers": ["$=\\cos x$", "$=-\\sin x$", "$=\\sec^2x$", "$=-\\csc^2x$", "$=\\sec x\\tan x$", "$=-\\csc x\\cot x$"]
        },
        {
          "q": "Differentiate $f(x)=x\\tan x$.",
          "answer": "$f'(x)=\\tan x+x\\sec^2x$."
        },
        {
          "q": "Differentiate $f(x)=\\sec x\\cdot \\csc x$.",
          "answer": "$f'(x)=\\sec x\\tan x\\csc x + \\sec x(-\\csc x\\cot x) = \\sec x\\csc x(\\tan x-\\cot x)$."
        }
      ]
    },
    {
      "heading": "Combining product, quotient, and trig rules",
      "questions": [
        {
          "q": "Differentiate $f(x)=\\frac{e^x}{\\sin x}$.",
          "answer": "$f'(x)=\\frac{e^x\\sin x-e^x\\cos x}{\\sin^2x}=\\frac{e^x(\\sin x-\\cos x)}{\\sin^2x}$."
        },
        {
          "q": "Find the equation of the tangent line to $f(x)=x\\cos x$ at $x=0$.",
          "answer": "$f(0)=0$. $f'(x)=\\cos x-x\\sin x$; $f'(0)=1$. Tangent: $y-0=1(x-0)$, i.e. $y=x$."
        }
      ]
    },
    {
      "heading": "Derivatives using a table of values",
      "questions": [
        {
          "q": "Given $f(3)=2$, $f'(3)=-1$, $g(3)=4$, $g'(3)=5$, find $h'(3)$ if $h(x)=f(x)g(x)$.",
          "answer": "$h'(x)=f'(x)g(x)+f(x)g'(x)$; $h'(3)=(-1)(4)+(2)(5)=-4+10=6$."
        },
        {
          "q": "Using the same table, find $k'(3)$ if $k(x)=\\frac{f(x)}{g(x)}$.",
          "answer": "$k'(x)=\\frac{f'(x)g(x)-f(x)g'(x)}{[g(x)]^2}$; $k'(3)=\\frac{(-1)(4)-(2)(5)}{4^2}=\\frac{-4-10}{16}=-\\frac{14}{16}=-\\frac{7}{8}$."
        }
      ]
    },
    {
      "heading": "Second derivatives with product and quotient rules",
      "questions": [
        {
          "q": "Find $f''(x)$ for $f(x)=x\\sin x$.",
          "answer": "$f'(x)=\\sin x+x\\cos x$. $f''(x)=\\cos x+\\cos x-x\\sin x=2\\cos x-x\\sin x$."
        }
      ]
    }
  ]
