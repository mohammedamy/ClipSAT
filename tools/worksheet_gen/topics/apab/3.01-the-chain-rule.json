  "track": "apab",
  "num": "3.01",
  "title": "The Chain Rule",
  "sections": [
    {
      "heading": "Basic chain rule applications",
      "questions": [
        {
          "q": "Differentiate each function using the chain rule:",
          "parts": ["$f(x)=(4x-1)^5$", "$f(x)=\\sin(3x^2)$", "$f(x)=e^{5x}$", "$f(x)=\\ln(2x+7)$"],
          "cols": 2,
          "answers": [
            "$=5(4x-1)^4(4)=20(4x-1)^4$",
            "$=6x\\cos(3x^2)$",
            "$=5e^{5x}$",
            "$=\\frac{2}{2x+7}$"
          ]
        },
        {
          "q": "Differentiate $f(x)=\\sqrt{x^2+9}$.",
          "answer": "$f'(x)=\\frac{2x}{2\\sqrt{x^2+9}}=\\frac{x}{\\sqrt{x^2+9}}$."
        }
      ]
    },
    {
      "heading": "The chain rule with trig and exponential functions",
      "questions": [
        {
          "q": "Differentiate $f(x)=\\cos^3(x)$ (i.e. $[\\cos x]^3$).",
          "answer": "$f'(x)=3\\cos^2x\\cdot(-\\sin x)=-3\\cos^2x\\sin x$."
        },
        {
          "q": "Differentiate $f(x)=e^{\\sin x}$.",
          "answer": "$f'(x)=\\cos x\\cdot e^{\\sin x}$."
        },
        {
          "q": "Differentiate $f(x)=\\tan(e^x)$.",
          "answer": "$f'(x)=\\sec^2(e^x)\\cdot e^x$."
        }
      ]
    },
    {
      "heading": "Nested (multiple) chain rule",
      "questions": [
        {
          "q": "Differentiate $f(x)=\\sin\\left(\\sqrt{x^2+1}\\right)$, applying the chain rule twice.",
          "answer": "$f'(x)=\\cos\\left(\\sqrt{x^2+1}\\right)\\cdot\\frac{x}{\\sqrt{x^2+1}}$."
        },
        {
          "q": "Differentiate $f(x)=\\left(\\ln(3x)\\right)^4$.",
          "answer": "$f'(x)=4\\left(\\ln(3x)\\right)^3\\cdot\\frac{3}{3x}=\\frac{4\\left(\\ln(3x)\\right)^3}{x}$."
        }
      ]
    },
    {
      "heading": "Chain rule combined with product/quotient rules",
      "questions": [
        {
          "q": "Differentiate $f(x)=x^2e^{3x}$.",
          "answer": "$f'(x)=2xe^{3x}+x^2(3e^{3x})=e^{3x}(2x+3x^2)$."
        },
        {
          "q": "Differentiate $f(x)=\\frac{\\sin(2x)}{x}$.",
          "answer": "$f'(x)=\\frac{2\\cos(2x)\\cdot x-\\sin(2x)}{x^2}$."
        }
      ]
    },
    {
      "heading": "Chain rule with tables of values",
      "questions": [
        {
          "q": "Given $f(2)=5$, $f'(2)=3$, $g(2)=7$, $g'(2)=-1$, find $\\frac{d}{dx}\\left[f(g(x))\\right]$ at $x=2$ if $g(2)=7$ and $f'(7)=4$ (note the composition uses $f'$ evaluated at $g(2)=7$, not at $2$).",
          "answer": "$\\frac{d}{dx}f(g(x))=f'(g(x))\\cdot g'(x)$; at $x=2$: $f'(7)\\cdot g'(2) = 4\\cdot(-1)=-4$."
        }
      ]
    },
    {
      "heading": "Chain rule with inverse trig and logarithms",
      "questions": [
        {
          "q": "Differentiate $f(x)=\\sin^{-1}(2x)$.",
          "answer": "$f'(x)=\\frac{2}{\\sqrt{1-(2x)^2}}=\\frac{2}{\\sqrt{1-4x^2}}$."
        },
        {
          "q": "Differentiate $f(x)=\\ln(\\sin x)$.",
          "answer": "$f'(x)=\\frac{\\cos x}{\\sin x}=\\cot x$."
        },
        {
          "q": "Differentiate $f(x)=\\tan^{-1}(x^2)$.",
          "answer": "$f'(x)=\\frac{2x}{1+(x^2)^2}=\\frac{2x}{1+x^4}$."
        }
      ]
    },
    {
      "heading": "Finding tangent lines using the chain rule",
      "questions": [
        {
          "q": "Find the equation of the tangent line to $f(x)=(2x-1)^3$ at $x=1$.",
          "answer": "$f(1)=1^3=1$. $f'(x)=3(2x-1)^2(2)=6(2x-1)^2$; $f'(1)=6(1)^2=6$. Tangent: $y-1=6(x-1)$, i.e. $y=6x-5$."
        }
      ]
    }
  ]
}
