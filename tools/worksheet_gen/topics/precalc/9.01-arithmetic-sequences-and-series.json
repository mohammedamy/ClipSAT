{
  "track": "precalc",
  "num": "9.01",
  "title": "Arithmetic Sequences and Series",
  "sections": [
    {
      "heading": "Arithmetic sequences",
      "questions": [
        {
          "q": "Consider the sequence $7, 11, 15, 19, \\ldots$",
          "parts": [
            "State the common difference.",
            "Write a formula for the $n$th term.",
            "Find $a_{20}$."
          ],
          "cols": 3,
          "answers": ["$d = 4$", "$a_n = 4n + 3$", "$a_{20} = 83$"]
        },
        {
          "q": "In an arithmetic sequence, $a_3 = 10$ and $a_8 = 25$.",
          "parts": [
            "Find the common difference and the first term.",
            "Write a formula for $a_n$."
          ],
          "cols": 1,
          "answers": [
            "$5d = 15$ gives $d = 3$; $a_1 = 10 - 2(3) = 4$.",
            "$a_n = 4 + 3(n - 1) = 3n + 1$."
          ]
        }
      ]
    },
    {
      "heading": "Arithmetic series",
      "questions": [
        {
          "q": "Find the sum of the first 30 terms of the series $5 + 9 + 13 + \\cdots$",
          "answer": "$a_{30} = 5 + 29(4) = 121$, so $S_{30} = \\frac{30(5 + 121)}{2} = 1890$."
        },
        {
          "q": "Consider the multiples of 6 strictly between 100 and 500.",
          "parts": [
            "How many are there?",
            "Find their sum."
          ],
          "cols": 1,
          "answers": [
            "First 102, last 498: $n = \\frac{498 - 102}{6} + 1 = 67$.",
            "$S = \\frac{67(102 + 498)}{2} = 67 \\times 300 = 20{,}100$."
          ]
        },
        {
          "q": "A theatre has 18 seats in the first row, and each subsequent row has 3 more seats than the row before. How many seats are there in total in 25 rows?",
          "answer": "$a_{25} = 18 + 24(3) = 90$, so $S_{25} = \\frac{25(18 + 90)}{2} = 1350$ seats."
        }
      ]
    }
  ]
}
