          "cols": 4,
          "answers": ["$= 3$", "$= 1$", "$= 10$", "$= 1$"]
        },
        {
          "q": "Consider the function $g(x) = \\sqrt{x + 5}$. Evaluate:",
          "parts": ["$g(4)$", "$g(-1)$", "$g(11)$", "$g(-5)$"],
          "cols": 4,
          "answers": ["$= 3$", "$= 2$", "$= 4$", "$= 0$"]
        },
        {
          "q": "Consider the function $h(x) = \\frac{x - 3}{x + 2}$. Evaluate:",
          "parts": ["$h(0)$", "$h(3)$", "$h(-1)$", "$h(5)$"],
