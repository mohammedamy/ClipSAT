  "title": "Parametric Equations",
  "sections": [
    {
      "heading": "Eliminating the parameter",
      "questions": [
        {
          "q": "Consider the curve $x = 2t + 1$, $y = t^2$.",
          "parts": [
            "Eliminate the parameter to write $y$ as a function of $x$.",
            "Identify the curve."
          ],
          "cols": 1,
          "answers": [
            "$t = \\frac{x - 1}{2}$, so $y = \\frac{(x - 1)^2}{4}$.",
            "A parabola with vertex $(1, 0)$ opening upward."
          ]
        },
        {
          "q": "Eliminate the parameter for $x = 3\\cos t$, $y = 3\\sin t$, $0 \\leq t < 2\\pi$, and describe the curve.",
          "answer": "$x^2 + y^2 = 9\\cos^2 t + 9\\sin^2 t = 9$: a circle of radius 3 centered at the origin, traced counterclockwise."
        },
        {
          "q": "For the line $x = t - 2$, $y = 2t + 3$:",
          "parts": [
            "Find the points corresponding to $t = 0$ and $t = 2$.",
            "Eliminate the parameter to write the Cartesian equation."
          ],
          "cols": 1,
          "answers": [
            "$t = 0$: $(-2, 3)$; $t = 2$: $(0, 7)$.",
            "$t = x + 2$, so $y = 2x + 7$."
          ]
        }
      ]
    },
    {
      "heading": "Projectile motion",
      "questions": [
        {
          "q": "A projectile follows $x = 40t$, $y = -5t^2 + 30t$ (metres, seconds).",
          "parts": [
            "When does the projectile land ($y = 0$, $t > 0$)?",
            "Find the horizontal range.",
            "Find the maximum height."
          ],
          "cols": 1,
          "answers": [
            "$-5t(t - 6) = 0$, so $t = 6$ s.",
            "$x(6) = 240$ m.",
            "Peak at $t = 3$: $y(3) = -45 + 90 = 45$ m."
          ]
        }
      ]
    }
  ]
}
