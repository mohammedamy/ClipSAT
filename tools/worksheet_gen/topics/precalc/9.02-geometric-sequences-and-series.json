        {
          "q": "Consider the sequence $3, 6, 12, 24, \\ldots$",
          "parts": [
            "State the common ratio.",
            "Write a formula for the $n$th term.",
            "Find $a_{10}$."
          ],
          "cols": 3,
          "answers": ["$r = 2$", "$a_n = 3 \\cdot 2^{n-1}$", "$a_{10} = 1536$"]
        },
        {
          "q": "In a geometric sequence, $a_2 = 6$ and $a_5 = 48$. Find the common ratio and the first term.",
          "answer": "$r^3 = \\frac{48}{6} = 8$, so $r = 2$ and $a_1 = 3$."
        }
