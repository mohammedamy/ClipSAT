          ]
        },
        {
          "q": "Determine whether each pair of vectors is orthogonal:",
          "parts": [
            "$\\langle 4, -6 \\rangle$ and $\\langle 3, 2 \\rangle$",
            "$\\langle 1, 2 \\rangle$ and $\\langle 2, 1 \\rangle$"
