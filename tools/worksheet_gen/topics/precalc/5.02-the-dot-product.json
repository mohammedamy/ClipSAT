      "questions": [
        {
          "q": "Let $\\mathbf{u} = \\langle 2, 5 \\rangle$ and $\\mathbf{v} = \\langle -3, 4 \\rangle$. Find:",
          "parts": [
            "$\\mathbf{u} \\cdot \\mathbf{v}$",
            "$|\\mathbf{u}|$ and $|\\mathbf{v}|$",
