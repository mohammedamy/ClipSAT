          "cols": 2,
          "answers": [
            "$12 - 12 = 0$: orthogonal.",
            "$2 + 2 = 4 \\neq 0$: not orthogonal."
          ]
        },
        {
          "q": "Find the value of $k$ so that $\\langle k, 3 \\rangle$ is orthogonal to $\\langle 2, -4 \\rangle$.",
          "answer": "$2k - 12 = 0$, so $k = 6$."
