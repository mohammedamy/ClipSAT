        {
          "q": "Solve $\\log_4(x+5)=2$.",
          "answer": "$4^2=16=x+5$, so $x=11$."
        },
        {
          "q": "Solve $\\log_2(x)+\\log_2(x-2)=3$.",
          "answer": "$\\log_2[x(x-2)]=3$, so $x(x-2)=8$, giving $x^2-2x-8=0$, i.e. $(x-4)(x+2)=0$. So $x=4$ or $x=-2$; but $x=-2$ makes the original logarithms undefined, so the only valid solution is $x=4$."
        }
      ]
