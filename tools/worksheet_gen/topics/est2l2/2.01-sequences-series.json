  "title": "Sequences & Series",
  "sub": null,
  "sections": [
    {
      "heading": "Arithmetic sequences",
      "questions": [
        {
          "q": "For the arithmetic sequence with $a_1=9$ and common difference $d=6$, find $a_{10}$.",
          "answer": "$a_{10}=a_1+(10-1)d=9+9(6)=63$."
        },
        {
          "q": "For the arithmetic sequence with $a_1=15$ and $d=-4$, find $a_{11}$.",
          "answer": "$a_{11}=15+10(-4)=15-40=-25$."
        }
      ]
    },
    {
      "heading": "Arithmetic series",
      "questions": [
        {
          "q": "Find $S_{10}$ for the arithmetic sequence with $a_1=9$, $d=6$ (using $a_{10}=63$ from above).",
          "answer": "$S_{10}=\\dfrac{n(a_1+a_n)}{2}=\\dfrac{10(9+63)}{2}=5(72)=360$."
        }
      ]
    },
    {
      "heading": "Geometric sequences",
      "questions": [
        {
          "q": "For the geometric sequence with $a_1=6$ and common ratio $r=2$, find $a_8$.",
          "answer": "$a_8=a_1r^{7}=6(2^7)=6(128)=768$."
        },
        {
          "q": "A geometric sequence has $a_1=2$ and common ratio $r=5$. Find the smallest $n$ for which $a_n=1250$.",
          "answer": "$a_n=2\\cdot5^{n-1}$. Setting $2\\cdot5^{n-1}=1250$ gives $5^{n-1}=625=5^4$, so $n-1=4$ and $n=5$."
        }
      ]
    },
    {
      "heading": "Geometric series (finite)",
      "questions": [
        {
          "q": "Find $S_8$ for the geometric sequence with $a_1=6$, $r=2$ (using $a_8=768$ from above).",
          "answer": "$S_8=\\dfrac{a_1(r^{8}-1)}{r-1}=\\dfrac{6(256-1)}{1}=6(255)=1530$."
        }
      ]
    },
    {
      "heading": "Infinite geometric series",
      "questions": [
        {
          "q": "Find the sum of the infinite geometric series $36+12+4+\\cdots$.",
          "answer": "$a=36$, $r=\\dfrac{1}{3}$, and $|r|<1$, so the sum is $\\dfrac{36}{1-\\frac{1}{3}}=\\dfrac{36}{\\frac{2}{3}}=54$."
        },
        {
          "q": "Find the sum of the infinite geometric series $12-4+\\dfrac{4}{3}-\\cdots$.",
          "answer": "$a=12$, $r=-\\dfrac{1}{3}$, and $|r|<1$, so the sum is $\\dfrac{12}{1-\\left(-\\frac{1}{3}\\right)}=\\dfrac{12}{\\frac{4}{3}}=9$."
        }
      ]
    }
  ]
}
