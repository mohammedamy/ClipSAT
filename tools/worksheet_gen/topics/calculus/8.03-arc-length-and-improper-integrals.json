{
  "track": "calculus",
  "num": "8.03",
  "title": "Arc Length and Improper Integrals",
  "sections": [
    {
      "heading": "Arc length",
      "questions": [
        {
          "q": "Find the arc length of $y = \\frac{2}{3}x^{3/2}$ from $x=0$ to $x=3$.",
          "answer": "$y' = x^{1/2}$, so $L = \\int_0^3 \\sqrt{1+x}\\,dx = \\left[\\frac{2}{3}(1+x)^{3/2}\\right]_0^3 = \\frac{2}{3}(8-1) = \\frac{14}{3}$."
        },
        {
          "q": "Set up (do not evaluate) the arc length integral for $y = \\sin x$ on $[0, \\pi]$.",
          "answer": "$L = \\int_0^\\pi \\sqrt{1 + \\cos^2 x}\\,dx$."
        }
      ]
    },
    {
      "heading": "Improper integrals",
      "questions": [
        {
          "q": "Evaluate $\\int_1^\\infty \\frac{1}{x^2}\\,dx$, or state that it diverges.",
          "answer": "$\\lim_{b\\to\\infty}\\left[-\\frac{1}{x}\\right]_1^b = \\lim_{b\\to\\infty}\\left(1 - \\frac{1}{b}\\right) = 1$: converges to $1$."
        },
        {
          "q": "Evaluate $\\int_1^\\infty \\frac{1}{x}\\,dx$, or state that it diverges.",
          "answer": "$\\lim_{b\\to\\infty}\\left[\\ln x\\right]_1^b = \\lim_{b\\to\\infty}\\ln b = \\infty$: diverges."
        },
        {
          "q": "Evaluate $\\int_0^1 \\frac{1}{\\sqrt{x}}\\,dx$ (improper at the lower limit).",
          "answer": "$\\lim_{a\\to 0^+}\\left[2\\sqrt{x}\\right]_a^1 = 2 - 0 = 2$: converges to $2$."
        }
      ]
    }
  ]
}
