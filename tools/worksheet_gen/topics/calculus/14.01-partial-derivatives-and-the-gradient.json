      "questions": [
        {
          "q": "For $f(x,y) = x^3y^2 - 4xy + y$, find:",
          "parts": ["$f_x$", "$f_y$", "$f_{xx}$", "$f_{xy}$"],
          "cols": 2,
          "answers": ["$= 3x^2y^2 - 4y$", "$= 2x^3y - 4x + 1$", "$= 6xy^2$", "$= 6x^2y - 4$"]
        },
        {
          "q": "For $f(x,y) = e^{xy}\\sin(x+y)$, find $f_x$ using the product rule.",
          "answer": "$f_x = ye^{xy}\\sin(x+y) + e^{xy}\\cos(x+y)$."
        }
      ]
