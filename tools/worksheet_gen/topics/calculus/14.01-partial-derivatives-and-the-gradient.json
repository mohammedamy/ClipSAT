    {
      "heading": "The gradient and directional derivatives",
      "questions": [
        {
          "q": "Find the gradient $\\nabla f$ of $f(x,y) = x^2y + 3y^3$ at the point $(1, 2)$.",
          "answer": "$\\nabla f = \\langle 2xy, x^2 + 9y^2 \\rangle$. At $(1,2)$: $\\nabla f(1,2) = \\langle 4, 37 \\rangle$."
        },
        {
          "q": "Find the directional derivative of $f(x,y) = x^2 + y^2$ at $(1, 1)$ in the direction of $\\mathbf{v} = \\langle 3, 4 \\rangle$.",
          "answer": "$\\nabla f = \\langle 2x, 2y \\rangle$, so $\\nabla f(1,1) = \\langle 2, 2 \\rangle$. Unit vector: $\\hat{\\mathbf{v}} = \\langle \\frac{3}{5}, \\frac{4}{5} \\rangle$. $D_{\\mathbf{v}}f = \\langle 2,2\\rangle\\cdot\\langle\\frac{3}{5},\\frac{4}{5}\\rangle = \\frac{6}{5}+\\frac{8}{5} = \\frac{14}{5}$."
        }
      ]
