      "heading": "Power, sum, and constant rules",
      "questions": [
        {
          "q": "Differentiate each function:",
          "parts": ["$f(x) = 5x^4 - 3x^2 + 7$", "$f(x) = \\frac{1}{x^3}$", "$f(x) = 4\\sqrt{x}$"],
          "cols": 3,
          "answers": ["$= 20x^3 - 6x$", "$= -3x^{-4}$", "$= \\frac{2}{\\sqrt{x}}$"]
        }
      ]
    },
    {
      "heading": "Product and quotient rules",
      "questions": [
        {
          "q": "Differentiate $f(x) = (2x + 1)(x^2 - 3)$ using the product rule.",
          "answer": "$f'(x) = 2(x^2 - 3) + (2x+1)(2x) = 2x^2 - 6 + 4x^2 + 2x = 6x^2 + 2x - 6$."
        },
        {
          "q": "Differentiate $f(x) = \\frac{x^2 + 1}{x - 2}$ using the quotient rule.",
          "answer": "$f'(x) = \\frac{2x(x-2) - (x^2+1)(1)}{(x-2)^2} = \\frac{x^2 - 4x - 1}{(x-2)^2}$."
        },
        {
          "q": "Differentiate $f(x) = x^2\\sin x$.",
          "answer": "$f'(x) = 2x\\sin x + x^2\\cos x$."
        }
      ]
    },
    {
      "heading": "The chain rule",
      "questions": [
        {
          "q": "Differentiate each function using the chain rule:",
          "parts": ["$f(x) = (3x^2 - 5)^4$", "$f(x) = \\sin(2x^3)$", "$f(x) = e^{-x^2}$", "$f(x) = \\ln(x^2 + 1)$"],
          "cols": 2,
          "answers": [
            "$= 4(3x^2-5)^3(6x) = 24x(3x^2-5)^3$",
            "$= 6x^2\\cos(2x^3)$",
            "$= -2xe^{-x^2}$",
            "$= \\frac{2x}{x^2+1}$"
          ]
        },
        {
          "q": "Differentiate $f(x) = \\sqrt{4x + \\cos x}$.",
          "answer": "$f'(x) = \\frac{4 - \\sin x}{2\\sqrt{4x + \\cos x}}$."
        }
      ]
    },
    {
      "heading": "Combined rules",
      "questions": [
        {
          "q": "Differentiate $f(x) = \\frac{\\sin x}{x^2}$ using the quotient rule.",
          "answer": "$f'(x) = \\frac{x^2\\cos x - \\sin x(2x)}{x^4} = \\frac{x\\cos x - 2\\sin x}{x^3}$."
        },
        {
          "q": "Differentiate $f(x) = e^{2x}\\cos(3x)$ using the product and chain rules together.",
          "answer": "$f'(x) = 2e^{2x}\\cos(3x) + e^{2x}(-3\\sin3x) = e^{2x}\\left(2\\cos3x-3\\sin3x\\right)$."
        },
        {
          "q": "Differentiate $f(x) = \\left(\\frac{x+1}{x-1}\\right)^3$ using the chain rule together with the quotient rule.",
          "answer": "Let $u=\\frac{x+1}{x-1}$; $\\frac{du}{dx}=\\frac{(x-1)-(x+1)}{(x-1)^2}=\\frac{-2}{(x-1)^2}$. So $f'(x) = 3u^2\\cdot\\frac{du}{dx} = 3\\left(\\frac{x+1}{x-1}\\right)^2\\cdot\\frac{-2}{(x-1)^2} = \\frac{-6(x+1)^2}{(x-1)^4}$."
        }
      ]
    },
