  "title": "Integration by Substitution",
  "sections": [
    {
      "heading": "u-substitution",
      "questions": [
        {
          "q": "Evaluate each integral using substitution:",
          "parts": [
            "$\\int 2x(x^2+1)^5\\,dx$",
            "$\\int \\frac{x}{\\sqrt{x^2+9}}\\,dx$",
            "$\\int \\cos(3x)\\,dx$"
          ],
          "cols": 1,
          "answers": [
            "$u = x^2+1$: $= \\frac{(x^2+1)^6}{6} + C$.",
            "$u = x^2+9$: $= \\sqrt{x^2+9} + C$.",
            "$u = 3x$: $= \\frac{1}{3}\\sin(3x) + C$."
          ]
        },
        {
          "q": "Evaluate $\\int x^2 e^{x^3}\\,dx$.",
          "answer": "$u = x^3$, $du = 3x^2\\,dx$: $= \\frac{1}{3}e^{x^3} + C$."
        }
      ]
    },
    {
      "heading": "Definite integrals with substitution",
      "questions": [
        {
          "q": "Evaluate $\\int_0^2 x\\sqrt{x^2+1}\\,dx$ exactly, changing the limits with $u = x^2+1$.",
          "answer": "$u$ goes from $1$ to $5$: $\\frac{1}{2}\\int_1^5 \\sqrt{u}\\,du = \\frac{1}{2}\\left[\\frac{2}{3}u^{3/2}\\right]_1^5 = \\frac{1}{3}(5\\sqrt{5} - 1)$."
        },
        {
          "q": "Evaluate $\\int_0^{\\pi/2} \\sin^3 x\\cos x\\,dx$.",
          "answer": "$u = \\sin x$, limits $0$ to $1$: $\\int_0^1 u^3\\,du = \\frac{1}{4}$."
        },
        {
          "q": "Evaluate $\\int_1^e \\frac{\\ln x}{x}\\,dx$.",
          "answer": "$u = \\ln x$, limits $0$ to $1$: $\\int_0^1 u\\,du = \\frac{1}{2}$."
        }
      ]
    },
    {
      "heading": "Substitution with trigonometric and exponential integrands",
      "questions": [
        {
          "q": "Evaluate each integral using substitution:",
          "parts": [
            "$\\int \\sin^4x\\cos x\\,dx$",
            "$\\int \\frac{e^x}{1+e^x}\\,dx$",
            "$\\int \\sec^2x\\,\\tan x\\,dx$"
          ],
          "cols": 1,
          "answers": [
            "$u=\\sin x$: $=\\frac{\\sin^5x}{5}+C$.",
            "$u=1+e^x$: $=\\ln|1+e^x|+C$.",
            "$u=\\tan x$: $=\\frac{\\tan^2x}{2}+C$."
          ]
        },
        {
          "q": "Evaluate $\\int \\frac{2x+3}{x^2+3x+1}\\,dx$, recognizing the numerator as the derivative of the denominator.",
          "answer": "$u=x^2+3x+1$, $du=(2x+3)\\,dx$: $=\\ln|x^2+3x+1|+C$."
        }
      ]
    },
    {
      "heading": "Choosing the substitution",
      "questions": [
        {
          "q": "For each integral, state a suitable substitution $u$ and evaluate:",
          "parts": [
            "$\\int x^2(x^3-1)^7\\,dx$",
            "$\\int \\tan x\\,dx = \\int \\frac{\\sin x}{\\cos x}\\,dx$"
          ],
          "cols": 1,
          "answers": [
            "$u=x^3-1$, $du=3x^2dx$: $=\\frac{1}{3}\\int u^7\\,du = \\frac{(x^3-1)^8}{24}+C$.",
            "$u=\\cos x$, $du=-\\sin x\\,dx$: $=-\\ln|\\cos x|+C = \\ln|\\sec x|+C$."
          ]
        }
      ]
    },
    {
      "heading": "Substitution with radicals",
      "questions": [
        {
          "q": "Evaluate $\\int x\\sqrt{2-x}\\,dx$ using the substitution $u=2-x$ (so $x=2-u$).",
          "answer": "$u=2-x$, $x=2-u$, $dx=-du$: $\\int(2-u)\\sqrt{u}(-du) = \\int(u-2)\\sqrt{u}\\,du = \\int\\left(u^{3/2}-2u^{1/2}\\right)du = \\frac{2}{5}u^{5/2}-\\frac{4}{3}u^{3/2}+C = \\frac{2}{5}(2-x)^{5/2}-\\frac{4}{3}(2-x)^{3/2}+C$."
        },
        {
          "q": "Evaluate $\\int_0^3 \\frac{x}{\\sqrt{x+1}}\\,dx$ using $u=x+1$ (so $x=u-1$), changing the limits.",
          "answer": "$u$ goes from $1$ to $4$: $\\int_1^4 \\frac{u-1}{\\sqrt{u}}\\,du = \\int_1^4\\left(u^{1/2}-u^{-1/2}\\right)du = \\left[\\frac{2}{3}u^{3/2}-2u^{1/2}\\right]_1^4 = \\left(\\frac{16}{3}-4\\right)-\\left(\\frac{2}{3}-2\\right) = \\frac{4}{3}+\\frac{4}{3}=\\frac{8}{3}$."
        }
      ]
    }
  ]
