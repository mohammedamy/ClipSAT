  "track": "calculus",
  "num": "15.01",
  "title": "Double Integrals",
  "sections": [
    {
      "heading": "Iterated integrals over rectangles",
      "questions": [
        {
          "q": "Evaluate $\\int_0^2\\int_0^3 (x^2 + y)\\,dy\\,dx$.",
          "answer": "Inner: $\\int_0^3 (x^2+y)\\,dy = 3x^2 + \\frac{9}{2}$. Outer: $\\int_0^2\\left(3x^2+\\frac{9}{2}\\right)dx = \\left[x^3+\\frac{9}{2}x\\right]_0^2 = 8+9=17$."
        },
        {
          "q": "Evaluate $\\int_1^2\\int_0^1 6xy^2\\,dx\\,dy$.",
          "answer": "Inner: $\\int_0^1 6xy^2\\,dx = 3y^2$. Outer: $\\int_1^2 3y^2\\,dy = \\left[y^3\\right]_1^2 = 8-1=7$."
        }
      ]
    },
    {
      "heading": "Double integrals over general regions",
      "questions": [
        {
          "q": "Evaluate $\\int_0^1\\int_0^{x} (x+y)\\,dy\\,dx$, integrating over the triangular region $0 \\leq y \\leq x \\leq 1$.",
          "answer": "Inner: $\\int_0^x (x+y)\\,dy = x^2 + \\frac{x^2}{2} = \\frac{3x^2}{2}$. Outer: $\\int_0^1 \\frac{3x^2}{2}\\,dx = \\left[\\frac{x^3}{2}\\right]_0^1 = \\frac{1}{2}$."
        },
        {
          "q": "Use a double integral to find the volume under $f(x,y) = 4 - x - y$ over the rectangle $0 \\leq x \\leq 1$, $0 \\leq y \\leq 1$.",
          "answer": "$\\int_0^1\\int_0^1 (4-x-y)\\,dy\\,dx$: inner $= 4 - x - \\frac{1}{2}$. Outer: $\\int_0^1\\left(\\frac{7}{2}-x\\right)dx = \\frac{7}{2}-\\frac{1}{2}=3$."
        }
      ]
    }
  ]
}
