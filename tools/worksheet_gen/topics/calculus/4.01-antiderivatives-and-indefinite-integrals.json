    {
      "heading": "Antiderivatives requiring algebraic rewriting first",
      "questions": [
        {
          "q": "Find $\\int\\frac{x^3+2x}{x}\\,dx$ by simplifying the integrand before integrating.",
          "answer": "$\\frac{x^3+2x}{x}=x^2+2$, so $\\int(x^2+2)\\,dx=\\frac{x^3}{3}+2x+C$."
        },
        {
          "q": "Find $\\int(x+1)(x-3)\\,dx$ by expanding the product first.",
          "answer": "$(x+1)(x-3)=x^2-2x-3$, so $\\int(x^2-2x-3)\\,dx=\\frac{x^3}{3}-x^2-3x+C$."
