        {
          "q": "Find each indefinite integral:",
          "parts": ["$\\int (3x^2 - 4x + 5)\\,dx$", "$\\int \\frac{1}{x^2}\\,dx$", "$\\int \\sqrt{x}\\,dx$", "$\\int \\sec^2 x\\,dx$"],
          "cols": 2,
          "answers": [
            "$= x^3 - 2x^2 + 5x + C$",
            "$= -\\frac{1}{x} + C$",
            "$= \\frac{2}{3}x^{3/2} + C$",
            "$= \\tan x + C$"
          ]
        },
        {
          "q": "Find $\\int (4\\sin x + e^x)\\,dx$.",
          "answer": "$= -4\\cos x + e^x + C$."
        }
      ]
