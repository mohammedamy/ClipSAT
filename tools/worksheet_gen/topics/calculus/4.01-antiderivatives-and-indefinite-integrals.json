    {
      "heading": "Using initial conditions",
      "questions": [
        {
          "q": "Find $f(x)$ given that $f'(x) = 6x^2 - 2$ and $f(1) = 5$.",
          "answer": "$f(x) = 2x^3 - 2x + C$. Using $f(1) = 5$: $2 - 2 + C = 5$, so $C = 5$: $f(x) = 2x^3 - 2x + 5$."
        },
        {
          "q": "A particle moves along a line with velocity $v(t) = 3t^2 - 6t$ m/s. If its position at $t = 0$ is $s(0) = 4$ m, find its position function $s(t)$.",
          "answer": "$s(t) = \\int v(t)\\,dt = t^3 - 3t^2 + C$. Using $s(0) = 4$: $C = 4$: $s(t) = t^3 - 3t^2 + 4$."
        },
        {
          "q": "An object is dropped from rest, so its acceleration is $a(t) = -9.8$ m/s$^2$.",
          "parts": [
            "Find the velocity function $v(t)$.",
            "If the object starts at height $s(0) = 45$ m, find its position function $s(t)$.",
            "Find how long it takes to hit the ground ($s = 0$), to two decimal places."
          ],
          "cols": 1,
          "answers": [
            "$v(t) = -9.8t$ m/s (using $v(0) = 0$).",
            "$s(t) = -4.9t^2 + 45$.",
            "$-4.9t^2 + 45 = 0$ gives $t = \\sqrt{45/4.9} \\approx 3.03$ s."
          ]
        }
      ]
    },
    {
      "heading": "More antiderivatives",
      "questions": [
        {
          "q": "Find each indefinite integral:",
          "parts": ["$\\int \\left(\\frac{1}{x} - 3x^{-4}\\right)dx$", "$\\int (2\\sec x\\tan x)\\,dx$", "$\\int \\frac{4}{\\sqrt{1-x^2}}\\,dx$"],
          "cols": 1,
          "answers": [
            "$= \\ln|x| + x^{-3} + C$",
            "$= 2\\sec x + C$",
            "$= 4\\sin^{-1}x + C$"
          ]
        },
        {
          "q": "Find the general antiderivative of $f(x) = (x+1)^3$ (expand first, or use the power rule on the whole expression, and state which method you used).",
          "answer": "Treating $(x+1)$ as a single unit (power rule for a linear inner function): $\\int(x+1)^3\\,dx = \\frac{(x+1)^4}{4}+C$."
        }
      ]
    },
    {
      "heading": "Motion applications",
      "questions": [
        {
          "q": "A rocket's acceleration is $a(t) = 6t$ m/s$^2$, with $v(0)=0$ and $s(0)=0$.",
          "parts": [
            "Find $v(t)$.",
            "Find $s(t)$.",
            "Find the distance traveled in the first 4 seconds."
          ],
          "cols": 1,
          "answers": [
            "$v(t)=3t^2$.",
            "$s(t)=t^3$.",
            "$s(4)=64$ m."
          ]
        }
      ]
    },
    {
      "heading": "Antiderivatives of composite expressions",
      "questions": [
        {
          "q": "Find $\\int(2x-1)^5\\,dx$, treating $(2x-1)$ as a linear inner function.",
          "answer": "$\\int(2x-1)^5\\,dx=\\frac{(2x-1)^6}{6\\cdot2}+C=\\frac{(2x-1)^6}{12}+C$ (dividing by the derivative of the inner function, $2$)."
        },
        {
          "q": "Find $\\int\\sin(3x)\\,dx$ and $\\int e^{5x}\\,dx$.",
          "answer": "$\\int\\sin(3x)\\,dx=-\\frac{1}{3}\\cos(3x)+C$. $\\int e^{5x}\\,dx=\\frac{1}{5}e^{5x}+C$."
        }
      ]
    },
    {
      "heading": "Verifying antiderivatives by differentiation",
      "questions": [
        {
          "q": "Verify that $F(x)=x\\ln x-x$ is an antiderivative of $f(x)=\\ln x$ by differentiating $F(x)$.",
          "answer": "$F'(x)=\\ln x+x\\cdot\\frac{1}{x}-1=\\ln x+1-1=\\ln x=f(x)$ ✓."
        }
      ]
    },
