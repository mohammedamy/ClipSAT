      "heading": "Average value and applications",
      "questions": [
        {
          "q": "Find the average value of $f(x) = x^2$ on $[0, 3]$.",
          "answer": "$\\frac{1}{3}\\int_0^3 x^2\\,dx = \\frac{1}{3}\\cdot 9 = 3$."
        },
        {
          "q": "A car's velocity is $v(t) = 3t^2 + 2$ m/s for $0 \\leq t \\leq 4$. Find the total distance traveled, and the average velocity over this interval.",
          "answer": "Distance $= \\int_0^4 (3t^2+2)\\,dt = \\left[t^3+2t\\right]_0^4 = 64+8 = 72$ m. Average velocity $= \\frac{72}{4} = 18$ m/s."
        }
      ]
