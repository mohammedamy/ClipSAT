    {
      "heading": "Further FTC practice",
      "questions": [
        {
          "q": "Evaluate $\\int_0^2 (x^3 - 2x + 3)\\,dx$.",
          "answer": "$\\left[\\frac{x^4}{4}-x^2+3x\\right]_0^2 = (4-4+6)-0=6$."
        },
        {
          "q": "Find $\\frac{d}{dx}\\int_x^5 \\cos(t^2)\\,dt$, using the property $\\int_a^b = -\\int_b^a$ before applying FTC Part 1.",
          "answer": "$\\int_x^5 \\cos(t^2)\\,dt = -\\int_5^x \\cos(t^2)\\,dt$, so the derivative is $-\\cos(x^2)$."
        },
        {
          "q": "Find the average value of $f(x)=\\sin x$ on $[0,\\pi]$, to three decimal places.",
          "answer": "$\\frac{1}{\\pi}\\int_0^\\pi \\sin x\\,dx = \\frac{1}{\\pi}\\left[-\\cos x\\right]_0^\\pi = \\frac{2}{\\pi} \\approx 0.637$."
        }
      ]
    },
