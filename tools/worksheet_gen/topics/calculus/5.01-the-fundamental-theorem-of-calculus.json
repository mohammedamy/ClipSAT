      "heading": "Mean Value Theorem for integrals",
      "questions": [
        {
          "q": "Find the value(s) of $c$ guaranteed by the Mean Value Theorem for Integrals for $f(x)=x^2$ on $[0,3]$ (where $f(c)$ equals the average value of $f$).",
          "answer": "Average value $=\\frac{1}{3}\\int_0^3x^2\\,dx=3$ (found earlier). Solve $c^2=3$: $c=\\sqrt{3}$ (taking the positive root within $[0,3]$)."
        },
        {
          "q": "Evaluate $\\int_2^5 f(x)\\,dx$ given that the average value of $f$ on $[2,5]$ is $7$.",
          "answer": "Average value $=\\frac{1}{5-2}\\int_2^5 f(x)\\,dx = 7$, so $\\int_2^5 f(x)\\,dx = 7(3)=21$."
        }
