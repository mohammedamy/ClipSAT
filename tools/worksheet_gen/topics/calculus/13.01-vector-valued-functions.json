        {
          "q": "Let $\\mathbf{a} = \\langle 2, -1, 3 \\rangle$ and $\\mathbf{b} = \\langle 1, 4, -2 \\rangle$. Find:",
          "parts": ["$\\mathbf{a} + \\mathbf{b}$", "$\\mathbf{a} \\cdot \\mathbf{b}$", "$|\\mathbf{a}|$"],
          "cols": 3,
          "answers": ["$= \\langle 3, 3, 1 \\rangle$", "$= 2 - 4 - 6 = -8$", "$= \\sqrt{14}$"]
        },
        {
          "q": "Find the cross product $\\mathbf{a} \\times \\mathbf{b}$ for $\\mathbf{a} = \\langle 1, 0, 2 \\rangle$ and $\\mathbf{b} = \\langle 3, 1, -1 \\rangle$.",
          "answer": "$\\mathbf{a}\\times\\mathbf{b} = \\langle (0)(-1)-(2)(1),\\ (2)(3)-(1)(-1),\\ (1)(1)-(0)(3) \\rangle = \\langle -2, 7, 1 \\rangle$."
