    {
      "heading": "Log laws: product and quotient",
      "questions": [
        { "q": "Write $\\log_2(8x)$ as a sum of logarithms.", "answer": "$\\log_2(8x)=\\log_2 8+\\log_2 x=3+\\log_2 x$." },
        { "q": "Write $\\log_3\\left(\\dfrac{x}{9}\\right)$ as a difference of logarithms.", "answer": "$\\log_3\\left(\\dfrac{x}{9}\\right)=\\log_3 x-\\log_3 9=\\log_3 x-2$." },
        { "q": "Combine $\\log_5 5+\\log_5 25$ into a single logarithm and evaluate.", "answer": "$\\log_5(5\\times25)=\\log_5 125=3$ (since $5^3=125$)." },
        { "q": "Combine $\\log_2 24-\\log_2 3$ into a single logarithm and evaluate.", "answer": "$\\log_2\\left(\\dfrac{24}{3}\\right)=\\log_2 8=3$." }
      ]
    },
    {
      "heading": "Log laws: the power rule",
      "questions": [
        { "q": "Write $\\log(x^5)$ using the power rule.", "answer": "$\\log(x^5)=5\\log x$." },
        { "q": "Evaluate $\\log_2(4^3)$ using the power rule.", "answer": "$\\log_2(4^3)=3\\log_2 4=3(2)=6$." },
        { "q": "Write $2\\log_3 x+\\log_3 y$ as a single logarithm.", "answer": "$2\\log_3 x+\\log_3 y=\\log_3(x^2y)$." }
      ]
    },
