    {
      "heading": "The Taylor series formula",
      "questions": [
        {
          "q": "State the general Taylor series formula for $f(x)$ centered at $x=a$.",
          "answer": "$f(x)=\\sum_{n=0}^{\\infty}\\frac{f^{(n)}(a)}{n!}(x-a)^n=f(a)+f'(a)(x-a)+\\frac{f''(a)}{2!}(x-a)^2+\\cdots$."
        },
        {
          "q": "Find the Taylor series for $f(x)=\\ln x$ centered at $a=1$, up through the $(x-1)^3$ term.",
          "answer": "$f(1)=0$; $f'(x)=\\frac{1}{x}$, $f'(1)=1$; $f''(x)=-\\frac{1}{x^2}$, $f''(1)=-1$; $f'''(x)=\\frac{2}{x^3}$, $f'''(1)=2$. Series: $0+(x-1)-\\frac{1}{2}(x-1)^2+\\frac{2}{6}(x-1)^3=(x-1)-\\frac{(x-1)^2}{2}+\\frac{(x-1)^3}{3}$."
        }
      ]
    },
    {
      "heading": "Common Maclaurin series",
      "questions": [
        {
          "q": "State the Maclaurin series for $e^x$, $\\sin x$, and $\\cos x$.",
          "answer": "$e^x=\\sum_{n=0}^{\\infty}\\frac{x^n}{n!}=1+x+\\frac{x^2}{2!}+\\frac{x^3}{3!}+\\cdots$. $\\sin x=\\sum_{n=0}^{\\infty}\\frac{(-1)^nx^{2n+1}}{(2n+1)!}=x-\\frac{x^3}{3!}+\\frac{x^5}{5!}-\\cdots$. $\\cos x=\\sum_{n=0}^{\\infty}\\frac{(-1)^nx^{2n}}{(2n)!}=1-\\frac{x^2}{2!}+\\frac{x^4}{4!}-\\cdots$."
        },
        {
          "q": "Use the Maclaurin series for $e^x$ to find the Maclaurin series for $e^{-x^2}$.",
          "answer": "Substitute $x\\to-x^2$: $e^{-x^2}=\\sum_{n=0}^{\\infty}\\frac{(-x^2)^n}{n!}=\\sum_{n=0}^{\\infty}\\frac{(-1)^nx^{2n}}{n!}=1-x^2+\\frac{x^4}{2}-\\cdots$."
        }
      ]
    },
