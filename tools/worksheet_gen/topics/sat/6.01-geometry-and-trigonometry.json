    {
      "heading": "Similar triangles and proportional reasoning",
      "questions": [
        {
          "q": "Triangle $ABC$ is similar to triangle $DEF$, with $AB=6$, $DE=9$, and $BC=8$. Find $EF$.",
          "answer": "The scale factor is $\\dfrac{DE}{AB}=\\dfrac{9}{6}=1.5$. So $EF=1.5\\times BC=1.5\\times8=12$."
        },
        {
          "q": "A tree casts a shadow 20 feet long, while a 6-foot person standing nearby casts a shadow 4 feet long. Find the height of the tree using similar triangles.",
          "answer": "Set up a proportion: $\\dfrac{\\text{tree height}}{20}=\\dfrac{6}{4}$. So tree height $=\\dfrac{6}{4}\\times20=30$ feet."
        }
      ]
    },
