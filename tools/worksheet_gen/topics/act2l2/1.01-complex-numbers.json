  "sections": [
    {
      "heading": "Powers of $i$",
      "questions": [
        {
          "q": "Evaluate each power of $i$, using $i^2=-1$ and the fact that powers of $i$ repeat every $4$:",
          "parts": ["$i^3$", "$i^4$", "$i^7$", "$i^{22}$"],
          "cols": 4,
          "answers": ["$= -i$", "$= 1$", "$= -i$", "$= -1$"]
        },
        {
          "q": "Evaluate $i^{101}$.",
          "answer": "$101 = 4(25)+1$, so $i^{101}=(i^4)^{25}\\cdot i^1 = 1\\cdot i = i$."
        }
      ]
    },
    {
      "heading": "Addition and subtraction",
      "questions": [
        {
          "q": "Let $z_1=3+4i$ and $z_2=-2+5i$. Find $z_1+z_2$.",
          "answer": "$= 1+9i$"
        },
        {
          "q": "Let $z_1=2-3i$ and $z_2=-1-4i$. Find $z_1+z_2$.",
          "answer": "$= 1-7i$"
        },
        {
          "q": "Find $(7+2i)-(3-5i)$.",
          "answer": "$= 4+7i$"
        },
        {
          "q": "Find $(4-i)-(-2+6i)$.",
          "answer": "$= 6-7i$"
        }
      ]
    },
    {
      "heading": "Multiplication",
      "questions": [
        {
          "q": "Multiply $(2+3i)(1-4i)$.",
          "answer": "$(2)(1)-(3)(-4) + \\left[(2)(-4)+(3)(1)\\right]i = 14 - 5i$"
        },
        {
          "q": "Multiply $(-1+2i)(3+i)$.",
          "answer": "$(-1)(3)-(2)(1) + \\left[(-1)(1)+(2)(3)\\right]i = -5+5i$"
        },
        {
          "q": "Multiply $(5-2i)(5+2i)$, and explain why the result has no imaginary part.",
          "answer": "$= 25-(-4) + 0i = 29$. It is a product of conjugates $z\\bar z=|z|^2$ (Theorem 1.1), which is always real."
        }
      ]
    },
    {
      "heading": "Conjugate and modulus",
      "questions": [
        {
          "q": "For $z=6-8i$, find $\\bar z$ and $|z|$.",
          "answer": "$\\bar z = 6+8i$, and $|z|=\\sqrt{6^2+8^2}=\\sqrt{100}=10$."
        },
        {
          "q": "For $z=-5+12i$, find $\\bar z$ and $|z|$.",
          "answer": "$\\bar z = -5-12i$, and $|z|=\\sqrt{5^2+12^2}=\\sqrt{169}=13$."
        },
        {
          "q": "Show that $z+\\bar z$ is always real for $z=a+bi$.",
          "answer": "$z+\\bar z = (a+bi)+(a-bi) = 2a$, which is real since $a$ is real."
        }
      ]
    },
    {
      "heading": "Division",
      "questions": [
        {
          "q": "Simplify $\\dfrac{3+4i}{1-2i}$ by multiplying top and bottom by the conjugate of the denominator.",
          "answer": "Multiply by $\\frac{1+2i}{1+2i}$: numerator $= (3)(1)-(4)(2)+[(3)(2)+(4)(1)]i = -5+10i$; denominator $=1^2+2^2=5$. So the quotient is $-1+2i$."
        },
        {
          "q": "Simplify $\\dfrac{1+i}{1-i}$.",
          "answer": "Multiply by $\\frac{1+i}{1+i}$: numerator $=(1)(1)-(1)(1)+[(1)(1)+(1)(1)]i = 0+2i$; denominator $=1^2+1^2=2$. So the quotient is $i$."
        },
        {
          "q": "Simplify $\\dfrac{7-i}{3+2i}$.",
          "answer": "Multiply by $\\frac{3-2i}{3-2i}$: numerator $=(7)(3)-(-1)(-2)+[(7)(-2)+(-1)(3)]i = 19-17i$; denominator $=3^2+2^2=13$. So the quotient is $\\frac{19}{13}-\\frac{17}{13}i$."
        }
      ]
    },
    {
      "heading": "Quadratic equations with complex roots",
      "questions": [
        {
          "q": "Solve $x^2+9=0$.",
          "answer": "$x^2=-9 \\Rightarrow x=\\pm3i$."
        },
        {
          "q": "Solve $x^2-6x+13=0$ using the quadratic formula.",
          "answer": "Discriminant $=36-52=-16$, so $\\sqrt{-16}=4i$. $x=\\dfrac{6\\pm4i}{2}=3\\pm2i$."
        },
        {
          "q": "Solve $2x^2+2x+5=0$ using the quadratic formula.",
          "answer": "Discriminant $=4-40=-36$, so $\\sqrt{-36}=6i$. $x=\\dfrac{-2\\pm6i}{4}=-\\dfrac{1}{2}\\pm\\dfrac{3}{2}i$."
        }
      ]
    }
  ]
}
