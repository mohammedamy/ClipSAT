    {
      "heading": "Arithmetic sequences",
      "questions": [
        {
          "q": "For the arithmetic sequence with $a_1=6$ and common difference $d=4$, find $a_{12}$.",
          "answer": "$a_{12}=a_1+(12-1)d=6+11(4)=50$."
        },
        {
          "q": "For the arithmetic sequence with $a_1=20$ and $d=-3$, find $a_{15}$.",
          "answer": "$a_{15}=20+14(-3)=20-42=-22$."
        },
        {
          "q": "A geometric sequence has $a_1=3$ and each term is $2$ times the previous one. Find the smallest $n$ for which $a_n=384$.",
          "answer": "$a_n=3\\cdot2^{n-1}$. Setting $3\\cdot2^{n-1}=384$ gives $2^{n-1}=128=2^7$, so $n-1=7$ and $n=8$."
        }
      ]
    },
    {
      "heading": "Arithmetic series (sum formula)",
      "questions": [
        {
          "q": "Find $S_{12}$ for the arithmetic sequence with $a_1=6$, $d=4$ (using $a_{12}=50$ from above).",
          "answer": "$S_{12}=\\dfrac{n(a_1+a_n)}{2}=\\dfrac{12(6+50)}{2}=6(56)=336$."
        },
        {
          "q": "Find $S_8$ for the arithmetic sequence with $a_1=2$, $d=5$.",
          "answer": "$a_8=2+7(5)=37$. $S_8=\\dfrac{8(2+37)}{2}=4(39)=156$."
        }
      ]
    },
    {
      "heading": "Geometric sequences",
      "questions": [
        {
          "q": "For the geometric sequence with $a_1=4$ and common ratio $r=3$, find $a_6$.",
          "answer": "$a_6=a_1r^{5}=4(3^5)=4(243)=972$."
        },
        {
          "q": "A geometric sequence begins $5, -10, 20, -40,\\ldots$. Find $r$ and $a_7$.",
          "answer": "$r=\\dfrac{-10}{5}=-2$. $a_7=5(-2)^6=5(64)=320$."
        }
      ]
    },
    {
      "heading": "Geometric series (finite)",
      "questions": [
        {
          "q": "Find $S_6$ for the geometric sequence with $a_1=4$, $r=3$ (using $a_6=972$ from above).",
          "answer": "$S_6=\\dfrac{a_1(r^{6}-1)}{r-1}=\\dfrac{4(729-1)}{2}=\\dfrac{4(728)}{2}=1456$."
        },
        {
          "q": "Find $S_5$ for the geometric sequence $5,-10,20,-40,\\ldots$.",
          "answer": "$S_5=\\dfrac{5\\left[(-2)^5-1\\right]}{-2-1}=\\dfrac{5(-32-1)}{-3}=\\dfrac{5(-33)}{-3}=55$."
        }
      ]
    },
    {
      "heading": "Infinite geometric series",
      "questions": [
        {
          "q": "Find the sum of the infinite geometric series $20+\\dfrac{20}{3}+\\dfrac{20}{9}+\\cdots$.",
          "answer": "$a=20$, $r=\\dfrac{1}{3}$, and $|r|<1$, so by Theorem 3.2 the sum is $\\dfrac{20}{1-\\frac{1}{3}}=\\dfrac{20}{\\frac{2}{3}}=30$."
        },
        {
          "q": "Find the sum of the infinite geometric series $9-3+1-\\dfrac{1}{3}+\\cdots$.",
          "answer": "$a=9$, $r=-\\dfrac{1}{3}$, and $|r|<1$, so the sum is $\\dfrac{9}{1-\\left(-\\frac{1}{3}\\right)}=\\dfrac{9}{\\frac{4}{3}}=\\dfrac{27}{4}$."
        },
        {
          "q": "Explain why the infinite geometric series with $a=5$, $r=2$ has no finite sum.",
          "answer": "Theorem 3.2 requires $|r|<1$ for the partial sums to converge. Here $|r|=2>1$, so the terms grow without bound and the series diverges \u2014 it has no finite sum."
        }
      ]
    },
