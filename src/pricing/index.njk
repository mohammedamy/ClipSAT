<script>
function setBilling(cycle) {
  var btnAnnual = document.getElementById('toggle-annual') || document.getElementById('price-btn-annual');
  var btnMonthly = document.getElementById('toggle-monthly') || document.getElementById('price-btn-monthly');
  var priceAmount = document.getElementById('plan-price-amount');
  var pricePeriod = document.getElementById('plan-price-period');
  var subNote = document.getElementById('price-sub-note');
  var isAr = (window.i18n && typeof window.i18n.getLocale === 'function') ? (window.i18n.getLocale() === 'ar') : false;

  if (cycle === 'annual') {
    if (btnAnnual) { btnAnnual.style.background = 'var(--indigo, #4338ca)'; btnAnnual.style.color = '#fff'; }
    if (btnMonthly) { btnMonthly.style.background = 'transparent'; btnMonthly.style.color = 'var(--muted)'; }
    if (priceAmount) priceAmount.textContent = '75';
    if (pricePeriod) pricePeriod.textContent = '/year';
    if (subNote) {
      subNote.innerHTML = isAr ? '≈ 6.25 ر.س / شهر (تُدفع سنويًا)' : '≈ 6.25 SAR / month (billed annually)';
      subNote.style.display = 'block';
    }
  } else {
    if (btnMonthly) { btnMonthly.style.background = 'var(--indigo, #4338ca)'; btnMonthly.style.color = '#fff'; }
    if (btnAnnual) { btnAnnual.style.background = 'transparent'; btnAnnual.style.color = 'var(--muted)'; }
    if (priceAmount) priceAmount.textContent = '15';
    if (pricePeriod) pricePeriod.textContent = '/month';
    if (subNote) {
      subNote.style.display = 'none';
    }
  }
}
</script>
