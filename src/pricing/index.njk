<script>
function setBilling(cycle) {
  var btnAnnual = document.getElementById('price-btn-annual');
  var btnMonthly = document.getElementById('price-btn-monthly');
  var displayVal = document.getElementById('price-display-val');
  var displayUnit = document.getElementById('price-display-unit');
  var subNote = document.getElementById('price-sub-note');
  var isAr = (window.i18n && typeof window.i18n.getLocale === 'function') ? (window.i18n.getLocale() === 'ar') : false;

  if (cycle === 'annual') {
    btnAnnual.style.background = 'var(--indigo, #4338ca)';
    btnAnnual.style.color = '#fff';
    btnMonthly.style.background = 'transparent';
    btnMonthly.style.color = 'var(--muted)';
    displayVal.textContent = '75 SAR';
    displayUnit.innerHTML = ' / ' + (isAr ? 'سنة' : 'year');
    subNote.innerHTML = isAr ? '≈ 6.25 ر.س / شهر (تُدفع سنويًا)' : '≈ 6.25 SAR / month (billed annually)';
    subNote.style.display = 'block';
  } else {
    btnMonthly.style.background = 'var(--indigo, #4338ca)';
    btnMonthly.style.color = '#fff';
    btnAnnual.style.background = 'transparent';
    btnAnnual.style.color = 'var(--muted)';
    displayVal.textContent = '15 SAR';
    displayUnit.innerHTML = ' / ' + (isAr ? 'شهر' : 'month');
    subNote.style.display = 'none';
  }
}
</script>
