<script>
(function(){
  var _currentCycle = 'annual';
  window.setBilling = function(cycle) {
    _currentCycle = (cycle === 'monthly') ? 'monthly' : 'annual';
    var btnAnnual = document.getElementById('toggle-annual') || document.getElementById('price-btn-annual');
    var btnMonthly = document.getElementById('toggle-monthly') || document.getElementById('price-btn-monthly');
    var priceAmount = document.getElementById('plan-price-amount');
    var priceCurrency = document.getElementById('price-display-val');
    var pricePeriod = document.getElementById('plan-price-period');
    var subNote = document.getElementById('price-sub-note');
    var isAr = (window.i18n && typeof window.i18n.getLocale === 'function')
      ? (window.i18n.getLocale() === 'ar')
      : (document.documentElement.lang === 'ar');

    if (priceCurrency) priceCurrency.textContent = isAr ? 'ر.س' : 'SAR';

    if (_currentCycle === 'annual') {
      if (btnAnnual) { btnAnnual.style.background = 'var(--indigo, #4338ca)'; btnAnnual.style.color = '#fff'; }
      if (btnMonthly) { btnMonthly.style.background = 'transparent'; btnMonthly.style.color = 'var(--muted)'; }
      if (priceAmount) priceAmount.textContent = '75';
      if (pricePeriod) pricePeriod.textContent = isAr ? '/ سنة' : '/year';
      if (subNote) subNote.style.display = 'block';
    } else {
      if (btnMonthly) { btnMonthly.style.background = 'var(--indigo, #4338ca)'; btnMonthly.style.color = '#fff'; }
      if (btnAnnual) { btnAnnual.style.background = 'transparent'; btnAnnual.style.color = 'var(--muted)'; }
      if (priceAmount) priceAmount.textContent = '15';
      if (pricePeriod) pricePeriod.textContent = isAr ? '/ شهر' : '/month';
      if (subNote) subNote.style.display = 'none';
    }
  };

  document.addEventListener('DOMContentLoaded', function() {
    window.setBilling(_currentCycle);
    var langBtn = document.getElementById('i18n-toggle-btn');
    if (langBtn) {
      langBtn.addEventListener('click', function() {
        setTimeout(function() { window.setBilling(_currentCycle); }, 0);
      });
    }
  });
})();
</script>
