---
{#
  Renders from content/tahsili/* (docs/CONTENT_MODEL.md) instead of the legacy
  {% include "tracks/tahsili.html" %} — second track cut over, following the qudrat pattern
  exactly (docs/DECISIONS/0005-qudrat-cutover.md). index.html (deleted, WP10 step 4 — docs/DECISIONS/0023; still recoverable via
  git history) and src/_includes/tracks/tahsili.html (also deleted, same step) used
  to be kept as an inert rollback path — no longer needed once every track had been
  migrated and verified live.
#}
{% set tahsili = migratedContent.tahsili %}
{% set pageHeader = tahsili.meta.meta.pageHeader %}
<main id="view-tahsili" class="view">
  {% include "partials/subject-head.njk" %}

  <div class="wrap calc-body">
    {% set chapters = tahsili.chapters %}
    {% set practiceSetId = 'tah-practice' %}
    {% set testGeneratorId = 'tah-testgen' %}
    {% set downloadsId = 'tah-downloads' %}
    {% include "partials/rail.njk" %}

    <div class="content">
      {% for chapter in tahsili.chapters %}
        {% include "partials/chapter.njk" %}
      {% endfor %}

      {% set sectionId = 'tah-practice' %}
      {% set practiceSet = tahsili.practiceSet %}
      {% include "partials/practice-set.njk" %}

      {% set sectionId = 'tah-testgen' %}
      {% set testGenerator = tahsili.meta.meta.testGenerator %}
      {% include "partials/test-generator.njk" %}

      {% set sectionId = 'tah-downloads' %}
      {% set courseMeta = tahsili.meta.meta %}
      {% include "partials/downloads-block.njk" %}
    </div>
  </div>
</main>
