---
layout: base.njk
trackId: qudrat
title: "Qudrat · ClipSAT"
description: "اختبار القدرات – رياضيات"
isRtl: false
---
{#
  Renders from content/qudrat/* (docs/CONTENT_MODEL.md) instead of the legacy
  {% include "tracks/qudrat.html" %} — the first track cut over to the target content system
  (docs/PHASE1-2_TARGET_ARCHITECTURE.md, WP8). index.html (deleted, WP10 step 4 —
  docs/DECISIONS/0023; still recoverable via git history) and src/_includes/tracks/qudrat.html
  (also deleted, same step) used to be kept as an inert rollback path — no longer needed once
  every track had been migrated and verified live.
#}
{% set qudrat = migratedContent.qudrat %}
{% set pageHeader = qudrat.meta.meta.pageHeader %}
<main id="view-qudrat" class="view">
  {% include "partials/subject-head.njk" %}

  <div class="wrap calc-body">
    {% set chapters = qudrat.chapters %}
    {% set practiceSetId = 'qud-practice' %}
    {% set testGeneratorId = 'qud-testgen' %}
    {% set downloadsId = 'qud-downloads' %}
    {% include "partials/rail.njk" %}

    <div class="content">
      {% for chapter in qudrat.chapters %}
        {% include "partials/chapter.njk" %}
      {% endfor %}

      {% set sectionId = 'qud-practice' %}
      {% set practiceSet = qudrat.practiceSet %}
      {% include "partials/practice-set.njk" %}

      {% set sectionId = 'qud-testgen' %}
      {% set testGenerator = qudrat.meta.meta.testGenerator %}
      {% include "partials/test-generator.njk" %}

      {% set sectionId = 'qud-downloads' %}
      {% set courseMeta = qudrat.meta.meta %}
      {% include "partials/downloads-block.njk" %}
    </div>
  </div>
</main>
