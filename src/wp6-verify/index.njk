<style>#view-wp6-verify .chapter{display:block !important}</style>
<main id="view-wp6-verify" class="view" style="display:block !important;max-width:900px;margin:0 auto;padding:20px">
  <p style="background:#fffbe6;border:1px solid #e6c200;padding:10px;border-radius:8px">
    ⚠️ Temporary verification page — not linked from nav, not the production qudrat page.
    Renders <code>content/qudrat/*.json</code> through the new blocks-model partials, ONE render
    (not a duplicated EN/AR section) — use the real 🌐 language button in the header above to
    toggle, same button and same JS every other page already uses. Remove this route once WP6/WP7
    parity is confirmed and reviewed.
  </p>

  {% for chapter in migratedContent.qudrat.chapters %}
    {% include "partials/chapter.njk" %}
  {% endfor %}

  <hr style="margin:40px 0">
  <h1>Downloads block</h1>
  {% set trackId = 'qudrat' %}
  {% set sectionId = 'qud-downloads' %}
  {% set courseMeta = migratedContent.qudrat.meta.meta %}
  {% include "partials/downloads-block.njk" %}

  <hr style="margin:40px 0">
  <h1>Practice set</h1>
  {% set sectionId = 'qud-practice' %}
  {% set practiceSet = migratedContent.qudrat.practiceSet %}
  {% include "partials/practice-set.njk" %}

  <hr style="margin:40px 0">
  <h1>Test generator</h1>
  {% set sectionId = 'qud-testgen' %}
  {% set testGenerator = migratedContent.qudrat.meta.meta.testGenerator %}
  {% include "partials/test-generator.njk" %}

  <hr style="margin:40px 0">
  <h1>Rail (not functionally navigable here — chapters aren't hidden by default on this page)</h1>
  {% set chapters = migratedContent.qudrat.chapters %}
  {% set practiceSetId = 'qud-practice' %}
  {% set testGeneratorId = 'qud-testgen' %}
  {% set downloadsId = 'qud-downloads' %}
  {% include "partials/rail.njk" %}

  <hr style="margin:40px 0">
  <h1>Subject head</h1>
  {% set pageHeader = migratedContent.qudrat.meta.meta.pageHeader %}
  {% include "partials/subject-head.njk" %}
</main>
