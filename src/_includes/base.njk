                   data-title="{{ title }}"
                   data-itemtype="material"></div>
            </span>
            <div class="nav-gamification">
              <span class="streak-badge" title="Daily streak">🔥 <span id="nav-streak">0</span></span>
              <span class="xp-badge" title="Total XP">⭐ <span id="nav-xp">0</span> XP</span>
            </div>
