{#
  Renders the "Downloads" section — the .dl-grid card row + the worksheet-library live widget.
  Matches the site's real markup/CSS classes exactly, EXCEPT one deliberate fix: the original
  source (index.html, all 21 tracks) has an unclosed <div class="dl"> around the DOCX card that
  swallows the "Official · Past Papers" card as its child instead of a sibling — browsers silently
  recover from it, but it's not what was intended (compare to the 2-card tracks, which don't have
  this bug). This partial emits properly-nested, valid HTML instead of reproducing the accidental
  nesting bug — every button, link, and piece of text is unchanged, only the div structure is fixed.

  introText/introLabel/pdfCardTitle/pdfCardDescription/docxCardLabel/docxCardTitle/
  docxCardDescription/worksheetLibraryText are bilingual (course_schema.json's bilingualText) —
  Qudrat and Tahsili carry real Arabic, every other track has ar:null (render English only, no
  toggle for that string), matching the established site-wide convention. The template's own
  hardcoded literals (card headings like "PDF · ready now", button labels like "Print / Save as
  PDF ↓", the docxCardLabel/docxCardTitle English-only fallback defaults) stay English-only on
  purpose — they're shared boilerplate rendered identically on all 21 tracks regardless of which
  ones have Arabic content, so translating them here would light up partial-Arabic chrome on
  tracks that were never meant to be bilingual. Every per-track string below comes from
  courseMeta.downloadsInfo as real per-track copy (course_schema.json) — a WP12 audit found this
  template used to hardcode generic copy instead, which was live and wrong on both qudrat's and
  tahsili's shipped pages, and a WP20 audit found the DOCX card's small label/heading were STILL
  hardcoded ('DOCX · on request' / 'Native Word packet') and live-wrong on appc's and apstats'
  shipped pages too. Do NOT reintroduce hardcoded/shared/invented per-track text here.

  info.plannedCard (WP33, calculus) is a real third .dl-grid card, sibling to PDF/DOCX, with a
  disabled-looking <span class="btn ghost"> instead of a real button — no other track has one.

  variant 'ib' (ibsl, WP23) is a real structural deviation, not just copy — see
  course_schema.json's downloadsInfo.variant description. It has no self-serve PDF/DOCX export at
  all; the officialLinks pp-card widget (unchanged markup) nests inside one specific resourceCards[]
  entry instead of sitting in .dl-grid beside PDF/DOCX cards.

  Expects: trackId, sectionId (the section's real id, e.g. 'qud-downloads' — NOT derived from
  trackId; must match the rail's data-target and any existing URL-hash deep links exactly, see
  rail.njk), courseMeta (the _meta.json 'meta' object — for officialLinks and downloadsInfo)
#}
{% import "partials/_bilingual.njk" as bl with context %}
{% set info = courseMeta.downloadsInfo %}
{% macro ppCard() %}<div class="dl pp-card">
      <div class="di">{{ bl.text({"en": "Official · Past Papers", "ar": "رسمي · اختبارات سابقة"}) }}</div>
      <h4>{{ bl.text({"en": "Past Papers &amp; Official Tests", "ar": "الاختبارات الرسمية ونماذج السنوات السابقة"}) }}</h4>
      <p>{{ bl.text({"en": "Officially released exams and mark schemes from the examining body.", "ar": "اختبارات ونماذج تصحيح صادرة رسميًا عن الجهة المنظمة للاختبار."}) }}</p>
      <div class="pp-links">
        {% for link in courseMeta.officialLinks %}
        <a href="{{ link.url }}" target="_blank" rel="noopener" class="pp-link">
          <span class="pp-label">{{ bl.text(link.label) }}</span>
          {% if link.note %}<span class="pp-note">{{ bl.text(link.note) }}</span>{% endif %}
        </a>
        {% endfor %}
      </div>
    </div>{% endmacro %}
<section class="chapter{% if isSyllabusHub %} ch-active{% endif %}" id="{{ sectionId }}">
  <div class="chead"><span class="cn">↓</span><h2>{% if info.variant == 'ib' %}{{ bl.text({"en": "Downloads &amp; Resources", "ar": "التنزيلات والمصادر"}) }}{% else %}{{ bl.text({"en": "Downloads", "ar": "التنزيلات"}) }}{% endif %}</h2></div>

  {% if info.variant == 'ib' %}
  <div class="callout note"><span class="lab">{{ bl.text(info.introLabel) }}</span>
    <p>{{ bl.text(info.introText) }}</p>
  </div>
  <div class="formula-cards">
    {% for card in info.resourceCards %}
    <div class="fcard{% if card.wide %} wide{% endif %}"><div class="ft">{{ card.title }}</div>{{ card.body | safe }}
      {% if card.officialLinksInside and courseMeta.officialLinks and courseMeta.officialLinks.length %}
      {{ ppCard() }}
      {% endif %}</div>
    {% endfor %}
  </div>
  {% else %}
  <p>{{ bl.text(info.introText) }}</p>

  <div class="dl-grid">
    <div class="dl">
      <div class="di">{{ bl.text({"en": "PDF · ready now", "ar": "ملف PDF · جاهز الآن"}) }}</div>
      <h4>{{ bl.text(info.pdfCardTitle) }}</h4>
      <p>{{ bl.text(info.pdfCardDescription) }}</p>
      <button class="btn primary" onclick="window.print()">{{ bl.text({"en": "Print / Save as PDF ↓", "ar": "طباعة / حفظ كـ PDF ↓"}) }}</button>
    </div>

    <div class="dl">
      <div class="di">{% if info.docxCardLabel %}{{ bl.text(info.docxCardLabel) }}{% else %}{{ bl.text({"en": "DOCX · on request", "ar": "ملف وورد DOCX"}) }}{% endif %}</div>
      <h4>{% if info.docxCardTitle %}{{ bl.text(info.docxCardTitle) }}{% else %}{{ bl.text({"en": "Native Word packet", "ar": "ملزمة Word قابلة للتعديل"}) }}{% endif %}</h4>
      <p>{{ bl.text(info.docxCardDescription) }}</p>
      <button class="btn amber" onclick="var b=this;window._ensureCSExport().then(function(){window.CSExport.downloadChapterDocx(b)})">{{ bl.text({"en": "📄 Download .docx ↓", "ar": "📄 تنزيل ملف .docx ↓"}) }}</button>
      <button class="btn" style="background:#1a1a2e;color:#fff" onclick="window._ensureCSExport().then(function(){window.CSExport.printActiveChapter()}).catch(function(){window.print()})">{{ bl.text({"en": "🖨 Print Chapter", "ar": "🖨 طباعة الفصل"}) }}</button>
    </div>

    {% if info.plannedCard %}
    <div class="dl">
      <div class="di">{{ info.plannedCard.label }}</div>
      <h4>{{ info.plannedCard.title }}</h4>
      <p>{{ info.plannedCard.description }}</p>
      <span class="btn ghost" style="cursor:default; opacity:.7">{{ info.plannedCard.buttonText }}</span>
    </div>
    {% endif %}

    {% if courseMeta.officialLinks and courseMeta.officialLinks.length %}{{ ppCard() }}{% endif %}
  </div>
  {% endif %}

  {% if trackId == 'sat' %}
  <h3 style="margin-top:26px">{{ bl.text({"en": "SAT® Complete Tiered Practice Books (ClipSAT Branded PDFs — Free for All Users)", "ar": "بنوك تدريب SAT® المصنّفة (ملفات PDF بهوية ClipSAT — مجانية لجميع المستخدمين)"}) }}</h3>
  <p style="font-size:.88rem;color:var(--muted)">{{ bl.text({"en": "Download complete ClipSAT-branded practice packets and full step-by-step answer keys for All Easy (770 Qs), All Medium (680 Qs), and All Hard (645 Qs), or launch any tier directly in CBT mode.", "ar": "نزّل حزم التدريب الكاملة بهوية ClipSAT مع مفاتيح الإجابة والحلول التفصيلية للمستوى السهل (770 سؤالًا) والمتوسط (680 سؤالًا) والصعب (645 سؤالًا)، أو حلّها مباشرة في محاكي الاختبار CBT."}) }}</p>
  <div class="cs-sat-packs-grid">
    <div class="cs-sat-pack-card">
      <span class="cs-sat-pack-badge easy">{{ bl.text({"en": "1 · All Easy", "ar": "1 · المستوى السهل"}) }}</span>
      <h4>{{ bl.text({"en": "Digital SAT® Math — ALL EASY (770 Qs)", "ar": "الرياضيات SAT® — المستوى السهل (770 سؤالًا)"}) }}</h4>
      <p>{{ bl.text({"en": "657 MCQs + 113 SPRs · ClipSAT branded practice PDF + complete worked solutions key.", "ar": "657 اختيار من متعدد + 113 إجابة رقمية · ملف تدريب PDF + مفتاح الحلول الكامل."}) }}</p>
      <div class="cs-sat-pack-actions">
        <a class="btn primary" href="/downloads/sat/bank-packs/clipsat-sat-all-easy-practice.pdf" target="_blank" rel="noopener" onclick="return window._openDownloadInBrowser?window._openDownloadInBrowser(event,this.href,'Digital SAT Math — All Easy Practice PDF'):true">{{ bl.text({"en": "📄 Practice PDF", "ar": "📄 ملف التدريب PDF"}) }}</a>
        <a class="btn amber" href="/downloads/sat/bank-packs/clipsat-sat-all-easy-answerkey.pdf" target="_blank" rel="noopener" onclick="return window._openDownloadInBrowser?window._openDownloadInBrowser(event,this.href,'Digital SAT Math — All Easy Solutions PDF'):true">{{ bl.text({"en": "✓ Answer Key PDF", "ar": "✓ مفتاح الحلول PDF"}) }}</a>
        <button type="button" class="btn ghost" onclick="openSatBankCBT('easy')">{{ bl.text({"en": "💻 Open CBT", "ar": "💻 محاكي CBT"}) }}</button>
      </div>
    </div>
    <div class="cs-sat-pack-card">
      <span class="cs-sat-pack-badge medium">{{ bl.text({"en": "2 · All Medium", "ar": "2 · المستوى المتوسط"}) }}</span>
      <h4>{{ bl.text({"en": "Digital SAT® Math — ALL MEDIUM (680 Qs)", "ar": "الرياضيات SAT® — المستوى المتوسط (680 سؤالًا)"}) }}</h4>
      <p>{{ bl.text({"en": "522 MCQs + 158 SPRs · ClipSAT branded practice PDF + complete worked solutions key.", "ar": "522 اختيار من متعدد + 158 إجابة رقمية · ملف تدريب PDF + مفتاح الحلول الكامل."}) }}</p>
      <div class="cs-sat-pack-actions">
        <a class="btn primary" href="/downloads/sat/bank-packs/clipsat-sat-all-medium-practice.pdf" target="_blank" rel="noopener" onclick="return window._openDownloadInBrowser?window._openDownloadInBrowser(event,this.href,'Digital SAT Math — All Medium Practice PDF'):true">{{ bl.text({"en": "📄 Practice PDF", "ar": "📄 ملف التدريب PDF"}) }}</a>
        <a class="btn amber" href="/downloads/sat/bank-packs/clipsat-sat-all-medium-answerkey.pdf" target="_blank" rel="noopener" onclick="return window._openDownloadInBrowser?window._openDownloadInBrowser(event,this.href,'Digital SAT Math — All Medium Solutions PDF'):true">{{ bl.text({"en": "✓ Answer Key PDF", "ar": "✓ مفتاح الحلول PDF"}) }}</a>
        <button type="button" class="btn ghost" onclick="openSatBankCBT('medium')">{{ bl.text({"en": "💻 Open CBT", "ar": "💻 محاكي CBT"}) }}</button>
      </div>
    </div>
    <div class="cs-sat-pack-card">
      <span class="cs-sat-pack-badge hard">{{ bl.text({"en": "3 · All Hard", "ar": "3 · المستوى الصعب"}) }}</span>
      <h4>{{ bl.text({"en": "Digital SAT® Math — ALL HARD (645 Qs)", "ar": "الرياضيات SAT® — المستوى الصعب (645 سؤالًا)"}) }}</h4>
      <p>{{ bl.text({"en": "413 MCQs + 232 SPRs · ClipSAT branded practice PDF + complete worked solutions key.", "ar": "413 اختيار من متعدد + 232 إجابة رقمية · ملف تدريب PDF + مفتاح الحلول الكامل."}) }}</p>
      <div class="cs-sat-pack-actions">
        <a class="btn primary" href="/downloads/sat/bank-packs/clipsat-sat-all-hard-practice.pdf" target="_blank" rel="noopener" onclick="return window._openDownloadInBrowser?window._openDownloadInBrowser(event,this.href,'Digital SAT Math — All Hard Practice PDF'):true">{{ bl.text({"en": "📄 Practice PDF", "ar": "📄 ملف التدريب PDF"}) }}</a>
        <a class="btn amber" href="/downloads/sat/bank-packs/clipsat-sat-all-hard-answerkey.pdf" target="_blank" rel="noopener" onclick="return window._openDownloadInBrowser?window._openDownloadInBrowser(event,this.href,'Digital SAT Math — All Hard Solutions PDF'):true">{{ bl.text({"en": "✓ Answer Key PDF", "ar": "✓ مفتاح الحلول PDF"}) }}</a>
        <button type="button" class="btn ghost" onclick="openSatBankCBT('hard')">{{ bl.text({"en": "💻 Open CBT", "ar": "💻 محاكي CBT"}) }}</button>
      </div>
    </div>
  </div>
  {% endif %}

  {% if info.worksheetHeadingPlain %}
  <h3>{{ bl.text({"en": "Worksheet Library", "ar": "مكتبة أوراق العمل"}) }}</h3>
  <p>{{ bl.text(info.worksheetLibraryText) }}</p>
  {% else %}
  <h3 style="margin-top:26px">{{ bl.text({"en": "Worksheet Library", "ar": "مكتبة أوراق العمل"}) }}</h3>
  <p style="font-size:.88rem;color:var(--muted)">{{ bl.text(info.worksheetLibraryText) }}</p>
  {% endif %}
  <div class="worksheet-library" data-track="{{ trackId }}"><div class="wl-loading">Loading worksheet library…</div></div>
</section>
