{#
  Shared macro for rendering a bilingualText field ({en, ar}).
  - On locale-split SSG pages (WP-21, where `pageLocale` is 'en' or 'ar'), emits ONLY
    the active locale's content without duplicate hidden `.i18n-en`/`.i18n-ar` DOM trees,
    cutting DOM node count in half (< 3,500 nodes per chapter page).
  - On dual-language track hub pages (where `pageLocale` is undefined), emits the
    client-toggleable `<tag data-bilingual>` pair.
#}
{% macro text(field, tag='span', locale=null) %}{% set _loc = locale or pageLocale %}{% if _loc == 'en' %}{% if tag == 'span' %}{{ (field.en or '') | safe }}{% else %}<{{ tag }}>{{ (field.en or '') | safe }}</{{ tag }}>{% endif %}{% elif _loc == 'ar' %}{% if tag == 'span' %}{{ (field.ar or field.en or '') | safe }}{% else %}<{{ tag }}>{{ (field.ar or field.en or '') | safe }}</{{ tag }}>{% endif %}{% else %}{% set _en = (field.en or '') | string %}{% set _ar = (field.ar or '') | string %}{% set _combo = (_en ~ ' ' ~ _ar) | lower %}{% set _hasBlock = ('<p>' in _combo) or ('<p ' in _combo) or ('<div' in _combo) or ('<ul' in _combo) or ('<ol' in _combo) or ('<table' in _combo) or ('<details' in _combo) or ('<blockquote' in _combo) or ('<pre' in _combo) or ('<h3' in _combo) or ('<h4' in _combo) %}{% set _tag = 'div' if (tag == 'span' and _hasBlock) else tag %}<{{ _tag }} data-bilingual><{{ _tag }} class="i18n-en">{{ field.en | safe }}</{{ _tag }}>{% if field.ar %}<{{ _tag }} class="i18n-ar" dir="rtl" hidden>{{ field.ar | safe }}</{{ _tag }}>{% endif %}</{{ _tag }}>{% endif %}{% endmacro %}

{% macro block(field, tag='div', locale=null) %}{% set _loc = locale or pageLocale %}{% if _loc == 'en' %}<{{ tag }}>{{ (field.en or '') | safe }}</{{ tag }}>{% elif _loc == 'ar' %}<{{ tag }}>{{ (field.ar or field.en or '') | safe }}</{{ tag }}>{% else %}<{{ tag }} data-bilingual><{{ tag }} class="i18n-en">{{ field.en | safe }}</{{ tag }}>{% if field.ar %}<{{ tag }} class="i18n-ar" dir="rtl" hidden>{{ field.ar | safe }}</{{ tag }}>{% endif %}</{{ tag }}>{% endif %}{% endmacro %}

{% macro attr(attrName, field) %}{% if pageLocale == 'ar' %}{{ attrName }}="{{ field.ar or field.en }}"{% elif pageLocale == 'en' %}{{ attrName }}="{{ field.en }}"{% else %}{{ attrName }}="{{ field.en }}" data-bilingual-attrs="{{ attrName }}" data-{{ attrName }}-en="{{ field.en }}"{% if field.ar %} data-{{ attrName }}-ar="{{ field.ar }}"{% endif %}{% endif %}{% endmacro %}
