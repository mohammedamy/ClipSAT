{#
  Renders <section class="subject-head {trackId}"> — the page H1 + small stat row at the top of
  a track page. Matches the site's real markup exactly. Distinct from meta.title (used in
  <title>/nav/cards) since the on-page H1 can read differently.
  pageHeader.noTrackClass (WP33, calculus) — calculus's real source omits the trailing trackId
  class entirely (just <section class="subject-head">), unlike every other track.
  Expects: trackId, pageHeader (courseMeta.pageHeader)
#}
{% import "partials/_bilingual.njk" as bl %}
<section class="subject-head{% if not pageHeader.noTrackClass %} {{ trackId }}{% endif %}">
  <div class="wrap">
    <span class="eyebrow{% if pageHeader.eyebrowClass %} {{ pageHeader.eyebrowClass }}{% endif %}">{% if pageHeader.eyebrow %}{{ bl.text(pageHeader.eyebrow) }}{% endif %}</span>
    <h1>{{ bl.text(pageHeader.h1) }}</h1>
    <div class="meta">
      {% for stat in pageHeader.stats %}
      <span><b>{{ bl.text(stat.label) }}</b> · {{ bl.text(stat.value) }}</span>
      {% endfor %}
    </div>
    <div class="cs-syllabus-transparency">
      <span class="cs-transparency-badge">✓ <span data-i18n="syllabus.reviewed">Official Syllabus Verified</span></span>
      <span class="cs-transparency-date"><span data-i18n="syllabus.lastReview">Last reviewed against official syllabus:</span> <b>2025–2026 Academic Year</b></span>
      <a href="/rigor-standard.html" class="cs-transparency-link" data-i18n="syllabus.standardLink">Standards &amp; Rigor ↗</a>
    </div>
  </div>
</section>
