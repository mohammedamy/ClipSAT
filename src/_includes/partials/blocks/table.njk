{#
  Renders one 'table' block (course_schema.json #/definitions/tableBlock).
  Matches the site's real <table class="exam-table"> markup. Note: in the original source,
  a table like this typically sat inside a shared <div class="callout note"> alongside its
  caption and a trailing paragraph (see docs/CONTENT_MODEL.md / docs/DECISIONS/0002) — this
  partial renders the caption as its own labeled wrapper instead of nesting inside a callout,
  a deliberate small normalization verified visually, not a byte-for-byte DOM match.
  Expects: block (the table object)
#}
{% import "partials/_bilingual.njk" as bl %}
<div class="callout note">
  {% if block.caption %}<span class="lab">{{ bl.text(block.caption) }}</span>{% endif %}
  <table class="exam-table" style="margin-top:6px">
    <thead>
      <tr>
        {% for col in block.columns %}
        <th>{{ bl.text(col) }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in block.rows %}
      <tr>
        {% for cell in row %}
        <td>{{ bl.text(cell) }}</td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
