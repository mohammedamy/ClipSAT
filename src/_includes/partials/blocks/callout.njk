{#
  Renders one 'callout' block (course_schema.json #/definitions/calloutBlock).
  style 'example' uses the site's separate <div class="example"> wrapper (class="xt" label)
  instead of <div class="callout X"> (class="lab" label) — matches real markup exactly,
  see docs/CONTENT_MODEL.md. style 'example-card' uses the <div class="fcard"> wrapper.
  style 'example-grid' also uses <div class="example">, but wraps a bold static "Worked
  Example · {label}" title line + raw body <p> paragraphs in a <div class="ex-body"> grid
  (ibsl/ibhl/calculus real pattern) — distinct from plain 'example's <span class="xt"> label.
  Both languages render via the {% import %}'d bilingual macro — window.i18n's toggle
  (docs/DECISIONS/0004) switches which one is visible client-side, no lang param needed here.
  Expects: block (the callout object)
#}
{% import "partials/_bilingual.njk" as bl %}
{% if block.style == 'example' %}
<div class="example">
  {% if block.label %}<span class="xt">{{ bl.text(block.label) }}</span>{% endif %}
  <p>{{ bl.text(block.body, 'span') }}</p>
  <div class="we-actions no-print" style="margin-top:10px;display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap">
    <button type="button" class="btn-twin-prob" onclick="window.CSTwinProblem&&window.CSTwinProblem.open(this)" style="background:var(--indigo-soft,#eef2ff);border:1px solid var(--indigo,#4f46e5);border-radius:6px;padding:4px 10px;font-size:.78rem;font-weight:700;cursor:pointer;color:var(--indigo,#4f46e5);display:inline-flex;align-items:center;gap:5px;transition:all .15s ease" title="Practice a similar question from the verified question bank">
      <span>🔄</span><span data-bilingual><span class="i18n-en">Try a Similar Problem</span><span class="i18n-ar" dir="rtl" lang="ar" hidden>جرب مسألة مشابهة</span></span>
    </button>
    <button type="button" class="btn-ex-graph" onclick="window.CSExampleGrapher&&window.CSExampleGrapher.graphFromExample(this)" style="background:var(--paper-2,#f1f5f9);border:1px solid var(--border,#cbd5e1);border-radius:6px;padding:4px 10px;font-size:.78rem;font-weight:600;cursor:pointer;color:var(--ink-2,#334155);display:inline-flex;align-items:center;gap:5px;transition:all .15s ease" title="Plot functions from this example in the interactive graphing calculator">
      <span>📈</span><span data-bilingual><span class="i18n-en">Graph in Calculator</span><span class="i18n-ar" dir="rtl" lang="ar" hidden>مثّل في الحاسبة</span></span>
    </button>
  </div>
</div>
{% elif block.style == 'example-card' %}
<div class="fcard">
  {% if block.label %}<div class="ft">{{ bl.text(block.label) }}</div>{% endif %}
  <p>{{ bl.text(block.body, 'span') }}</p>
  <div class="we-actions no-print" style="margin-top:10px;display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap">
    <button type="button" class="btn-twin-prob" onclick="window.CSTwinProblem&&window.CSTwinProblem.open(this)" style="background:var(--indigo-soft,#eef2ff);border:1px solid var(--indigo,#4f46e5);border-radius:6px;padding:4px 10px;font-size:.78rem;font-weight:700;cursor:pointer;color:var(--indigo,#4f46e5);display:inline-flex;align-items:center;gap:5px;transition:all .15s ease" title="Practice a similar question from the verified question bank">
      <span>🔄</span><span data-bilingual><span class="i18n-en">Try a Similar Problem</span><span class="i18n-ar" dir="rtl" lang="ar" hidden>جرب مسألة مشابهة</span></span>
    </button>
    <button type="button" class="btn-ex-graph" onclick="window.CSExampleGrapher&&window.CSExampleGrapher.graphFromExample(this)" style="background:var(--paper-2,#f1f5f9);border:1px solid var(--border,#cbd5e1);border-radius:6px;padding:4px 10px;font-size:.78rem;font-weight:600;cursor:pointer;color:var(--ink-2,#334155);display:inline-flex;align-items:center;gap:5px;transition:all .15s ease" title="Plot functions from this example in the interactive graphing calculator">
      <span>📈</span><span data-bilingual><span class="i18n-en">Graph in Calculator</span><span class="i18n-ar" dir="rtl" lang="ar" hidden>مثّل في الحاسبة</span></span>
    </button>
  </div>
</div>
{% elif block.style == 'example-grid' %}
<div class="example">
  <div class="ex-body" style="grid-template-columns:1fr">
    <div>
      <p style="font-weight:700;margin-bottom:8px">Worked Example &nbsp;·&nbsp; {{ bl.text(block.label) }}</p>
      {{ bl.text(block.body, 'span') }}
    </div>
  </div>
  <div class="we-actions no-print" style="margin-top:10px;display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap">
    <button type="button" class="btn-twin-prob" onclick="window.CSTwinProblem&&window.CSTwinProblem.open(this)" style="background:var(--indigo-soft,#eef2ff);border:1px solid var(--indigo,#4f46e5);border-radius:6px;padding:4px 10px;font-size:.78rem;font-weight:700;cursor:pointer;color:var(--indigo,#4f46e5);display:inline-flex;align-items:center;gap:5px;transition:all .15s ease" title="Practice a similar question from the verified question bank">
      <span>🔄</span><span data-bilingual><span class="i18n-en">Try a Similar Problem</span><span class="i18n-ar" dir="rtl" lang="ar" hidden>جرب مسألة مشابهة</span></span>
    </button>
    <button type="button" class="btn-ex-graph" onclick="window.CSExampleGrapher&&window.CSExampleGrapher.graphFromExample(this)" style="background:var(--paper-2,#f1f5f9);border:1px solid var(--border,#cbd5e1);border-radius:6px;padding:4px 10px;font-size:.78rem;font-weight:600;cursor:pointer;color:var(--ink-2,#334155);display:inline-flex;align-items:center;gap:5px;transition:all .15s ease" title="Plot functions from this example in the interactive graphing calculator">
      <span>📈</span><span data-bilingual><span class="i18n-en">Graph in Calculator</span><span class="i18n-ar" dir="rtl" lang="ar" hidden>مثّل في الحاسبة</span></span>
    </button>
  </div>
</div>
{% elif block.style == 'warn' %}
{#
  style 'warn' is used for Practice Problem boxes (qudrat/tahsili) whose body embeds a raw
  <details><summary>Show solution</summary>...</details> disclosure directly in the bilingual
  en/ar HTML string. <details> is block-level content, invalid inside a <p>, so wrapping the
  body in <p> (as the shared else branch below does) let a real HTML parser — cheerio, in
  scripts/katex-ssr.js's build-time transform — legally auto-close that <p> the moment it hit
  <details>, which also force-closed every span still open above it on the stack, including
  bl.text()'s own <span data-bilingual> and <span class="i18n-en"> wrappers (see HTML5 "close a
  p element" step 3: pop elements until a p has been popped — that's not just the p, it's
  everything opened inside it too). The result: the .i18n-ar span for the SECOND language in
  source order re-opened as a bare sibling, no longer nested inside [data-bilingual] at all —
  confirmed live (Playwright DOM check) across all 19 such callouts in qudrat + tahsili. Since
  window.i18n's _applyToDOM() toggle only ever looks for ':scope > .i18n-ar' inside a
  [data-bilingual] element, that orphaned span could never be found or un-hidden — the Arabic
  translation existed in the content JSON the whole time, but could never actually be shown.
  <div> has no such content-model restriction against <details>, so rendering the body straight
  through bl.text(block.body, 'div') — instead of hand-wrapping it in <p> — keeps the whole
  bilingual structure intact through any HTML reparse, no matter what block content a language's
  body happens to contain. Scoped to style 'warn' only (not the shared else branch) since that's
  the only style anything embeds <details> in today; the def/thm/note/tip callouts below keep
  their original <p> wrapper unchanged.
#}
<div class="callout warn">
  {% if block.label %}<span class="lab">{{ bl.text(block.label) }}{% if block.copyLatex %} <button class="copy-eq-btn" type="button" data-latex="{{ block.copyLatex }}">📋 Copy LaTeX</button>{% endif %}</span>{% endif %}
  {{ bl.text(block.body, 'div') }}
</div>
{% else %}
<div class="callout {{ block.style }}">
  {% if block.label %}<span class="lab">{{ bl.text(block.label) }}{% if block.copyLatex %} <button class="copy-eq-btn" type="button" data-latex="{{ block.copyLatex }}">📋 Copy LaTeX</button>{% endif %}</span>{% endif %}
  {{ bl.text(block.body, 'div') }}
  {% if block.style == 'ex' %}
  <div class="we-actions no-print" style="margin-top:10px;display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap">
    <button type="button" class="btn-twin-prob" onclick="window.CSTwinProblem&&window.CSTwinProblem.open(this)" style="background:var(--indigo-soft,#eef2ff);border:1px solid var(--indigo,#4f46e5);border-radius:6px;padding:4px 10px;font-size:.78rem;font-weight:700;cursor:pointer;color:var(--indigo,#4f46e5);display:inline-flex;align-items:center;gap:5px;transition:all .15s ease" title="Practice a similar question from the verified question bank">
      <span>🔄</span><span data-bilingual><span class="i18n-en">Try a Similar Problem</span><span class="i18n-ar" dir="rtl" lang="ar" hidden>جرب مسألة مشابهة</span></span>
    </button>
    <button type="button" class="btn-ex-graph" onclick="window.CSExampleGrapher&&window.CSExampleGrapher.graphFromExample(this)" style="background:var(--paper-2,#f1f5f9);border:1px solid var(--border,#cbd5e1);border-radius:6px;padding:4px 10px;font-size:.78rem;font-weight:600;cursor:pointer;color:var(--ink-2,#334155);display:inline-flex;align-items:center;gap:5px;transition:all .15s ease" title="Plot functions from this example in the interactive graphing calculator">
      <span>📈</span><span data-bilingual><span class="i18n-en">Graph in Calculator</span><span class="i18n-ar" dir="rtl" lang="ar" hidden>مثّل في الحاسبة</span></span>
    </button>
  </div>
  {% endif %}
</div>
{% endif %}
