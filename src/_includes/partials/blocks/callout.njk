{#
  Renders one 'callout' block (course_schema.json #/definitions/calloutBlock).
  style 'example' uses the site's separate <div class="example"> wrapper (class="xt" label)
  instead of <div class="callout X"> (class="lab" label) — matches real markup exactly,
  see docs/CONTENT_MODEL.md. style 'example-card' uses the <div class="fcard"> wrapper.
  Both languages render via the {% import %}'d bilingual macro — window.i18n's toggle
  (docs/DECISIONS/0004) switches which one is visible client-side, no lang param needed here.
  Expects: block (the callout object)
#}
{% import "partials/_bilingual.njk" as bl %}
{% if block.style == 'example' %}
<div class="example">
  {% if block.label %}<span class="xt">{{ bl.text(block.label) }}</span>{% endif %}
  <p>{{ bl.text(block.body, 'span') }}</p>
</div>
{% elif block.style == 'example-card' %}
<div class="fcard">
  {% if block.label %}<div class="ft">{{ bl.text(block.label) }}</div>{% endif %}
  <p>{{ bl.text(block.body, 'span') }}</p>
</div>
{% else %}
<div class="callout {{ block.style }}">
  {% if block.label %}<span class="lab">{{ bl.text(block.label) }}{% if block.copyLatex %} <button class="copy-eq-btn" type="button" data-latex="{{ block.copyLatex }}">📋 Copy LaTeX</button>{% endif %}</span>{% endif %}
  <p>{{ bl.text(block.body, 'span') }}</p>
</div>
{% endif %}
