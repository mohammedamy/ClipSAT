{#
  Renders one 'practiceProblem' block (course_schema.json #/definitions/practiceProblemBlock).
  Matches the site's real <div class="problem"> markup exactly, including the chevron-SVG "Show
  solution" button and toggleSol(this) handler (existing engine.js JS, unmodified) — these are
  identical on every real instance, so they're static template markup here, not per-instance
  schema fields (docs/DECISIONS/0002's blocks-model token-efficiency principle).
  Expects: block (the practiceProblem object)
#}
{% import "partials/_bilingual.njk" as bl %}
<div class="problem">
  <div class="problem-q" style="padding:14px 16px">{{ bl.text(block.question) }}</div>
  <div style="display:flex;align-items:center;justify-content:space-between;padding:0 16px 8px;gap:8px;flex-wrap:wrap">
    <button class="sol-btn" onclick="toggleSol(this)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg> Show solution</button>
    <button type="button" class="btn-intuition-ar" onclick="window.askArabicIntuition&&window.askArabicIntuition(this)" style="background:transparent;border:1px solid var(--border,#cbd5e1);border-radius:6px;padding:3px 8px;font-size:.78rem;font-weight:600;cursor:pointer;color:var(--indigo,#1e3e70);display:inline-flex;align-items:center;gap:4px;transition:all .15s ease" title="اشرح الفكرة والحدس الرياضي بالعربية">
      <span>💡 اشرح الفكرة بالعربية</span>
    </button>
  </div>
  <div class="solution" style="padding:12px 16px;border-top:1px solid var(--line)">{{ bl.text(block.solution) }}</div>
</div>
