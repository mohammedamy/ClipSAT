{% import "partials/_bilingual.njk" as bl with context %}
<div class="problem">
  <div class="problem-q">{{ bl.text(block.question, 'div') }}</div>
  {% if block.figure %}<div class="lesson-figure-svg" data-lazy-fig='{{ block.figure | jsonAttr | safe }}'></div>{% endif %}
  {% if block.hints and block.hints.length %}
  <div class="problem-hints">
    {% for h in block.hints %}
    <details class="hint-tier">
      <summary class="hint-tier-sum"><span>💡 Hint {{ loop.index }} of {{ block.hints.length }}</span></summary>
      <div class="hint-tier-row"><div class="cs-hint-body">{{ bl.text(h, 'div') }}</div><button type="button" class="cs-voice-btn cs-voice-btn-sm no-print" onclick="window.CSVoiceTutor&&window.CSVoiceTutor.speakTier(this,event)" title="Listen to this hint" aria-label="Listen to Hint {{ loop.index }}"><span>🔊</span></button></div>
    </details>
    {% endfor %}
  </div>
  {% endif %}
  <div class="problem-actions">
    <div class="ps-item-actions">
      <button class="sol-btn" onclick="toggleSol(this)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg> Show solution</button>
      <button type="button" class="cs-voice-btn no-print" onclick="window.CSVoiceTutor&&window.CSVoiceTutor.speakProblemSolution(this)" title="Listen to worked solution" aria-label="Listen to worked solution"><span>🔊</span><span>Listen</span></button>
      <button type="button" class="cs-flag-btn no-print" onclick="window.CSErrorFlagManager&&window.CSErrorFlagManager.openReportPopover(this,event)" title="Report an error in this question" aria-label="Report Error"><span>🚩</span><span class="cs-flag-lbl">Report Error</span></button>
    </div>
    <button type="button" class="btn-intuition-ar" onclick="window.askArabicIntuition&&window.askArabicIntuition(this)" title="اشرح الفكرة والحدس الرياضي بالعربية"><span>💡 اشرح الفكرة بالعربية</span></button>
  </div>
  <div class="solution problem-sol">{{ bl.text(block.solution, 'div') }}</div>
</div>
