{#
  Renders one 'explorer' block (course_schema.json #/definitions/explorerBlock). Matches the site's
  real <div class="explorer"> markup exactly. Every id here is a plain pass-through string — the
  actual drawing/interaction logic lives in public/js/engine.js, keyed to these exact ids, and is
  NOT reimplemented or invented here. See docs/DECISIONS/0003-explorer-block.md.
  Text content uses the bilingual macro (window.i18n toggle, docs/DECISIONS/0004); aria-label
  attributes use its attr() companion since the dual-span trick doesn't work inside an attribute —
  each carries a real default (English) value plus the data-*-en/-ar pair for the toggle to read.
  readouts[].value is the real initial text (WP23 fix — was hardcoded to a literal em-dash for
  every track, silently wrong wherever source actually precomputes a default like '31.67').
  block.canvas3d (WP24) swaps the plain <canvas> for the lazy-loaded 3D toggle-button shape.
  A control with 'options' (WP26) renders a real <select> instead of a range slider — no
  'selected' attribute is added (source has none; the browser's own first-option default matches).
  Expects: block (the explorer object)
#}
{% import "partials/_bilingual.njk" as bl %}
<div class="explorer">
  <div class="ex-top"><span class="et">{{ bl.text(block.title) }}</span><span class="badge">interactive</span></div>
  <div class="ex-body">
    <div class="ex-canvas">
      {% if block.canvas3d %}
      <button type="button" id="{{ block.canvas3d.btnId }}" class="ex-3d-btn" aria-expanded="false" aria-controls="{{ block.canvas3d.wrapId }}"{% if block.canvas3d.btnStyle %} style="{{ block.canvas3d.btnStyle }}"{% endif %}>{{ block.canvas3d.btnLabel }}</button>
      <div id="{{ block.canvas3d.wrapId }}" class="canvas-wrap ex-3d-wrap" hidden role="img" aria-label="{{ block.canvas3d.ariaLabel.en }}" data-bilingual-attrs="aria-label" {{ bl.attr('aria-label', block.canvas3d.ariaLabel) }}></div>
      {% if block.canvas3d.hintId %}<p id="{{ block.canvas3d.hintId }}" class="ex-3d-hint" hidden>Drag to rotate, scroll to zoom · loads a small 3D library on first use</p>{% endif %}
      {% else %}
      <div class="canvas-wrap"><canvas id="{{ block.canvasId }}"{% if block.ariaLabel %} aria-label="{{ block.ariaLabel.en }}" data-bilingual-attrs="aria-label" {{ bl.attr('aria-label', block.ariaLabel) }}{% endif %}{% if block.dataPanel %} aria-describedby="{{ block.dataPanel.descId }}"{% endif %}></canvas></div>
      {% endif %}
      {% if block.dataPanel %}
      <button type="button" id="{{ block.dataPanel.btnId }}" class="ex-data-btn" aria-expanded="false" aria-controls="{{ block.dataPanel.panelId }}">📊 View as data (non-visual equivalent)</button>
      <div id="{{ block.dataPanel.panelId }}" class="ex-data-panel" hidden>
        <p id="{{ block.dataPanel.descId }}"></p>
        <table class="ex-data-table">
          {% if block.dataPanel.caption %}<caption>{{ bl.text(block.dataPanel.caption) }}</caption>{% endif %}
          <thead><tr>{% for col in block.dataPanel.columns %}<th scope="col">{{ bl.text(col) }}</th>{% endfor %}</tr></thead>
          <tbody id="{{ block.dataPanel.rowsId }}"></tbody>
        </table>
      </div>
      {% endif %}
    </div>
    <div class="ex-controls">
      {% for ctrl in block.controls %}
      <div class="ctrl"><label>{{ bl.text(ctrl.label) }}{% if ctrl.valueDisplayId %} <span class="mono" id="{{ ctrl.valueDisplayId }}">{{ ctrl.value }}</span>{% endif %}</label>{% if ctrl.options %}<select id="{{ ctrl.id }}"{% if ctrl.ariaLabel %} aria-label="{{ ctrl.ariaLabel.en }}" data-bilingual-attrs="aria-label" {{ bl.attr('aria-label', ctrl.ariaLabel) }}{% endif %}>{% for o in ctrl.options %}<option value="{{ o.value }}">{{ o.label }}</option>{% endfor %}</select>{% else %}<input type="range" id="{{ ctrl.id }}" min="{{ ctrl.min }}" max="{{ ctrl.max }}" value="{{ ctrl.value }}" step="{{ ctrl.step }}"{% if ctrl.ariaLabel %} aria-label="{{ ctrl.ariaLabel.en }}" data-bilingual-attrs="aria-label" {{ bl.attr('aria-label', ctrl.ariaLabel) }}{% endif %}>{% endif %}</div>
      {% endfor %}
      {% if block.readouts and block.readouts.length %}
      <div class="readout" aria-live="polite">
        {% for r in block.readouts %}
        <div class="readrow{% if r.colorClass %} {{ r.colorClass }}{% endif %}"><span>{{ bl.text(r.label) }}</span><span class="v"{% if not r.parts %} id="{{ r.id }}"{% endif %}>{% if r.parts %}{% for p in r.parts %}<span id="{{ p.id }}">{{ p.value }}</span>{{ p.suffix or '' }}{% endfor %}{% else %}{{ r.value or '—' }}{% endif %}</span></div>
        {% endfor %}
      </div>
      {% endif %}
      {% if block.note %}
      <div class="callout note" style="margin:0; padding:12px 14px; font-size:.84rem"><p style="margin:0">{{ bl.text(block.note) }}</p></div>
      {% endif %}
    </div>
  </div>
</div>
