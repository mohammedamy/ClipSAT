{#
  Renders one 'text' block (course_schema.json #/definitions/textBlock) — a plain paragraph
  with no wrapper, e.g. a chapter's opening sentence before the first callout.
  block.heading (WP33, calculus) is an optional bare <h3> right before the paragraph, for a
  standalone subheading not tied to a following cards block.
  Expects: block (the text object)
#}
{% import "partials/_bilingual.njk" as bl %}
{% if block.heading %}<h3>{{ block.heading }}</h3>{% endif %}
{% if block.body %}<p>{{ bl.text(block.body) }}</p>{% endif %}
