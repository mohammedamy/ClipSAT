{% import "partials/_bilingual.njk" as bl with context %}
<div class="fcard we-card">
  <div class="ft">{{ bl.text(block.label) }}</div>
  <div class="we-problem"><strong>{{ bl.text({"en": "Problem.", "ar": "المسألة."}) }}</strong> {{ bl.text(block.problem) }}</div>
  {% if block.figure %}<div class="lesson-figure-svg we-figure" data-lazy-fig='{{ block.figure | jsonAttr | safe }}'></div>{% endif %}
  <details class="we-solution-reveal">
    <summary class="we-solution-summary"><span>▸</span> {{ bl.text({"en": "Show step-by-step solution", "ar": "عرض خطوات الحل بالتفصيل"}) }}</summary>
    <div class="solution we-solution-body">{{ bl.text(block.solution, 'div') }}</div>
  </details>
  <div class="we-actions no-print">
    <button type="button" class="btn-twin-prob" onclick="window.CSTwinProblem&&window.CSTwinProblem.open(this)" {{ bl.attr('title', {"en": "Practice a similar question from the verified question bank", "ar": "تدرّب على مسألة مشابهة من بنك الأسئلة الموثق"}) }}><span>🔄</span>{{ bl.text({"en": "Try a Similar Problem", "ar": "جرب مسألة مشابهة"}) }}</button>
    <button type="button" class="btn-ex-graph" onclick="window.CSExampleGrapher&&window.CSExampleGrapher.graphFromExample(this)" {{ bl.attr('title', {"en": "Plot functions from this example in the interactive graphing calculator", "ar": "ارسم دوال هذا المثال في الآلة الحاسبة البيانية التفاعلية"}) }}><span>📈</span>{{ bl.text({"en": "Graph in Calculator", "ar": "مثّل في الحاسبة"}) }}</button>
    <button type="button" class="cs-flag-btn no-print" onclick="window.CSErrorFlagManager&&window.CSErrorFlagManager.openReportPopover(this,event)" {{ bl.attr('title', {"en": "Report an error in this example", "ar": "الإبلاغ عن خطأ في هذا المثال"}) }} {{ bl.attr('aria-label', {"en": "Report Error", "ar": "إبلاغ عن خطأ"}) }}><span>🚩</span><span class="cs-flag-lbl">{{ bl.text({"en": "Report Error", "ar": "إبلاغ عن خطأ"}) }}</span></button>
    <button type="button" class="btn-intuition-ar" onclick="window.askArabicIntuition&&window.askArabicIntuition(this)" title="اشرح الفكرة والحدس الرياضي بالعربية"><span>💡 اشرح الفكرة بالعربية</span></button>
  </div>
</div>
