{% import "partials/_bilingual.njk" as bl with context %}
{% set _sf = block.figure if (block.figure and block.figure.type == 'slope_field') else none %}
{% set _sfFn = (_sf.fn or _sf.expr or _sf.f or 'x - y') if _sf else '' %}
{% set _sfXmin = (_sf.xmin if _sf.xmin is defined else (_sf.xrange[0] if _sf.xrange else -3)) if _sf else -3 %}
{% set _sfXmax = (_sf.xmax if _sf.xmax is defined else (_sf.xrange[1] if _sf.xrange else 3)) if _sf else 3 %}
{% set _sfYmin = (_sf.ymin if _sf.ymin is defined else (_sf.yrange[0] if _sf.yrange else -3)) if _sf else -3 %}
{% set _sfYmax = (_sf.ymax if _sf.ymax is defined else (_sf.yrange[1] if _sf.yrange else 3)) if _sf else 3 %}
{% set _sfSol = (_sf.solution if _sf.solution else (_sf.curves[0] if (_sf.curves and _sf.curves.length) else none)) if _sf else none %}
<figure class="lesson-figure"{% if block.id %} id="{{ block.id }}"{% endif %}{% if _sf %} data-cs-interactive-slopefield="1" data-sf-fn="{{ _sfFn }}" data-sf-title="{{ _sf.title or '' }}" data-sf-xmin="{{ _sfXmin }}" data-sf-xmax="{{ _sfXmax }}" data-sf-ymin="{{ _sfYmin }}" data-sf-ymax="{{ _sfYmax }}" data-sf-x0="{{ _sfSol.x0 if _sfSol and _sfSol.x0 is defined else 0 }}" data-sf-y0="{{ _sfSol.y0 if _sfSol and _sfSol.y0 is defined else 1 }}"{% endif %}>
  {% if block.title %}<div class="lesson-figure-title">{{ bl.text(block.title) }}</div>{% endif %}
  <div class="lesson-figure-svg" data-lazy-fig='{{ block.figure | jsonAttr | safe }}'></div>
  {% if block.caption %}<figcaption class="lesson-figure-caption">{{ bl.text(block.caption) }}</figcaption>{% endif %}
</figure>
