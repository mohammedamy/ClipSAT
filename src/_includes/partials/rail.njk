{#
  Renders <aside class="rail"> — the chapter nav sidebar.
  - On per-chapter SSG pages (`isChapterPage == true` or `isSyllabusHub == true`), links point
    directly to crawlable chapter URLs (`/{track}/{chapter.id}/` or `/ar/{track}/{chapter.id}/`)
    with `data-prefetch="1"` for hover/focus `<link rel="prefetch">` preloading (WP-21).
  - On legacy track pages (`/<track>/index.html`), preserves `#{{ chapter.id }}` + `goChapter(...)`
    plus `data-chapter-url="/{{ trackId }}/{{ chapter.id }}/"` for deep-linking & prefetch.
#}
{% import "partials/_bilingual.njk" as bl with context %}
{% set _locPrefix = '/ar' if pageLocale == 'ar' else '' %}
<aside class="rail"{% if not railNoTrackId %} id="rail-{{ trackId }}"{% else %} id="rail"{% endif %}>
  <div class="cs-diagnostic-rail-cta" style="margin:0 4px 14px">
    <button type="button" class="cs-diagnostic-btn" onclick="window.openDiagnosticTest('{{ trackId }}')" style="width:100%; justify-content:center">
      <span>🎯</span> <span data-i18n="diagnostic.btn">{% if pageLocale == 'ar' %}ابدأ الاختبار التشخيصي المجاني{% else %}Free Diagnostic{% endif %}</span>
    </button>
  </div>
  {% if not (chapters and chapters[0] and chapters[0].railGroupLabel) %}
  <p class="rt">{{ bl.text({"en": "Chapters", "ar": "الفصول"}, 'span', pageLocale) }}</p>
  {% endif %}
  {% for chapter in chapters %}
  {% if chapter.railGroupLabel %}<p class="rt rt-sub"{% if not loop.first %} style="margin-top:16px"{% endif %}>{% if chapter.railGroupLabel.en %}{{ bl.text(chapter.railGroupLabel, 'span', pageLocale) }}{% else %}{{ chapter.railGroupLabel }}{% endif %}</p>{% endif %}
  {% if isChapterPage or isSyllabusHub or isPracticePage %}
  <a href="{{ _locPrefix }}/{{ trackId }}/{{ chapter.id }}/" data-target="{{ chapter.id }}" data-prefetch="1"{% if activeChapterId == chapter.id %} class="active" aria-current="page"{% endif %}><span class="num">{{ chapter.chapterNumber }}</span>{{ bl.text(chapter.railLabel or chapter.title, 'span', pageLocale) }}</a>
  {% else %}
  <a href="#{{ chapter.id }}" data-target="{{ chapter.id }}" data-chapter-url="/{{ trackId }}/{{ chapter.id }}/" data-prefetch="1" onclick="goChapter('{{ chapter.id }}'{% if not railNoTrackId %},'{{ trackId }}'{% endif %})"><span class="num">{{ chapter.chapterNumber }}</span>{{ bl.text(chapter.railLabel or chapter.title, 'span', pageLocale) }}</a>
  {% endif %}
  {% endfor %}
  {% if chapters and chapters[0] and chapters[0].railGroupLabel %}
  <p class="rt rt-sub" style="margin-top:16px">{{ bl.text({"en": "Practice & Exams", "ar": "التدريب والاختبارات"}, 'span', pageLocale) }}</p>
  {% endif %}
  {% if practiceSetId %}
  {% if isChapterPage or isSyllabusHub or isPracticePage %}
  <a href="{{ _locPrefix }}/{{ trackId }}/practice/" data-target="{{ practiceSetId }}" data-prefetch="1"{% if activeChapterId == practiceSetId %} class="active" aria-current="page"{% endif %}><span class="num">{{ practiceSetIcon or '§' }}</span>{% if practiceSetLabel %}{{ practiceSetLabel }}{% else %}{{ bl.text({"en": "Practice set", "ar": "مجموعة تدريبية"}, 'span', pageLocale) }}{% endif %}</a>
  {% else %}
  <a href="#{{ practiceSetId }}" data-target="{{ practiceSetId }}" onclick="goChapter('{{ practiceSetId }}'{% if not railNoTrackId %},'{{ trackId }}'{% endif %})"><span class="num">{{ practiceSetIcon or '§' }}</span>{% if practiceSetLabel %}{{ practiceSetLabel }}{% else %}{{ bl.text({"en": "Practice set", "ar": "مجموعة تدريبية"}, 'span', pageLocale) }}{% endif %}</a>
  {% endif %}
  {% endif %}
  {% if testGeneratorId %}
  {% if isChapterPage or isSyllabusHub or isPracticePage %}
  <a href="{{ _locPrefix }}/{{ trackId }}/#{{ testGeneratorId }}" data-target="{{ testGeneratorId }}"><span class="num">✎</span>{{ bl.text({"en": "Test generator", "ar": "مولّد الاختبارات"}, 'span', pageLocale) }}</a>
  {% else %}
  <a href="#{{ testGeneratorId }}" data-target="{{ testGeneratorId }}" onclick="goChapter('{{ testGeneratorId }}'{% if not railNoTrackId %},'{{ trackId }}'{% endif %})"><span class="num">✎</span>{{ bl.text({"en": "Test generator", "ar": "مولّد الاختبارات"}, 'span', pageLocale) }}</a>
  {% endif %}
  {% endif %}
  {% if downloadsId %}
  {% if isChapterPage or isSyllabusHub or isPracticePage %}
  <a href="{{ _locPrefix }}/{{ trackId }}/#{{ downloadsId }}" data-target="{{ downloadsId }}"><span class="num">↓</span>{{ bl.text({"en": "Downloads", "ar": "تنزيلات"}, 'span', pageLocale) }}</a>
  {% else %}
  <a href="#{{ downloadsId }}" data-target="{{ downloadsId }}" onclick="goChapter('{{ downloadsId }}'{% if not railNoTrackId %},'{{ trackId }}'{% endif %})"><span class="num">↓</span>{{ bl.text({"en": "Downloads", "ar": "تنزيلات"}, 'span', pageLocale) }}</a>
  {% endif %}
  {% endif %}
  {% if railExtra %}{{ railExtra | safe }}{% else %}
  <div class="mapper-wrap">
    <span class="mapper-label">{{ bl.text({"en": "Curriculum Mapping", "ar": "توافق المنهج"}, 'span', pageLocale) }}</span>
    <select class="nav-select" id="curriculum-select-{{ trackId }}" aria-label="Curriculum mapping" onchange="window.CSGamify&&window.CSGamify.mapCurriculum(this.value)">
      <option value="default">ClipSAT Standard</option>
      <option value="reveal-precalc">Reveal Pre-Calculus</option>
      <option value="cambridge-igcse">Cambridge &amp; Edexcel (IGCSE / A-Level)</option>
      <option value="collegeboard-sat">College Board &amp; ACT / EST</option>
      <option value="ib-diploma">IB Diploma (AA &amp; AI)</option>
      <option value="mena-qiyas">Qiyas (Qudrat / Tahsili / GAT)</option>
      <option value="university-stem">University STEM &amp; Olympiad</option>
    </select>
  </div>
  {% endif %}
</aside>
