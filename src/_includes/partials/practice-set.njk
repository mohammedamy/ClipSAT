{% import "partials/_bilingual.njk" as bl with context %}
{% set LVL_CLASS = {"Basic": "b", "Intermediate": "i", "Advanced": "a"} %}
<section class="chapter{% if isPracticePage %} ch-active{% endif %}" id="{{ sectionId }}">
  <div class="chead">
    <span class="cn">{{ practiceSet.icon or '§' }}</span>
    {% if isPracticePage %}
    <h1>{{ bl.text({"en": practiceHeadingEn or practiceSet.heading or "Practice set", "ar": practiceHeadingAr or "مجموعة تدريبية"}, 'span', pageLocale) }}</h1>
    {% else %}
    <h2>{{ bl.text({"en": practiceSet.heading or "Practice set", "ar": "مجموعة تدريبية"}, 'span', pageLocale) }}</h2>
    {% endif %}
  </div>
  {% if practiceSet.introText and pageLocale != 'ar' %}<p>{{ practiceSet.introText }}</p>{% elif pageLocale == 'ar' %}<p>مجموعة مسائل تدريبية متدرجة الصعوبة مع الرسوم التوضيحية والحلول الكاملة خطوة بخطوة.</p>{% endif %}
  {% if practiceParts and (practiceParts | length) > 1 %}
  <nav class="cs-practice-pager" aria-label="{{ 'أجزاء المجموعة التدريبية' if pageLocale == 'ar' else 'Practice set parts' }}">
    {% for pt in practiceParts %}
    <a class="btn{% if pt.partNum == practicePartNum %} primary{% endif %}" href="{{ pt.url }}" data-prefetch="1"{% if pt.partNum == practicePartNum %} aria-current="page"{% endif %}>{{ pt.label }}</a>
    {% endfor %}
  </nav>
  {% endif %}

  {% set _pItems = practiceItemsOverride or practiceSet.items %}
  {% if practiceSet.variant == 'compact' %}
    {% for item in _pItems %}
    <div class="problem"{% if item.id %} id="{{ item.id }}"{% endif %}>
      <div class="prow"><span class="pn">{{ item.number }}</span><span class="lvl">{{ item.difficulty }}</span>
        <div class="qt">{{ bl.text(item.question, 'div', pageLocale) }}</div>
      </div>
      {% if item.fig %}<div class="lesson-figure-svg" data-lazy-fig='{{ item.fig | jsonAttr | safe }}'></div>{% endif %}
      <div class="ps-item-actions">
        <button class="sol-toggle" onclick="this.closest('.problem').classList.toggle('open')"><span class="tw">▸</span> Show solution</button>
        <button type="button" class="cs-voice-btn no-print" onclick="window.CSVoiceTutor&&window.CSVoiceTutor.speakProblemSolution(this)" title="Listen to worked solution" aria-label="Listen to worked solution"><span>🔊</span><span>Listen</span></button>
        <button type="button" class="cs-flag-btn no-print" onclick="window.CSErrorFlagManager&&window.CSErrorFlagManager.openReportPopover(this,event)" title="Report an error in this question" aria-label="Report Error"><span>🚩</span><span class="cs-flag-lbl">Report Error</span></button>
      </div>
      <div class="solution">{{ bl.text(item.solution, 'div', pageLocale) }}</div>
    </div>
    {% endfor %}
  {% else %}
    {% for item in _pItems %}
    <div class="problem">
      <div class="ph">
        <span class="pn">{{ item.number }}</span>
        <div class="pq">{{ bl.text(item.question, 'div', pageLocale) }}</div>
        <span class="lvl {{ LVL_CLASS[item.difficulty] }}">{{ item.levelLabel or item.difficulty }}</span>
      </div>
      {% if item.fig %}<div class="lesson-figure-svg" data-lazy-fig='{{ item.fig | jsonAttr | safe }}'></div>{% endif %}
      <div class="ps-item-actions">
        <button class="sol-toggle" onclick="toggleSol(this)"><span class="tw">▸</span> Show solution</button>
        <button type="button" class="cs-voice-btn no-print" onclick="window.CSVoiceTutor&&window.CSVoiceTutor.speakProblemSolution(this)" title="Listen to worked solution" aria-label="Listen to worked solution"><span>🔊</span><span>Listen</span></button>
        <button type="button" class="cs-flag-btn no-print" onclick="window.CSErrorFlagManager&&window.CSErrorFlagManager.openReportPopover(this,event)" title="Report an error in this question" aria-label="Report Error"><span>🚩</span><span class="cs-flag-lbl">Report Error</span></button>
      </div>
      <div class="solution">{{ bl.text(item.solution, 'div', pageLocale) }}</div>
    </div>
    {% endfor %}
  {% endif %}
  {% if practiceParts and (practiceParts | length) > 1 %}
  <nav class="cs-practice-pager" aria-label="{{ 'أجزاء المجموعة التدريبية' if pageLocale == 'ar' else 'Practice set parts' }}">
    {% for pt in practiceParts %}
    <a class="btn{% if pt.partNum == practicePartNum %} primary{% endif %}" href="{{ pt.url }}" data-prefetch="1"{% if pt.partNum == practicePartNum %} aria-current="page"{% endif %}>{{ pt.label }}</a>
    {% endfor %}
  </nav>
  {% endif %}
  {% include "partials/ai-disclosure.njk" %}
</section>
