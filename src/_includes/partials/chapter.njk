{#
  Renders one chapter (course_schema.json #/definitions/chapter) — content/{track}/{chapter-slug}.json.

  Bilingual rendering: block-kind partials use the shared bilingual macro (docs/DECISIONS/0004),
  which pairs with index.html's window.i18n toggle (_applyToDOM()'s data-bilingual scan) — both
  languages render into the DOM and the SAME toggle button/JS the rest of the site already uses
  switches between them instantly, no page reload, no separate mechanism. The Chapter Quiz widget's
  labels reuse the EXISTING dictionary keys (quiz.chapterQuiz/count/level/generate) via the
  original data-i18n attribute — those keys already exist and are already used identically on
  every legacy track page, so there's no reason to duplicate them as new bilingual content.

  Expects: chapter (one chapter object)
#}
{% import "partials/_bilingual.njk" as bl %}
<section class="chapter" id="{{ chapter.id }}">
  <div class="chead">
    {% if chapter.chapterNumber %}<span class="cn">{{ chapter.chapterNumber }}</span>{% endif %}
    <h2>{{ bl.text(chapter.title) }}</h2>
  </div>

  {% for block in chapter.content.blocks %}
    {% if block.kind == 'callout' %}
      {% include "partials/blocks/callout.njk" %}
    {% elif block.kind == 'table' %}
      {% include "partials/blocks/table.njk" %}
    {% elif block.kind == 'cards' %}
      {% include "partials/blocks/cards.njk" %}
    {% elif block.kind == 'text' %}
      {% include "partials/blocks/text.njk" %}
    {% elif block.kind == 'explorer' %}
      {% include "partials/blocks/explorer.njk" %}
    {% endif %}
  {% endfor %}

  {% if chapter.quizWidget.enabled != false %}
  <div class="ch-quiz-wrap">
    <div class="ch-quiz-bar">
      <span class="ch-quiz-label">📝 <span data-i18n="quiz.chapterQuiz">Chapter Quiz</span></span>
      <div class="ch-quiz-controls">
        <label><span data-i18n="quiz.count">Questions</span>
          <select class="cq-count"><option>5</option><option selected>10</option><option>15</option><option>20</option><option>25</option><option>30</option></select>
        </label>
        <label><span data-i18n="quiz.level">Level</span>
          <select class="cq-level"><option value="all">All Levels</option><option value="Easy">Easy</option><option value="Medium">Medium</option><option value="Hard">Hard</option></select>
        </label>
        <button class="btn cq-btn" onclick="genChapterQuiz(this)"><span data-i18n="quiz.generate">Generate Quiz</span> ↻</button>
      </div>
    </div>
    <div class="cq-out"></div>
  </div>
  {% endif %}
</section>
