{#
  Renders one chapter (course_schema.json #/definitions/chapter) — content/{track}/{chapter-slug}.json.
  On single-chapter SSG routes (`isChapterPage == true`), renders `.ch-active` immediately, uses `<h1>`
  for the chapter title (unique page `<h1>` for WP-30), and appends Prev / Next chapter links.
#}
{% import "partials/_bilingual.njk" as bl with context %}
<section class="chapter{% if isChapterPage or loop.first %} ch-active{% endif %}" id="{{ chapter.id }}" data-chapter-id="{{ chapter.id }}">
  {% if chapter.subsectionBanner %}
  <div class="cs-subsection-banner">{{ bl.text(chapter.subsectionBanner, 'span', pageLocale) }}</div>
  {% endif %}
  <div class="chead">
    {% if chapter.chapterNumber %}<span class="cn">{{ chapter.chapterNumber }}</span>{% endif %}
    {% if isChapterPage %}
    <h1>{{ bl.text(chapter.title, 'span', pageLocale) }}</h1>
    {% else %}
    <h2>{{ bl.text(chapter.title, 'span', pageLocale) }}</h2>
    {% endif %}
  </div>

  {% if chapter.chapterTag %}
    {% set chapterTag = chapter.chapterTag %}
    {% include "partials/chapter-tag.njk" %}
  {% endif %}

  {% for block in chapter.content.blocks %}
    {% if block.kind == 'callout' %}
      {% include "partials/blocks/callout.njk" %}
    {% elif block.kind == 'table' %}
      {% include "partials/blocks/table.njk" %}
    {% elif block.kind == 'cards' %}
      {% include "partials/blocks/cards.njk" %}
    {% elif block.kind == 'text' %}
      {% include "partials/blocks/text.njk" %}
    {% elif block.kind == 'explorer' %}
      {% include "partials/blocks/explorer.njk" %}
    {% elif block.kind == 'practiceProblem' %}
      {% include "partials/blocks/practice-problem.njk" %}
    {% elif block.kind == 'workedExampleCard' %}
      {% include "partials/blocks/worked-example-card.njk" %}
    {% elif block.kind == 'syllabusMap' %}
      {% include "partials/blocks/syllabus-map.njk" %}
    {% elif block.kind == 'topicGrid' %}
      {% include "partials/blocks/topic-grid.njk" %}
    {% elif block.kind == 'seeAlso' %}
      {% include "partials/blocks/see-also.njk" %}
    {% elif block.kind == 'figure' %}
      {% include "partials/blocks/figure.njk" %}
    {% endif %}
  {% endfor %}

  {% if chapter.content.videos and chapter.content.videos.length %}
    <div class="cs-videos-section">
      {% for video in chapter.content.videos %}
        {% include "partials/video-embed.njk" %}
      {% endfor %}
    </div>
  {% endif %}

  {% if chapter.quizWidget.enabled != false %}
  <div class="ch-quiz-wrap" data-topic-id="{{ chapter.id }}"{% if chapter.quizWidget.domains %} data-quiz-domains="{{ chapter.quizWidget.domains | join('|') }}"{% endif %}>
    <div class="ch-quiz-bar">
      <span class="ch-quiz-label">📝 <span data-i18n="quiz.chapterQuiz">{% if pageLocale == 'ar' %}اختبار الفصل{% else %}Chapter Quiz{% endif %}</span></span>
      <div class="ch-quiz-controls">
        <label><span data-i18n="quiz.count">{% if pageLocale == 'ar' %}عدد الأسئلة{% else %}Questions{% endif %}</span>
          <select class="cq-count"><option>5</option><option selected>10</option><option>15</option><option>20</option><option>25</option><option>30</option></select>
        </label>
        <label><span data-i18n="quiz.level">{% if pageLocale == 'ar' %}المستوى{% else %}Level{% endif %}</span>
          <select class="cq-level"><option value="all">{% if pageLocale == 'ar' %}جميع المستويات{% else %}All Levels{% endif %}</option><option value="Easy">{% if pageLocale == 'ar' %}سهل{% else %}Easy{% endif %}</option><option value="Medium">{% if pageLocale == 'ar' %}متوسط{% else %}Medium{% endif %}</option><option value="Hard">{% if pageLocale == 'ar' %}صعب{% else %}Hard{% endif %}</option></select>
        </label>
        <button class="btn cq-btn" onclick="genChapterQuiz(this)"><span data-i18n="quiz.generate">{% if pageLocale == 'ar' %}إنشاء اختبار{% else %}Generate Quiz{% endif %}</span> ↻</button>
      </div>
    </div>
    <div class="cq-out"></div>
  </div>
  {% endif %}

  {% if isChapterPage and (prevChapter or nextChapter) %}
  {% set _locBase = ('/ar/' + trackId + '/') if pageLocale == 'ar' else ('/' + trackId + '/') %}
  <nav class="cs-chapter-pager" aria-label="{% if pageLocale == 'ar' %}التنقل بين الفصول{% else %}Chapter navigation{% endif %}">
    {% if prevChapter %}
    <a class="cs-pager-link cs-pager-prev" href="{{ _locBase }}{{ prevChapter.id }}/" data-prefetch="1">
      <span class="cs-pager-dir">{% if pageLocale == 'ar' %}→ الفصل السابق{% else %}← Previous Chapter{% endif %}</span>
      <span class="cs-pager-title">{% if prevChapter.num %}{{ prevChapter.num }} · {% endif %}{{ bl.text(prevChapter.title, 'span', pageLocale) }}</span>
    </a>
    {% else %}<span></span>{% endif %}
    {% if nextChapter %}
    <a class="cs-pager-link cs-pager-next" href="{{ _locBase }}{{ nextChapter.id }}/" data-prefetch="1">
      <span class="cs-pager-dir">{% if pageLocale == 'ar' %}الفصل التالي ←{% else %}Next Chapter →{% endif %}</span>
      <span class="cs-pager-title">{% if nextChapter.num %}{{ nextChapter.num }} · {% endif %}{{ bl.text(nextChapter.title, 'span', pageLocale) }}</span>
    </a>
    {% endif %}
  </nav>
  {% endif %}
</section>
