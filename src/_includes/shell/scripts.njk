  <script>
  (function(){
    var _origShowView = window.showView;
    if (window.__csInitRouteNav) window.__csInitRouteNav(_origShowView);
    var _routeShowView = window.showView;
    if (_routeShowView && _origShowView) {
      window.showView = function(name) {
        if (name && name === window.CLIPSAT_TRACK) return _origShowView(name);
        return _routeShowView(name);
      };
    }
    var prefetched = {};
    function maybePrefetch(ev){
      var a = ev.target && ev.target.closest ? ev.target.closest('a[data-prefetch="1"]') : null;
      if(!a) return;
      var url = a.getAttribute('data-chapter-url') || a.getAttribute('href');
      if(!url || url.charAt(0) === '#' || prefetched[url]) return;
      prefetched[url] = 1;
      try { var link = document.createElement('link'); link.rel = 'prefetch'; link.href = url; link.as = 'document'; document.head.appendChild(link); } catch(e){}
    }
    document.addEventListener('pointerenter', maybePrefetch, true);
    document.addEventListener('focusin', maybePrefetch, true);
  })();
  </script>
