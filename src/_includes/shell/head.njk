{% set _isAr = (pageLocale == 'ar') or isRtl %}
{% set _canonPath = canonicalPath or (('/' + trackId + '/') if trackId != 'home' else '/') %}
{% set _enAlt = enAltPath or (('/' + trackId + '/') if trackId != 'home' else '/') %}
{% set _subjectTracks = ['calculus','algebra','apab','apbc','igcse','alg2','geo','qudrat','tahsili','sat','act','aslevel','a2level','est','est2','est2l2','act2','act2l2','precalc','appc','apstats','ibsl','ibhl','linalg','mvc','odes','addmath','mathai','edexcel','gaten','olympiad'] %}
{% set _arAlt = arAltPath or (('/ar/' + trackId + '/') if (trackId in _subjectTracks) else '') %}
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/vendor/fonts/fonts.css">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="theme-color" content="#1E3A6E">
  <meta name="application-name" content="ClipSAT">
  <meta http-equiv="X-Content-Type-Options" content="nosniff">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self' https:; script-src 'self' 'unsafe-inline' https://apis.google.com https://accounts.google.com https://pagead2.googlesyndication.com https://www.desmos.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://*.supabase.co https://*.googleapis.com https://raw.githubusercontent.com; frame-src 'self' blob: https://www.desmos.com https://accounts.google.com https://docs.google.com https://www.youtube-nocookie.com https://www.youtube.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com; object-src 'self' blob:; base-uri 'self';">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png?v=2">
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png?v=2">
  <link rel="apple-touch-icon" href="/icon-192.png?v=2">
  <link rel="canonical" href="https://clipsat.org{{ _canonPath }}">
  <link rel="alternate" hreflang="en" href="https://clipsat.org{{ _enAlt }}">
  {% if _arAlt %}<link rel="alternate" hreflang="ar" href="https://clipsat.org{{ _arAlt }}">{% endif %}
  <link rel="alternate" hreflang="x-default" href="https://clipsat.org{{ _enAlt }}">
  <meta property="og:type" content="{{ 'article' if (isChapterPage or isPracticePage) else 'website' }}">
  <meta property="og:site_name" content="ClipSAT">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="https://clipsat.org{{ _canonPath }}">
  <meta property="og:image" content="https://clipsat.org/og-image.png">
  <meta property="og:locale" content="{{ 'ar_SA' if _isAr else 'en_US' }}">
  <meta name="twitter:card" content="summary_large_image">
  {% if isChapterPage or isPracticePage %}
  <script type="application/ld+json">{"@context":"https://schema.org","@type": "LearningResource","name":{{ title | dump | safe }},"description":{{ description | dump | safe }},"url":"https://clipsat.org{{ _canonPath }}","inLanguage":"{{ 'ar' if _isAr else 'en' }}","learningResourceType":["Lesson","Worked Examples","Practice Quiz"],"educationalUse":["Self-Study","Classroom Instruction","Exam Preparation"],"isAccessibleForFree":true,"isPartOf":{"@type": "Course","name":{{ (courseTitle or trackId) | dump | safe }},"url":"https://clipsat.org{{ '/ar/' + trackId + '/' if _isAr else '/' + trackId + '/' }}"},"provider":{"@type":"Organization","name":"ClipSAT","sameAs":"https://clipsat.org/"}}</script>
  {% elif trackId in _subjectTracks %}
  <script type="application/ld+json">{"@context":"https://schema.org","@type": "Course","name":{{ title | dump | safe }},"description":{{ description | dump | safe }},"url":"https://clipsat.org{{ _canonPath }}","inLanguage":"{{ 'ar' if _isAr else 'en' }}","isAccessibleForFree":true,"provider":{"@type":"Organization","name":"ClipSAT","sameAs":"https://clipsat.org/"}}</script>
  {% endif %}
  {% if trackId == 'home' or trackId == 'about' %}
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"Person","name":"Mohamed Abdallah","jobTitle":"Mathematics Teacher","url":"https://clipsat.org/","worksFor":{"@type":"Organization","name":"ClipSAT","url":"https://clipsat.org/"},"sameAs":["https://wa.me/966597688647","https://t.me/ClipSAT22","https://www.youtube.com/@ClipSAT22"]}</script>
  {% endif %}
  <link rel="stylesheet" href="/vendor/katex/katex.min.css" integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+" crossorigin="anonymous">
  <script>window.MathJax={typeset:function(){},typesetPromise:function(){return Promise.resolve();},startup:{promise:Promise.resolve()}};window.CSRenderMathString=function(s){return s;};</script>
  <script defer src="/vendor/katex/katex.min.js" integrity="sha384-7zkQWkzuo3B5mTepMUcHkMB5jZaolc2xDwL6VFqjFALcbeS9Ggm/Yr2r3Dy4lfFg" crossorigin="anonymous"></script>
  <script defer src="/vendor/katex/contrib/auto-render.min.js" integrity="sha384-43gviWU0YVjaDtb/GhzOouOXtZMP/7XUzwPTstBeZFe/+rCMvRwr4yROQP43s0Xk" crossorigin="anonymous"></script>
  <script defer src="/js/katex-runtime.js?v=20261126b"></script>
  <script defer src="/vendor/jszip/jszip.min.js"></script>
  <script defer src="/vendor/dompurify/purify.min.js"></script>
