---
layout: base.njk
trackId: contact
title: "Contact & Support · ClipSAT"
description: "Contact ClipSAT support via email at support@clipsat.org, send a message through our contact form, or connect via optional educator channels."
isRtl: false
---
<main class="view active" id="view-contact">
  <div class="wrap" style="max-width:760px; margin:0 auto; padding:40px 20px 80px">
    
    <header style="margin-bottom:32px">
      <span class="eyebrow" style="color:var(--indigo); font-weight:700; text-transform:uppercase; letter-spacing:.08em; font-size:.8rem">Support &amp; Inquiries</span>
      <h1 style="font-size:2.4rem; font-weight:900; color:var(--text); margin:8px 0 12px; letter-spacing:-.02em">Contact Us</h1>
      <p style="color:var(--muted); font-size:1.1rem; line-height:1.6">
        Have a question about your account, ClipSAT Plus, curriculum content, or mathematics tutoring? We are here to help.
      </p>
    </header>

    <!-- Support Options Grid -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:20px; margin-bottom:36px">
      
      <!-- Email Support Card -->
      <div style="background:var(--panel, #fff); border:1.5px solid var(--line); border-radius:12px; padding:24px; box-shadow:var(--shadow-sm)">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px">
          <span style="display:inline-flex; align-items:center; justify-content:center; width:40px; height:40px; border-radius:8px; background:var(--indigo-soft, rgba(30,58,110,0.08)); color:var(--indigo)">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          </span>
          <div>
            <h3 style="margin:0; font-size:1.1rem; color:var(--text)">Email Support</h3>
            <span style="font-size:.82rem; color:var(--muted)">Primary Support Desk</span>
          </div>
        </div>
        <p style="font-size:.9rem; color:var(--muted); line-height:1.5; margin:0 0 16px">
          For technical issues, billing, refund requests, and general questions:
        </p>
        <a href="mailto:support@clipsat.org" style="display:inline-block; font-weight:700; color:var(--indigo); text-decoration:underline; font-size:.95rem">support@clipsat.org</a>
      </div>

      <!-- AI Tutor Instant Help Card -->
      <div style="background:var(--panel, #fff); border:1.5px solid var(--line); border-radius:12px; padding:24px; box-shadow:var(--shadow-sm)">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px">
          <span style="display:inline-flex; align-items:center; justify-content:center; width:40px; height:40px; border-radius:8px; background:rgba(16, 185, 129, 0.1); color:#059669">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.38-1 1.72V7h2a7 7 0 0 1 7 7v1a3 3 0 0 1-3 3h-1.18A3 3 0 0 1 15 21H9a3 3 0 0 1-2.82-2H5a3 3 0 0 1-3-3v-1a7 7 0 0 1 7-7h2V5.72A2 2 0 0 1 10 4a2 2 0 0 1 2-2zm-4 9a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm8 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z"/></svg>
          </span>
          <div>
            <h3 style="margin:0; font-size:1.1rem; color:var(--text)">ClipSAT AI Tutor</h3>
            <span style="font-size:.82rem; color:var(--muted)">Instant Problem Walkthroughs</span>
          </div>
        </div>
        <p style="font-size:.9rem; color:var(--muted); line-height:1.5; margin:0 0 10px">
          Stuck on a specific math problem right now? Open the floating <strong>"ClipSAT AI Tutor"</strong> button in the bottom-right corner.
        </p>
        <p style="font-size:.8rem; color:var(--muted); font-style:italic; margin:0">
          AI-generated; may contain errors; not a substitute for teacher instruction.
        </p>
      </div>

    </div>

    <!-- Contact Form Section -->
    <section style="background:var(--panel, #fff); border:1.5px solid var(--line); border-radius:12px; padding:28px 24px; margin-bottom:40px; box-shadow:var(--shadow-sm)">
      <h2 style="font-size:1.35rem; font-weight:800; color:var(--text); margin:0 0 6px">Send a Direct Message</h2>
      <p style="color:var(--muted); font-size:.92rem; margin:0 0 20px">
        Fill out this form and our support team will respond to your email address within 24 to 48 business hours.
      </p>

      <form id="contact-form" onsubmit="event.preventDefault(); window.submitClipSATContact();" style="display:flex; flex-direction:column; gap:16px">
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:16px">
          <div>
            <label for="contact-name" style="display:block; font-size:.85rem; font-weight:700; color:var(--text); margin-bottom:6px">Your Name</label>
            <input type="text" id="contact-name" required placeholder="Student or Educator Name" style="width:100%; box-sizing:border-box; padding:10px 12px; border:1.5px solid var(--line); border-radius:8px; font-size:.92rem; background:var(--bg)">
          </div>
          <div>
            <label for="contact-email" style="display:block; font-size:.85rem; font-weight:700; color:var(--text); margin-bottom:6px">Your Email Address</label>
            <input type="email" id="contact-email" required placeholder="you@example.com" style="width:100%; box-sizing:border-box; padding:10px 12px; border:1.5px solid var(--line); border-radius:8px; font-size:.92rem; background:var(--bg)">
          </div>
        </div>

        <div>
          <label for="contact-subject" style="display:block; font-size:.85rem; font-weight:700; color:var(--text); margin-bottom:6px">Topic / Category</label>
          <select id="contact-subject" style="width:100%; box-sizing:border-box; padding:10px 12px; border:1.5px solid var(--line); border-radius:8px; font-size:.92rem; background:var(--bg); color:var(--text)">
            <option value="General Inquiry">General Inquiry</option>
            <option value="ClipSAT Plus &amp; Billing">ClipSAT Plus &amp; Billing (Refunds / Cancellations)</option>
            <option value="Math Content Correction">Math Content / Question Correction</option>
            <option value="Technical Issue">Technical Bug or Feature Suggestion</option>
            <option value="Private Tutoring Inquiry">1:1 Tutoring Inquiry with Mr. Mohamed</option>
          </select>
        </div>

        <div>
          <label for="contact-message" style="display:block; font-size:.85rem; font-weight:700; color:var(--text); margin-bottom:6px">Message</label>
          <textarea id="contact-message" rows="5" required placeholder="Describe your question, request, or issue with as much detail as possible..." style="width:100%; box-sizing:border-box; padding:10px 12px; border:1.5px solid var(--line); border-radius:8px; font-size:.92rem; background:var(--bg); line-height:1.5"></textarea>
        </div>

        <div>
          <button type="submit" class="btn" style="background:var(--indigo); color:#fff; font-weight:700; padding:12px 24px; border-radius:8px; cursor:pointer; border:none; font-size:.95rem">
            Send Message to Support
          </button>
        </div>
        <div id="contact-status" style="font-size:.9rem; margin-top:8px; display:none"></div>
      </form>
    </section>

    <!-- Optional Direct Educator & Community Channels -->
    <section style="margin-bottom:40px">
      <h2 style="font-size:1.35rem; font-weight:800; color:var(--text); margin-bottom:8px; border-bottom:2px solid var(--line); padding-bottom:8px">
        Optional Direct Educator &amp; Community Channels
      </h2>
      <p style="color:var(--muted); font-size:.92rem; line-height:1.6; margin-bottom:16px">
        For direct 1:1 tutoring consultations or quick inquiries, you can also reach senior educator <strong>Mr. Mohamed Abdallah</strong> directly on WhatsApp or Telegram. Community updates are shared across YouTube and Instagram.
      </p>

      <div class="social-row" style="margin:20px 0; display:flex; flex-wrap:wrap; gap:12px">
