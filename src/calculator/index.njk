      descAr: 'معيار المحصلة ح عند تغير الزاوية ي بين ٠ و ١٨٠ درجة.',
      latex: 'R(\\theta) = \\sqrt{F_1^2 + F_2^2 + 2 F_1 F_2 \\cos(\\theta)}',
      expressions: ['F_1 = 30', 'F_2 = 40', 'R(x) = \\sqrt{F_1^2 + F_2^2 + 2 F_1 F_2 \\cos(x)} \\left\\{0 \\le x \\le \\pi\\right\\}'] },
    { id: 'dyn_shm_motion', category: 'statics_dynamics', mode: 'graphing',
      titleEn: 'Simple Harmonic Motion Displacement & Velocity', titleAr: 'الحركة التوافقية البسيطة: الإزاحة والسرعة والزمن',
      descEn: 'Sinusoidal displacement x(t) and velocity v(t) showing 90-degree phase shift.',
      descAr: 'منحنى الإزاحة والسرعة مع فرق الطور بمقدار ٩٠ درجة.',
      latex: 'x(t) = A\\cos(\\omega t),\\quad v(t) = -A\\omega\\sin(\\omega t)',
      expressions: ['A = 5', 'w = 2', 'x(t) = A \\cos(w \\cdot t)', 'v(t) = -A \\cdot w \\cdot \\sin(w \\cdot t)'] },

    { id: 'sci_combinatorics', category: 'scientific', mode: 'scientific',
      titleEn: 'Combinations & Permutations (nCr & nPr)', titleAr: 'التوافيق والتباديل ومضروب العدد (ق، ل، !)',
      descEn: 'Official high-frequency Thanaweya combinatorics operations.',
      descAr: 'حساب التباديل والتوافيق والمضاريب لمنهج الجبر المصري.',
      latex: 'nCr(10, 3) = 120,\\quad nPr(10, 3) = 720,\\quad 7! = 5040',
      expressions: ['nCr(10, 3)', 'nPr(10, 3)', '7!'] }
  ];

  var CATS = ['all', 'calculus', 'solid_3d', 'statics_dynamics', 'scientific'];

  var presetsToggle = document.getElementById('calc-presets-toggle');
  var presetsPanel = document.getElementById('calc-presets-panel');
  var presetsClose = document.getElementById('calc-presets-close');
  var presetsCatsEl = document.getElementById('calc-presets-cats');
  var presetsListEl = document.getElementById('calc-presets-list');
  var presetsCountEl = presetsToggle ? presetsToggle.querySelector('.calc-presets-count') : null;
  var toastEl = document.getElementById('calc-toast');
  var selectedCategory = 'all';
  var presetsOpen = false;
  var toastTimer = null;

  function tt(key, vars) {
    return (window.i18n && window.i18n.t) ? window.i18n.t(key, vars) : key;
  }
  function isAr() {
    return (window.i18n && window.i18n.getLocale) ? window.i18n.getLocale() === 'ar' : false;
  }

  // KaTeX is loaded `defer` site-wide (see base.njk) so it may not be ready
  // the instant the presets panel first renders — poll briefly rather than
  // silently leaving the raw LaTeX source (already shown as a fallback) up
  // forever if a card renders before KaTeX finishes loading.
  function renderMathInto(el, latex, attempt) {
    attempt = attempt || 0;
    if (window.katex) {
      try {
        el.innerHTML = window.katex.renderToString(latex, { throwOnError: false });
      } catch (e) { /* leave the raw-text fallback already in el */ }
      return;
    }
    if (attempt < 20) setTimeout(function () { renderMathInto(el, latex, attempt + 1); }, 100);
  }

  function showToast(msg) {
    if (!toastEl) return;
    toastEl.textContent = msg;
    toastEl.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { toastEl.hidden = true; }, 4000);
  }

  function copyPreset(preset, btnEl) {
    var text = preset.expressions.join('\n');
    var onDone = function () {
      showToast(tt('calc.presets.copiedToast', { n: preset.expressions.length }));
      if (btnEl) {
        var original = btnEl.textContent;
        btnEl.textContent = '✓';
        setTimeout(function () { btnEl.textContent = original; }, 1500);
      }
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(onDone, function () {});
    }
  }

  function applyPreset(preset) {
    selectMode(preset.mode);
    copyPreset(preset);
  }

  function renderCats() {
    if (!presetsCatsEl) return;
    presetsCatsEl.innerHTML = '';
    CATS.forEach(function (cat) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'calc-cat-pill' + (cat === selectedCategory ? ' on' : '');
      btn.textContent = tt('calc.presets.cat.' + cat);
      btn.addEventListener('click', function () {
        selectedCategory = cat;
        renderCats();
        renderList();
      });
      presetsCatsEl.appendChild(btn);
    });
  }

  function renderList() {
    if (!presetsListEl) return;
    presetsListEl.innerHTML = '';
    PRESETS
      .filter(function (p) { return selectedCategory === 'all' || p.category === selectedCategory; })
      .forEach(function (preset) {
        var card = document.createElement('div');
        card.className = 'calc-preset-card';

        var head = document.createElement('div');
        head.className = 'calc-preset-head';
        var badge = document.createElement('span');
        badge.className = 'calc-preset-mode-badge';
        badge.textContent = preset.mode === 'threeD' ? '3D' : preset.mode.slice(0, 3).toUpperCase();
        var title = document.createElement('h4');
        title.textContent = isAr() ? preset.titleAr : preset.titleEn;
        head.appendChild(badge);
        head.appendChild(title);
        card.appendChild(head);

        var desc = document.createElement('p');
        desc.className = 'calc-preset-desc';
        desc.textContent = isAr() ? preset.descAr : preset.descEn;
        card.appendChild(desc);

        if (preset.latex) {
          var mathBox = document.createElement('div');
          mathBox.className = 'calc-preset-math';
          mathBox.textContent = preset.latex; // shown as-is until KaTeX (loaded deferred site-wide) is ready
          card.appendChild(mathBox);
          renderMathInto(mathBox, preset.latex);
        }

        var actions = document.createElement('div');
        actions.className = 'calc-preset-actions';
        var applyBtn = document.createElement('button');
        applyBtn.type = 'button';
        applyBtn.className = 'calc-preset-apply';
        applyBtn.textContent = tt('calc.presets.apply');
        applyBtn.addEventListener('click', function () { applyPreset(preset); });
        var copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'calc-preset-copy';
        copyBtn.title = tt('calc.presets.copy');
        copyBtn.setAttribute('aria-label', tt('calc.presets.copy'));
        copyBtn.textContent = '📋';
        copyBtn.addEventListener('click', function () { copyPreset(preset, copyBtn); });
        actions.appendChild(applyBtn);
        actions.appendChild(copyBtn);
        card.appendChild(actions);

        presetsListEl.appendChild(card);
      });
  }

  function openPresets() {
    presetsOpen = true;
    presetsPanel.hidden = false;
    presetsToggle.setAttribute('aria-expanded', 'true');
  }
  function closePresets() {
    presetsOpen = false;
    presetsPanel.hidden = true;
    presetsToggle.setAttribute('aria-expanded', 'false');
  }

  if (presetsToggle) {
    presetsToggle.addEventListener('click', function () {
      if (presetsOpen) closePresets(); else openPresets();
    });
  }
  if (presetsClose) presetsClose.addEventListener('click', closePresets);

  // The language toggle applies live (no page reload — see engine.js's
  // setLocale) but the preset cards are plain rendered text, not
  // [data-i18n] elements, so re-render them on every language switch to
  // pick up the new locale's title/desc/UI strings.
  var i18nBtn = document.getElementById('i18n-toggle-btn');
  if (i18nBtn) {
    i18nBtn.addEventListener('click', function () {
      setTimeout(function () { renderCats(); renderList(); }, 0);
    });
  }

  if (presetsCountEl) presetsCountEl.textContent = '(' + PRESETS.length + ')';

  // window.i18n (engine.js) loads via a plain, non-deferred <script> placed
  // AFTER this page's own content in base.njk, so it doesn't exist yet at
  // this point in a normal top-to-bottom parse — tt()/isAr() would silently
  // fall back to raw keys / English if the first render ran right now.
  // Poll briefly (same technique as mountExam's wait for window.Desmos
  // above) rather than rendering once, wrong, and only fixing it on the
  // user's first language-toggle click.
  function initPresetsUI(attempt) {
    attempt = attempt || 0;
    if (!window.i18n && attempt < 50) {
      setTimeout(function () { initPresetsUI(attempt + 1); }, 20);
      return;
    }
    renderCats();
    renderList();
  }
  initPresetsUI();
})();
</script>
