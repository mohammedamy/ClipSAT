        'Expected Value: E[X] = μ = ' + lam + ' · Var(X) = σ² = ' + lam + ' · SD = σ = ' + Math.sqrt(lam).toFixed(3) +
        '</div>';

      var W = 520, H = 220, pad = 36;
      var maxVal = Math.max(12, Math.ceil(lam * 2.8));
      var probs = [];
