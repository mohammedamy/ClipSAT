<!-- Desmos setup, matching the ClipSAT for Egypt sister site
     (mohammedamy.github.io/EGBaccalaureate): Graphing, 3D, Scientific, and
     Geometry are plain iframe embeds of the real desmos.com web app
     (?embed URLs) rather than the JS API — no API key needed for those four,
     and they pick up Desmos's own feature set exactly since it IS the real
     site, just framed. Exam Mode is the one mode that still needs the JS
     API (calculator.js below): iframes can't apply Desmos's
     restrictedFunctions/authorFeatures/etc. options, so the only way to get
     a genuinely restricted skin is GraphingCalculator(container, EXAM_OPTS).
     Trade-off versus the iframe modes: the embedded desmos.com page renders
     in Desmos's own light UI regardless of ClipSAT's dark mode (a plain
     iframe can't be handed our --theme), where Exam Mode's JS-API instance
     still respects it via invertedColors. -->
<script defer src="https://www.desmos.com/api/v1.11/calculator.js?apiKey=dcb31709b452b1cf9dc26972add0fda6"></script>
<script>
(function () {
  'use strict';

  // Exam Mode: Desmos's own documented restriction options, matching the
  // feature set real testing platforms configure — no images/notes/folders
  // to paste in outside content, no author tools, and a locked-down function
  // set (restrictedFunctions) that mirrors what a real exam calculator allows.
  var EXAM_OPTS = {
    authorFeatures: false,
    images: false,
    folders: false,
    notes: false,
    restrictedFunctions: true,
    pasteGraphLink: false,
    pasteTableData: false,
    settingsMenu: false
  };

  var IFRAME_MODES = {
    graphing:   { embed: 'https://www.desmos.com/calculator?embed',  external: 'https://www.desmos.com/calculator' },
    threeD:     { embed: 'https://www.desmos.com/3d?embed',          external: 'https://www.desmos.com/3d' },
    scientific: { embed: 'https://www.desmos.com/scientific?embed',  external: 'https://www.desmos.com/scientific' },
    geometry:   { embed: 'https://www.desmos.com/geometry?embed',    external: 'https://www.desmos.com/geometry' }
  };

  var container = document.getElementById('calc-container');
  var externalLink = document.getElementById('calc-external-link');
  var buttons = Array.prototype.slice.call(document.querySelectorAll('.calc-mode-btn'));
  var apiInstance = null; // the live Desmos.GraphingCalculator instance, when Exam Mode is mounted
  var mountToken = 0;     // guards against a delayed Exam Mode API-ready callback mounting after the user has switched away

  function isDark() {
    return document.documentElement.getAttribute('data-theme') === 'dark';
  }

  function destroyApiInstance() {
    if (apiInstance && typeof apiInstance.destroy === 'function') apiInstance.destroy();
    apiInstance = null;
  }

  function mountIframe(modeKey) {
    destroyApiInstance();
    container.innerHTML = '';
    var cfg = IFRAME_MODES[modeKey];
    var frame = document.createElement('iframe');
    frame.src = cfg.embed;
    frame.title = 'Desmos ' + modeKey + ' calculator';
    frame.setAttribute('allow', 'clipboard-read; clipboard-write; fullscreen');
    container.appendChild(frame);
    if (externalLink) {
      externalLink.href = cfg.external;
      externalLink.hidden = false;
    }
  }

  function mountExam(token) {
    if (!window.Desmos || typeof window.Desmos.GraphingCalculator !== 'function') {
      // Only visible if calculator.js hasn't finished loading yet (rare —
      // it's a deferred script fetched from page load) — without this the
      // container would otherwise keep silently showing whichever mode was
      // selected before Exam Mode while this polls in the background.
      destroyApiInstance();
      container.innerHTML = '<div class="calc-loading">' +
        ((window.i18n && window.i18n.t) ? window.i18n.t('calc.loadingExam') : 'Loading Exam Mode…') +
        '</div>';
      if (externalLink) externalLink.hidden = true;
      setTimeout(function () { if (token === mountToken) mountExam(token); }, 50);
      return;
    }
    if (token !== mountToken) return; // user switched to a different mode while we were waiting
    destroyApiInstance();
    container.innerHTML = '';
    apiInstance = window.Desmos.GraphingCalculator(container, Object.assign({ invertedColors: isDark() }, EXAM_OPTS));
    if (externalLink) externalLink.hidden = true; // no public URL for this restricted config
  }

  function mount(modeKey) {
    if (!container) return;
    mountToken += 1;
    if (modeKey === 'exam') {
      mountExam(mountToken);
    } else if (IFRAME_MODES[modeKey]) {
      mountIframe(modeKey);
    }
  }

  function selectMode(modeKey) {
    buttons.forEach(function (b) {
      b.setAttribute('aria-selected', String(b.dataset.mode === modeKey));
    });
    mount(modeKey);
  }

  buttons.forEach(function (b) {
    b.addEventListener('click', function () { selectMode(b.dataset.mode); });
  });

  selectMode('graphing');

  /* ===================== Curriculum presets drawer =====================
     Ported verbatim (titles/descriptions/LaTeX/expressions) from the
     ClipSAT for Egypt sister site's src/data/desmosPresets.ts, with only
     the `mode` values remapped to this page's mode keys: their '2d'/'3d'
     become this page's 'graphing'/'threeD' ('scientific' is unchanged;
     none of their presets use 'geometry'). */
  var PRESETS = [
    { id: 'calc_tangent_normal', category: 'calculus', mode: 'graphing',
      titleEn: 'Tangent & Normal to a Cubic Curve', titleAr: 'مماس وعمودي لمنحنى دالة تكعيبية',
      descEn: 'Dynamic tangent and normal line at point a on cubic function f(x) = x³ - 3x.',
      descAr: 'مماس وعمودي ديناميكي عند النقطة a على منحنى الدالة التكعيبية د(س) = س³ - ٣س.',
      latex: 'f(x) = x^3 - 3x,\\quad y - f(a) = f\'(a)(x - a)',
      expressions: ['f(x) = x^3 - 3x', 'a = 1', '(a, f(a))', 'y - f(a) = f\'(a)(x - a)', 'y - f(a) = -\\frac{1}{f\'(a)}(x - a)'] },
    { id: 'calc_extrema_inflection', category: 'calculus', mode: 'graphing',
      titleEn: 'Critical Points & Point of Inflection', titleAr: 'النقاط الحرجة ونقطة الانقلاب وفترات التحدب',
      descEn: 'Plot function alongside its first and second derivatives to analyze concavity.',
      descAr: 'تمثيل الدالة مع المشتقة الأولى والثانية لتحليل التحدب لأعلى ولأسفل ونقط الانقلاب.',
      latex: 'f(x) = 2x^3 - 9x^2 + 12x + 1,\\quad f\'(x),\\quad f\'\'(x)',
      expressions: ['f(x) = 2x^3 - 9x^2 + 12x + 1', 'f\'(x)', 'f\'\'(x)', '(1, f(1))', '(2, f(2))', '(1.5, f(1.5))'] },
    { id: 'calc_trig_reciprocals', category: 'calculus', mode: 'graphing',
      titleEn: 'Secant & Cosecant Graphs & Asymptotes', titleAr: 'منحنيات القاطع وقاطع التمام وخطوط التقارب الرأسية',
      descEn: 'Visualize sec(x) and csc(x) with their characteristic vertical asymptotes.',
      descAr: 'رسم قا(س) وقتا(س) وتوضيح خطوط التقارب الرأسية ودورات الدوال.',
      latex: 'y = \\sec(x),\\quad y = \\csc(x)',
      expressions: ['y = \\sec(x)', 'y = \\csc(x)', 'x = \\frac{\\pi}{2} + k\\pi'] },
    { id: 'calc_exponential_log', category: 'calculus', mode: 'graphing',
      titleEn: 'Natural Exponential & Natural Logarithm', titleAr: 'الدالة الأسية الطبيعية واللوغاريتم الطبيعي (الأساس هـ)',
      descEn: 'Inverse function relationship across line y = x and slope at x = 1.',
      descAr: 'علاقة الانعكاس حول المستقيم ص = س وميل المماس عند س = ١.',
      latex: 'y = e^x,\\quad y = \\ln(x),\\quad y = x',
      expressions: ['y = e^x', 'y = \\ln(x)', 'y = x', '(1, 0)', '(0, 1)'] },
    { id: 'calc_area_between_curves', category: 'calculus', mode: 'graphing',
      titleEn: 'Area Enclosed Between Two Curves', titleAr: 'المساحة المحصورة بين منحنيين',
      descEn: 'Region bounded by parabola y = 4 - x² and straight line y = x + 2.',
      descAr: 'المنطقة المحصورة بين المنحنى ص = ٤ - س² والمستقيم ص = س + ٢.',
      latex: 'y_1 = 4 - x^2,\\quad y_2 = x + 2,\\quad \\int_{-2}^1 (y_1 - y_2)\\,dx',
      expressions: ['f(x) = 4 - x^2', 'g(x) = x + 2', 'x + 2 \\le y \\le 4 - x^2 \\left\\{-2 \\le x \\le 1\\right\\}'] },

    { id: 'solid_plane_standard', category: 'solid_3d', mode: 'threeD',
      titleEn: 'Equation of Plane & Normal Vector in R³', titleAr: 'معادلة المستوى ومتجه الاتجاه العمودي ن في الفراغ',
      descEn: 'Plane 2x + 3y + 4z = 12 with normal vector n = (2, 3, 4) and axis intercepts.',
      descAr: 'المستوى ٢س + ٣ص + ٤ع = ١٢ مع متجه العمودي ن = (٢، ٣، ٤) والأجزاء المقطوعة من المحاور.',
      latex: '2x + 3y + 4z = 12,\\quad \\vec{n} = (2, 3, 4)',
      expressions: ['2x + 3y + 4z = 12', 'x/6 + y/4 + z/3 = 1', '(6, 0, 0)', '(0, 4, 0)', '(0, 0, 3)'] },
    { id: 'solid_sphere_shifted', category: 'solid_3d', mode: 'threeD',
      titleEn: 'Sphere in Space with Center & Radius', titleAr: 'معادلة الكرة في الفراغ بمعلومية المركز ونصف القطر',
      descEn: 'Sphere with center (2, -3, 4) and radius R = 4.',
      descAr: 'كرة مركزها م(٢، -٣، ٤) ونصف قطرها نق = ٤ وحدات طول.',
      latex: '(x - 2)^2 + (y + 3)^2 + (z - 4)^2 = 16',
      expressions: ['(x - 2)^2 + (y + 3)^2 + (z - 4)^2 = 16', '(2, -3, 4)'] },
    { id: 'solid_intersecting_planes', category: 'solid_3d', mode: 'threeD',
      titleEn: 'Line of Intersection of Two Planes', titleAr: 'خط تقاطع مستويين في الفراغ ثلاثي الأبعاد',
      descEn: 'Simultaneous intersection of x + y + z = 3 and 2x - y + z = 1.',
