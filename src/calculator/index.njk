      '</div>',
      '<div class="calc-dist-display">',
      '  <div class="calc-dist-result" id="sc-t-res"></div>',
      '  <div class="calc-dist-graph-card" id="sc-t-graph"></div>',
      '</div>'
    ].join('');

    var dfIn = el.querySelector('#sc-t-df');
    var lowIn = el.querySelector('#sc-t-lower');
    var upIn = el.querySelector('#sc-t-upper');
    var resEl = el.querySelector('#sc-t-res');
    var graphEl = el.querySelector('#sc-t-graph');

    function update() {
      var df = parseInt(dfIn.value, 10) || 1;
      var a = parseFloat(lowIn.value);
      var b = parseFloat(upIn.value);
      if (isNaN(a)) a = -Infinity;
      if (isNaN(b)) b = Infinity;

      var pA = (a === -Infinity) ? 0 : _tCdf(a, df);
      var pB = (b === Infinity) ? 1 : _tCdf(b, df);
      var prob = Math.max(0, pB - pA);

      resEl.innerHTML = '<div style="font-size:12px;font-weight:700;color:var(--muted)">STUDENT\'S T PROBABILITY</div>' +
        '<div class="calc-dist-result-prob">P(' + (a === -Infinity ? '−∞' : a) + ' ≤ T ≤ ' + (b === Infinity ? '+∞' : b) + ') = ' + prob.toFixed(5) + '</div>' +
        '<div class="calc-dist-result-meta">Degrees of freedom df = ' + df + ' · Heavy tails model uncertainty in small sample sizes (AP Stats / Cambridge 9709 P6)</div>';

      var W = 520, H = 220, pad = 36;
      var minX = -4.5, maxX = 4.5;
      function sx(x) { return pad + (x - minX) / (maxX - minX) * (W - 2 * pad); }
      function sy(y) { return H - pad - y * (H - 2 * pad) / 0.42; }

      var d = 'M', dShade = 'M', inShade = false, steps = 100;
      for (var i = 0; i <= steps; i++) {
        var curX = minX + i * (maxX - minX) / steps;
        var curY = _tPdf(curX, df);
        var px = sx(curX), py = sy(curY);
        d += (i === 0 ? '' : 'L') + px.toFixed(1) + ',' + py.toFixed(1);

        if (curX >= Math.max(minX, a) && curX <= Math.min(maxX, b)) {
          if (!inShade) {
            dShade += px.toFixed(1) + ',' + (H - pad) + ' L' + px.toFixed(1) + ',' + py.toFixed(1);
            inShade = true;
          } else {
            dShade += ' L' + px.toFixed(1) + ',' + py.toFixed(1);
          }
        } else if (inShade) {
          dShade += ' L' + px.toFixed(1) + ',' + (H - pad);
          inShade = false;
        }
      }
      if (inShade) dShade += ' L' + sx(Math.min(maxX, b)).toFixed(1) + ',' + (H - pad);

      var svg = '<svg width="100%" height="200" viewBox="0 0 ' + W + ' ' + H + '" style="display:block">';
      svg += '<line x1="' + pad + '" y1="' + (H - pad) + '" x2="' + (W - pad) + '" y2="' + (H - pad) + '" stroke="var(--border,#cbd5e1)" stroke-width="1.5"/>';
      if (dShade.length > 5) svg += '<path d="' + dShade + ' Z" fill="rgba(79,70,229,0.28)"/>';
      svg += '<path d="' + d + '" fill="none" stroke="var(--indigo,#4F46E5)" stroke-width="2.5"/>';
      if (a > minX && a < maxX) {
        svg += '<line x1="' + sx(a).toFixed(1) + '" y1="' + (H - pad) + '" x2="' + sx(a).toFixed(1) + '" y2="' + pad + '" stroke="#d97706" stroke-width="1.5" stroke-dasharray="3,3"/>';
        svg += '<text x="' + sx(a).toFixed(1) + '" y="' + (H - pad + 14) + '" font-size="10" font-weight="700" fill="#d97706" text-anchor="middle">t=' + a + '</text>';
      }
      if (b > minX && b < maxX) {
        svg += '<line x1="' + sx(b).toFixed(1) + '" y1="' + (H - pad) + '" x2="' + sx(b).toFixed(1) + '" y2="' + pad + '" stroke="#d97706" stroke-width="1.5" stroke-dasharray="3,3"/>';
        svg += '<text x="' + sx(b).toFixed(1) + '" y="' + (H - pad + 14) + '" font-size="10" font-weight="700" fill="#d97706" text-anchor="middle">t=' + b + '</text>';
      }
      svg += '</svg>';
      graphEl.innerHTML = svg;
    }

    [dfIn, lowIn, upIn].forEach(function (inp) { inp.addEventListener('input', update); });
    update();
  }

  function renderChiSquareView(el) {
    el.innerHTML = [
      '<div class="calc-dist-controls">',
      '  <div class="calc-dist-panel">',
      '    <h4>Chi-Square Distribution: χ² ~ χ²(df)</h4>',
      '    <div class="calc-dist-field"><label>Degrees of Freedom (df):</label><input type="number" id="sc-chi-df" value="4" min="1" max="100"></div>',
      '    <div class="calc-dist-field"><label>Critical Value (k):</label><input type="number" id="sc-chi-k" value="9.488" min="0" step="any"></div>',
      '  </div>',
      '</div>',
      '<div class="calc-dist-display">',
      '  <div class="calc-dist-result" id="sc-chi-res"></div>',
      '  <div class="calc-dist-graph-card" id="sc-chi-graph"></div>',
      '</div>'
    ].join('');

    var dfIn = el.querySelector('#sc-chi-df');
    var kIn = el.querySelector('#sc-chi-k');
    var resEl = el.querySelector('#sc-chi-res');
    var graphEl = el.querySelector('#sc-chi-graph');

    function update() {
      var df = parseInt(dfIn.value, 10) || 1;
      var k = parseFloat(kIn.value);
      if (isNaN(k) || k < 0) k = 0;

      var cdfLe = _chi2Cdf(k, df);
      var pValue = Math.max(0, 1 - cdfLe);

      resEl.innerHTML = '<div style="font-size:12px;font-weight:700;color:var(--muted)">CHI-SQUARE P-VALUE</div>' +
        '<div class="calc-dist-result-prob">P(χ² ≥ ' + k.toFixed(3) + ') = ' + pValue.toFixed(5) + ' (p-value)</div>' +
        '<div class="calc-dist-result-meta">' +
        'Cumulative: P(χ² ≤ ' + k.toFixed(3) + ') = ' + cdfLe.toFixed(5) + '<br>' +
        'Expected Value: E[χ²] = df = ' + df + ' · Variance: Var(χ²) = 2df = ' + (2 * df) + ' · Goodness-of-Fit & Independence' +
        '</div>';

      var W = 520, H = 220, pad = 36;
      var maxX = Math.max(16, df + 4 * Math.sqrt(2 * df));
      function sx(x) { return pad + (x / maxX) * (W - 2 * pad); }

      var maxDens = 0;
      for (var t = 0.1; t <= maxX; t += 0.2) {
        var yVal = _chi2Pdf(t, df);
        if (yVal > maxDens) maxDens = yVal;
      }
      if (maxDens === 0) maxDens = 0.5;
      function sy(y) { return H - pad - (y / maxDens) * (H - 2 * pad); }

      var d = 'M', dShade = 'M', inShade = false, steps = 100;
      for (var i = 1; i <= steps; i++) {
        var curX = (i / steps) * maxX;
        var curY = _chi2Pdf(curX, df);
        var px = sx(curX), py = sy(curY);
        d += (i === 1 ? '' : 'L') + px.toFixed(1) + ',' + py.toFixed(1);

        if (curX >= k) {
          if (!inShade) {
            dShade += px.toFixed(1) + ',' + (H - pad) + ' L' + px.toFixed(1) + ',' + py.toFixed(1);
            inShade = true;
          } else {
            dShade += ' L' + px.toFixed(1) + ',' + py.toFixed(1);
          }
        }
      }
      if (inShade) dShade += ' L' + sx(maxX).toFixed(1) + ',' + (H - pad);

      var svg = '<svg width="100%" height="200" viewBox="0 0 ' + W + ' ' + H + '" style="display:block">';
      svg += '<line x1="' + pad + '" y1="' + (H - pad) + '" x2="' + (W - pad) + '" y2="' + (H - pad) + '" stroke="var(--border,#cbd5e1)" stroke-width="1.5"/>';
      if (dShade.length > 5) svg += '<path d="' + dShade + ' Z" fill="rgba(79,70,229,0.28)"/>';
      svg += '<path d="' + d + '" fill="none" stroke="var(--indigo,#4F46E5)" stroke-width="2.5"/>';
      if (k > 0 && k < maxX) {
        svg += '<line x1="' + sx(k).toFixed(1) + '" y1="' + (H - pad) + '" x2="' + sx(k).toFixed(1) + '" y2="' + pad + '" stroke="#d97706" stroke-width="1.5" stroke-dasharray="3,3"/>';
        svg += '<text x="' + sx(k).toFixed(1) + '" y="' + (H - pad + 14) + '" font-size="10" font-weight="700" fill="#d97706" text-anchor="middle">k=' + k.toFixed(2) + '</text>';
      }
      svg += '</svg>';
      graphEl.innerHTML = svg;
    }

    [dfIn, kIn].forEach(function (inp) { inp.addEventListener('input', update); });
    update();
  }

  function mount(modeKey, savedState) {
    if (!container) return;
    activeMode = modeKey;
    mountToken += 1;

    if (modeKey === 'threeD') {
      mountIframe('threeD');
      return;
    }
    if (modeKey === 'distributions') {
      destroyApiInstance();
      mountDistributions();
      return;
    }

    mountApiCalculator(modeKey, mountToken, savedState);
  }

  function selectMode(modeKey) {
    buttons.forEach(function (b) {
      b.setAttribute('aria-selected', String(b.dataset.mode === modeKey));
    });
    mount(modeKey);
  }

  buttons.forEach(function (b) {
    b.addEventListener('click', function () { selectMode(b.dataset.mode); });
  });

  // Watch for site theme changes to keep invertedColors matched seamlessly
  var themeObserver = new MutationObserver(function () {
    if (apiInstance && typeof apiInstance.getState === 'function') {
      var dark = isDark();
      if (apiInstance._dark !== dark) {
        try {
          var state = apiInstance.getState();
          mount(activeMode, state);
        } catch (e) {}
      }
    }
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'class'] });

