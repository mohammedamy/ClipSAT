<!-- Desmos API — one script exposes GraphingCalculator, Calculator3D, and
     ScientificCalculator; which one gets instantiated is picked client-side
     by the mode buttons below, not by loading a different script per mode.
     apiKey is Desmos's own public DEMO key (rate-limited, meant for testing,
     shared in Desmos's own docs) — swap in a real key from
     https://www.desmos.com/my-api before this goes live at scale. -->
<script defer src="https://www.desmos.com/api/v1.11/calculator.js?apiKey=dcb31709b452b1cf9dc26972add0fda6"></script>
<script>
(function () {
  'use strict';

  // Exam Mode: Desmos's own documented restriction options, matching the
  // feature set real testing platforms configure — no images/notes/folders
  // to paste in outside content, no author tools, and a locked-down function
  // set (restrictedFunctions) that mirrors what a real exam calculator allows.
  var EXAM_OPTS = {
    authorFeatures: false,
    images: false,
    folders: false,
    notes: false,
    restrictedFunctions: true,
    pasteGraphLink: false,
    pasteTableData: false,
    settingsMenu: false
  };

  var MODES = {
    graphing:   { ctor: 'GraphingCalculator',   opts: {} },
    threeD:     { ctor: 'Calculator3D',         opts: {} },
    scientific: { ctor: 'ScientificCalculator', opts: {} },
    exam:       { ctor: 'GraphingCalculator',   opts: EXAM_OPTS }
  };

  var container = document.getElementById('calc-container');
  var buttons = Array.prototype.slice.call(document.querySelectorAll('.calc-mode-btn'));
  var current = null;

  function isDark() {
    return document.documentElement.getAttribute('data-theme') === 'dark';
  }

  function mount(modeKey) {
    if (!window.Desmos || !container) return;
    var mode = MODES[modeKey];
    if (!mode || typeof window.Desmos[mode.ctor] !== 'function') return;
    if (current && typeof current.destroy === 'function') current.destroy();
    container.innerHTML = '';
    var opts = Object.assign({ invertedColors: isDark() }, mode.opts);
    current = window.Desmos[mode.ctor](container, opts);
  }

  function selectMode(modeKey) {
    buttons.forEach(function (b) {
      b.setAttribute('aria-selected', String(b.dataset.mode === modeKey));
    });
    mount(modeKey);
  }

  buttons.forEach(function (b) {
    b.addEventListener('click', function () { selectMode(b.dataset.mode); });
  });

  function init() {
    if (!window.Desmos) { setTimeout(init, 50); return; }
    selectMode('graphing');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
