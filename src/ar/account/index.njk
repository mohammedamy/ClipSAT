---
layout: base.njk
trackId: account
pageLocale: ar
isRtl: true
canonicalPath: "/ar/account/"
enAltPath: "/account/"
arAltPath: "/ar/account/"
title: "حسابي · ClipSAT"
description: "إدارة حساب ClipSAT ورصيد المعلم الذكي والصوت اليومي والفصول الدراسية المنضم إليها والمزامنة السحابية وتصدير بياناتك."
---
<main class="view active" id="view-account">
  <div class="wrap" style="max-width:860px; margin:0 auto; padding:36px 20px 80px">
    <h1 data-bilingual style="font-size:2rem; font-weight:800; color:var(--ink); margin:0 0 8px">
      <span class="i18n-en" hidden>My Account</span>
      <span class="i18n-ar" dir="rtl">حسابي</span>
    </h1>
    <p data-bilingual style="color:var(--muted); margin:0 0 28px; font-size:.96rem">
      <span class="i18n-en" hidden>Manage your cloud sync, daily AI &amp; voice allowances, joined classes, and data exports.</span>
      <span class="i18n-ar" dir="rtl">إدارة المزامنة السحابية، ورصيد المعلم الذكي والصوت اليومي، والفصول المنضم إليها، وتصدير بياناتك.</span>
    </p>

    <div id="account-gate" style="background:var(--panel, #fff); border:1px solid var(--line, #d6dce6); border-radius:14px; padding:28px 24px">
      <p id="account-gate-msg" style="margin:0 0 16px; color:var(--ink)">جاري التحقق من جلستك…</p>
      <button class="btn primary" id="account-signin-btn" style="min-height:44px; padding:10px 20px" hidden
              onclick="window.openCloudAuthModal && window.openCloudAuthModal()">
        <span data-bilingual>
          <span class="i18n-en" hidden>Sign in or create account</span>
          <span class="i18n-ar" dir="rtl">تسجيل الدخول أو إنشاء حساب</span>
        </span>
      </button>
    </div>

    <div id="account-content" hidden>
      <!-- Profile & Plan Summary -->
      <section style="background:var(--panel, #fff); border:1px solid var(--line, #d6dce6); border-radius:14px; padding:24px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px">
        <div>
          <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:6px">
            <strong id="account-email" style="font-size:1.1rem; color:var(--ink)"></strong>
            <span id="account-plan-badge" style="font-size:.76rem; font-weight:700; padding:3px 10px; border-radius:999px; background:var(--paper-2, #f1f5f9); color:var(--indigo); border:1px solid var(--line)">ClipSAT المجاني</span>
          </div>
          <p style="margin:0; font-size:.88rem; color:var(--muted)">
            <span data-bilingual>
              <span class="i18n-en" hidden>Provider:</span>
              <span class="i18n-ar" dir="rtl">طريقة الدخول:</span>
            </span>
            <span id="account-provider" style="font-weight:600; color:var(--ink)"></span>
            <span id="account-plan-expiry" style="margin-inline-start:10px"></span>
          </p>
        </div>
        <div style="display:flex; gap:10px; flex-wrap:wrap">
          <a href="/ar/pricing/" class="btn" style="min-height:44px; display:inline-flex; align-items:center; text-decoration:none">
            <span data-bilingual>
              <span class="i18n-en" hidden>Plan &amp; Billing</span>
              <span class="i18n-ar" dir="rtl">الخطة والفواتير</span>
            </span>
          </a>
          <button type="button" class="btn ghost" style="min-height:44px" id="account-signout-btn">
            <span data-bilingual>
              <span class="i18n-en" hidden>Sign out</span>
              <span class="i18n-ar" dir="rtl">تسجيل الخروج</span>
            </span>
          </button>
        </div>
      </section>

      <!-- Live Daily AI & Voice Usage -->
      <section style="background:var(--panel, #fff); border:1px solid var(--line, #d6dce6); border-radius:14px; padding:24px; margin-bottom:20px">
        <h2 data-bilingual style="font-size:1.1rem; font-weight:700; margin:0 0 16px; color:var(--ink)">
          <span class="i18n-en" hidden>Today’s AI &amp; Voice Allowance (UTC)</span>
          <span class="i18n-ar" dir="rtl">الاستهلاك اليومي للمعلم الذكي والصوت</span>
        </h2>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:18px">
          <div>
            <div style="display:flex; justify-content:space-between; font-size:.88rem; margin-bottom:6px">
              <span data-bilingual style="font-weight:600; color:var(--ink)">
                <span class="i18n-en" hidden>AI Tutor Credits</span>
                <span class="i18n-ar" dir="rtl">نقاط المعلم الذكي</span>
              </span>
              <span id="acct-ai-usage-label" style="font-family:var(--mono); color:var(--muted)">—</span>
            </div>
            <div style="height:8px; background:var(--paper-2, #e2e8f0); border-radius:999px; overflow:hidden">
              <div id="acct-ai-usage-bar" style="height:100%; width:0%; background:var(--indigo); transition:width .25s ease"></div>
            </div>
          </div>
          <div>
            <div style="display:flex; justify-content:space-between; font-size:.88rem; margin-bottom:6px">
              <span data-bilingual style="font-weight:600; color:var(--ink)">
                <span class="i18n-en" hidden>Voice Tutor (TTS)</span>
                <span class="i18n-ar" dir="rtl">المعلم الصوتي (TTS)</span>
              </span>
              <span id="acct-tts-usage-label" style="font-family:var(--mono); color:var(--muted)">—</span>
            </div>
            <div style="height:8px; background:var(--paper-2, #e2e8f0); border-radius:999px; overflow:hidden">
              <div id="acct-tts-usage-bar" style="height:100%; width:0%; background:var(--amber-2, #c8902a); transition:width .25s ease"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Joined Classes & Integrations -->
      <section style="background:var(--panel, #fff); border:1px solid var(--line, #d6dce6); border-radius:14px; padding:24px; margin-bottom:20px">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:12px">
          <h2 data-bilingual style="font-size:1.1rem; font-weight:700; margin:0; color:var(--ink)">
            <span class="i18n-en" hidden>Classes &amp; Sync</span>
            <span class="i18n-ar" dir="rtl">الفصول الدراسية والمزامنة</span>
          </h2>
          <button type="button" class="btn ghost" style="min-height:40px" onclick="window.openTeacherView && window.openTeacherView()">
            <span data-bilingual>
              <span class="i18n-en" hidden>Open Classroom Hub</span>
              <span class="i18n-ar" dir="rtl">فتح بوابة الفصول</span>
            </span>
          </button>
        </div>
        <div id="acct-classes-list" style="font-size:.9rem; color:var(--muted)">جاري تحميل الفصول…</div>
        <p id="acct-google-status" style="margin:14px 0 0; font-size:.86rem; color:var(--muted)"></p>
      </section>

      <!-- Privacy & Data Portability -->
      <section style="background:var(--panel, #fff); border:1px solid var(--line, #d6dce6); border-radius:14px; padding:24px">
        <h2 data-bilingual style="font-size:1.1rem; font-weight:700; margin:0 0 8px; color:var(--ink)">
          <span class="i18n-en" hidden>Your Data &amp; Privacy</span>
          <span class="i18n-ar" dir="rtl">بياناتك والخصوصية</span>
        </h2>
        <p data-bilingual style="font-size:.88rem; color:var(--muted); margin:0 0 16px">
          <span class="i18n-en" hidden>Your mistake log, flashcards, streaks, and accuracy sync securely via Row-Level Security. Export a complete copy anytime.</span>
          <span class="i18n-ar" dir="rtl">تتم مزامنة سجل الأخطاء والبطاقات وسلاسل الدراسة بدقة وأمان. يمكنك تنزيل نسخة كاملة من بياناتك في أي وقت.</span>
        </p>
        <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center">
          <button type="button" class="btn" id="acct-sync-btn" style="min-height:44px">
            <span data-bilingual>
              <span class="i18n-en" hidden>Sync Progress Now</span>
              <span class="i18n-ar" dir="rtl">مزامنة التقدم الآن</span>
            </span>
          </button>
          <button type="button" class="btn" id="acct-export-btn" style="min-height:44px">
            <span data-bilingual>
              <span class="i18n-en" hidden>Download My Study Data (JSON)</span>
              <span class="i18n-ar" dir="rtl">تنزيل بياناتي الدراسية (JSON)</span>
            </span>
          </button>
          <button type="button" class="btn" id="acct-delete-btn" style="min-height:44px; background:#fee2e2; color:#b91c1c; border:1px solid #fca5a5">
            <span data-bilingual>
              <span class="i18n-en" hidden>Delete My Cloud Account</span>
              <span class="i18n-ar" dir="rtl">حذف حسابي السحابي</span>
            </span>
          </button>
          <a href="/contact/?topic=account-deletion" class="btn ghost" style="min-height:44px; display:inline-flex; align-items:center; text-decoration:none">
            <span data-bilingual>
              <span class="i18n-en" hidden>Request Account Deletion</span>
              <span class="i18n-ar" dir="rtl">طلب حذف الحساب</span>
            </span>
          </a>
        </div>
        <p id="acct-action-status" role="status" aria-live="polite" style="margin:10px 0 0; font-size:.84rem; color:var(--muted)"></p>
      </section>
    </div>
  </div>
</main>

<script>
(function () {
  var gate = document.getElementById('account-gate');
  var msg = document.getElementById('account-gate-msg');
  var signinBtn = document.getElementById('account-signin-btn');
  var content = document.getElementById('account-content');

  function isAr() {
    return (window.i18n && typeof window.i18n.getLocale === 'function' && window.i18n.getLocale() === 'ar') ||
           (document.documentElement && document.documentElement.dir === 'rtl');
  }

  function esc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function renderUsageRow(d) {
    if (!d || typeof d !== 'object') return;
    var isPaid = !!(d.paid || (d.tier === 'paid' && (!d.paid_until || Date.parse(d.paid_until) > Date.now())));
    var badge = document.getElementById('account-plan-badge');
    if (badge) {
      badge.textContent = isPaid ? 'ClipSAT Plus' : (isAr() ? 'ClipSAT المجاني' : 'ClipSAT Free');
      badge.style.background = isPaid ? 'var(--indigo)' : 'var(--paper-2, #f1f5f9)';
      badge.style.color = isPaid ? '#fff' : 'var(--indigo)';
    }
    var expEl = document.getElementById('account-plan-expiry');
    if (expEl) {
      var parts = [];
      if (isPaid && d.trial_ends_at && Date.parse(d.trial_ends_at) > Date.now()) {
        parts.push((isAr() ? 'تجربة مجانية حتى ' : 'Trial through ') + new Date(d.trial_ends_at).toLocaleDateString());
      } else if (isPaid && d.paid_until) {
        parts.push((isAr() ? 'سارٍ حتى ' : 'Active through ') + new Date(d.paid_until).toLocaleDateString());
      }
      if (isPaid && d.cancel_at_period_end) {
        parts.push(isAr() ? 'يُلغى بنهاية الفترة' : 'Cancels at period end');
      }
      expEl.textContent = parts.length ? ('· ' + parts.join(' · ')) : '';
    }
    var aiUsed = Number(d.ai_used || 0);
    var aiLim = Math.max(1, Number(d.ai_cap != null ? d.ai_cap : (d.ai_limit != null ? d.ai_limit : (isPaid ? Math.max(200, Number(d.daily_credits || 200)) : 20))));
    var ttsUsed = Number(d.tts_used || 0);
    var ttsLim = Math.max(1, Number(d.tts_cap != null ? d.tts_cap : (d.tts_limit != null ? d.tts_limit : (isPaid ? 600 : 60))));
    var aiLbl = document.getElementById('acct-ai-usage-label');
    var ttsLbl = document.getElementById('acct-tts-usage-label');
    var aiBar = document.getElementById('acct-ai-usage-bar');
    var ttsBar = document.getElementById('acct-tts-usage-bar');
    if (aiLbl) aiLbl.textContent = aiUsed + ' / ' + aiLim;
    if (ttsLbl) ttsLbl.textContent = ttsUsed + ' / ' + ttsLim;
    if (aiBar) aiBar.style.width = Math.min(100, Math.round((aiUsed / aiLim) * 100)) + '%';
    if (ttsBar) ttsBar.style.width = Math.min(100, Math.round((ttsUsed / ttsLim) * 100)) + '%';
  }

  function loadAccountTelemetry(cloud, user) {
    var sb = typeof cloud.getClient === 'function' ? cloud.getClient() : null;
    if (!sb) return;

    function loadAiPlansFallback() {
      return sb.from('ai_plans').select('tier,paid_until,trial_ends_at,cancel_at_period_end,daily_credits').maybeSingle().then(function (r2) {
        renderUsageRow((r2 && r2.data) || { tier: 'free', ai_used: 0, ai_cap: 20, tts_used: 0, tts_cap: 60 });
      }, function () {});
    }

    sb.rpc('get_my_daily_usage').then(function (res) {
      var raw = res && res.data;
      var d = Array.isArray(raw) ? raw[0] : raw;
      if (res && !res.error && d && typeof d === 'object') {
        renderUsageRow(d);
      } else {
        loadAiPlansFallback();
      }
    }, loadAiPlansFallback);

    var clsEl = document.getElementById('acct-classes-list');
    sb.from('class_members').select('class_id,classes(name,track)').eq('student_id', user.id).then(function (r) {
      if (!clsEl) return;
      var rows = (r && r.data) || [];
      if (!rows.length) {
        clsEl.textContent = isAr() ? 'لم تنضم إلى أي فصل بعد.' : 'No joined classes yet.';
        return;
      }
      clsEl.innerHTML = '<ul style="margin:0; padding-inline-start:18px; display:flex; flex-direction:column; gap:6px">'
        + rows.map(function (m) {
            var nm = (m.classes && m.classes.name) || 'Class';
            var trk = (m.classes && m.classes.track) ? (' (' + esc(m.classes.track.toUpperCase()) + ')') : '';
            return '<li style="color:var(--ink)"><strong>' + esc(nm) + '</strong>' + trk + '</li>';
          }).join('')
        + '</ul>';
    }, function () {
      if (clsEl) clsEl.textContent = isAr() ? 'تعذّر تحميل الفصول.' : 'Could not load classes.';
    });

    var gEl = document.getElementById('acct-google-status');
    if (gEl) {
      var connected = !!(window.ClipSATGoogle && typeof window.ClipSATGoogle.isConnected === 'function' && window.ClipSATGoogle.isConnected());
      gEl.textContent = connected
        ? (isAr() ? '✓ حساب Google Forms متصل لتصدير الاختبارات.' : '✓ Google Forms connected for quiz export.')
        : (isAr() ? 'Google Forms غير متصل (اختياري للمعلمين).' : 'Google Forms not connected (optional, for teachers).');
    }
  }

  function bindActions(cloud) {
    var syncBtn = document.getElementById('acct-sync-btn');
    var expBtn = document.getElementById('acct-export-btn');
    var delBtn = document.getElementById('acct-delete-btn');
    var status = document.getElementById('acct-action-status');
    if (syncBtn && !syncBtn._bound) {
      syncBtn._bound = true;
      syncBtn.addEventListener('click', function () {
        if (status) status.textContent = isAr() ? 'جاري مزامنة بياناتك…' : 'Syncing your progress…';
        try { if (typeof cloud.syncNow === 'function') cloud.syncNow(); } catch (_) {}
        var p = (typeof cloud.pullAndMerge === 'function') ? cloud.pullAndMerge() : Promise.resolve();
        Promise.resolve(p).then(function () {
          if (status) status.textContent = isAr() ? '✓ تمت مزامنة التقدم عبر الأجهزة.' : '✓ Progress synced across devices.';
        }, function () {
          if (status) status.textContent = isAr() ? 'تم الحفظ محليًا — ستتم المزامنة تلقائيًا.' : 'Saved locally — cloud sync will retry automatically.';
        });
      });
    }
    if (delBtn && !delBtn._bound) {
      delBtn._bound = true;
      delBtn.addEventListener('click', function () {
        if (typeof window.cloudDeleteMyAccount === 'function') {
          window.cloudDeleteMyAccount();
          return;
        }
        var msgConfirm = isAr()
          ? 'هل تريد حذف حسابك السحابي وبياناته نهائيًا؟ ستبقى بيانات المتصفح المحلي ما لم تمسحها.'
          : 'Permanently delete your ClipSAT cloud account and synced data? This cannot be undone.';
        if (!window.confirm(msgConfirm)) return;
        if (status) status.textContent = isAr() ? 'جاري حذف الحساب السحابي…' : 'Deleting cloud account…';
        cloud.deleteMyAccount().then(function () {
          if (status) status.textContent = isAr() ? '✓ تم حذف حسابك وبياناتك السحابية نهائيًا.' : '✓ Your cloud account and synced data have been deleted.';
        }, function (err) {
          if (status) status.textContent = (isAr() ? 'تعذّر حذف الحساب: ' : 'Could not delete account: ') + ((err && err.message) || 'error');
        });
      });
    }
    if (!expBtn || expBtn._bound) return;
    expBtn._bound = true;
    expBtn.addEventListener('click', function () {
      var dump = { exported_at: new Date().toISOString(), local_data: {} };
      try {
        for (var i = 0; i < localStorage.length; i++) {
          var k = localStorage.key(i);
          if (k && (k.indexOf('clipsat_') === 0 || k === 'cs_accuracy_log')) {
            try { dump.local_data[k] = JSON.parse(localStorage.getItem(k)); }
            catch (_) { dump.local_data[k] = localStorage.getItem(k); }
          }
        }
      } catch (_) {}
      var blob = new Blob([JSON.stringify(dump, null, 2)], { type: 'application/json;charset=utf-8' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'clipsat-study-data-' + new Date().toISOString().slice(0, 10) + '.json';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(function () { URL.revokeObjectURL(url); }, 5000);
      if (status) status.textContent = isAr() ? '✓ تم تنزيل ملف بياناتك الدراسية.' : '✓ Your study data export has been downloaded.';
    });
  }

  var _renderedUid = null;
  function render(user) {
    if (user) {
      document.getElementById('account-email').textContent = user.email || 'your account';
      document.getElementById('account-provider').textContent =
        (window.ClipSATCloud.currentProvider && window.ClipSATCloud.currentProvider()) || 'email';
      gate.hidden = true;
      content.hidden = false;
      if (_renderedUid !== user.id) {
        _renderedUid = user.id;
        loadAccountTelemetry(window.ClipSATCloud, user);
      }
      bindActions(window.ClipSATCloud);
    } else {
      _renderedUid = null;
      content.hidden = true;
      gate.hidden = false;
      msg.textContent = isAr() ? 'يرجى تسجيل الدخول لعرض حسابك.' : 'Please sign in to view your account.';
      signinBtn.hidden = false;
    }
  }

  function start() {
    var cloud = window.ClipSATCloud;
    if (!cloud || !cloud.configured) { msg.textContent = isAr() ? 'الحسابات غير متاحة حاليًا.' : 'Accounts are not available right now.'; return; }
    document.addEventListener('clipsat:auth-changed', function () {
      render(typeof cloud.getUser === 'function' ? cloud.getUser() : null);
    });
    if (typeof cloud.isSignedIn === 'function' && cloud.isSignedIn()) {
      render(typeof cloud.getUser === 'function' ? cloud.getUser() : null);
    }
    cloud.requireAuth().then(render);
    cloud.ready.then(function () {
      var client = cloud.getClient();
      if (!client) return;
      client.auth.onAuthStateChange(function (event, session) {
        if (event === 'SIGNED_IN' || event === 'SIGNED_OUT' || event === 'TOKEN_REFRESHED') {
          setTimeout(function () { render(session ? session.user : null); }, 0);
        }
      });
    });
    document.getElementById('account-signout-btn').onclick = function () { cloud.signOut(); };
  }

  var tries = 0;
  (function wait() {
    if (window.ClipSATCloud && (window.ClipSATCloud.requireAuth || window.ClipSATCloud.configured === false)) return start();
    if (++tries > 100) { msg.textContent = isAr() ? 'تعذّر تحميل بوابة الحساب.' : 'Could not load sign-in. Check your connection or browser extensions.'; return; }
    setTimeout(wait, 100);
  })();
})();
</script>
