<script>
(function(){
  var _currentCycle = 'annual';
  window.setBilling = function(cycle) {
    _currentCycle = (cycle === 'monthly') ? 'monthly' : 'annual';
    var btnAnnual = document.getElementById('toggle-annual') || document.getElementById('price-btn-annual');
    var btnMonthly = document.getElementById('toggle-monthly') || document.getElementById('price-btn-monthly');
    var priceAmount = document.getElementById('plan-price-amount');
    var priceCurrency = document.getElementById('price-display-val');
    var pricePeriod = document.getElementById('plan-price-period');
    var subNote = document.getElementById('price-sub-note');
    var isAr = (window.i18n && typeof window.i18n.getLocale === 'function')
      ? (window.i18n.getLocale() === 'ar')
      : (document.documentElement.lang === 'ar');

    if (priceCurrency) priceCurrency.textContent = isAr ? 'ر.س' : 'SAR';

    if (_currentCycle === 'annual') {
      if (btnAnnual) { btnAnnual.style.background = 'var(--indigo, #4338ca)'; btnAnnual.style.color = '#fff'; }
      if (btnMonthly) { btnMonthly.style.background = 'transparent'; btnMonthly.style.color = 'var(--muted)'; }
      if (priceAmount) priceAmount.textContent = '75';
      if (pricePeriod) pricePeriod.textContent = isAr ? '/ سنة' : '/year';
      if (subNote) subNote.style.display = 'block';
    } else {
      if (btnMonthly) { btnMonthly.style.background = 'var(--indigo, #4338ca)'; btnMonthly.style.color = '#fff'; }
      if (btnAnnual) { btnAnnual.style.background = 'transparent'; btnAnnual.style.color = 'var(--muted)'; }
      if (priceAmount) priceAmount.textContent = '15';
      if (pricePeriod) pricePeriod.textContent = isAr ? '/ شهر' : '/month';
      if (subNote) subNote.style.display = 'none';
    }
    var waAssist = document.getElementById('plus-wa-assist-link');
    if (waAssist) {
      var msg = isAr
        ? ('مرحبًا أستاذ محمد، أرغب في الاستفسار عن اشتراك ClipSAT Plus (' + (_currentCycle === 'annual' ? '75 ر.س/سنة' : '15 ر.س/شهر') + ').')
        : ('Hello Mr. Mohamed, I would like to start ClipSAT Plus (' + (_currentCycle === 'annual' ? '75 SAR/year' : '15 SAR/month') + ').');
      waAssist.setAttribute('href', 'https://wa.me/966597688647?text=' + encodeURIComponent(msg));
    }
  };

  function setCheckoutStatus(msg, isErr) {
    var st = document.getElementById('plus-checkout-status');
    if (!st) return;
    st.textContent = msg || '';
    st.style.color = isErr ? '#dc2626' : 'var(--indigo, #4338ca)';
  }

  function getBillingEndpoint() {
    var cfg = window.CLIPSAT_CLOUD_CONFIG || {};
    var base = String(cfg.url || 'https://ynnqrxeprxhtdimzwxwx.supabase.co').replace(/\/+$/, '');
    return base + '/functions/v1/billing-webhook';
  }

  window.openPlusCheckout = function(provider) {
    var prov = (provider === 'stripe') ? 'stripe' : 'moyasar';
    var isAr = (window.i18n && typeof window.i18n.getLocale === 'function')
      ? (window.i18n.getLocale() === 'ar')
      : (document.documentElement.lang === 'ar');

    if (window.ClipSATAnalytics && typeof window.ClipSATAnalytics.track === 'function') {
      window.ClipSATAnalytics.track('checkout_start', { provider: prov, cycle: _currentCycle });
    }

    var cloud = window.ClipSATCloud;
    if (!cloud || typeof cloud.isSignedIn !== 'function' || !cloud.isSignedIn()) {
      setCheckoutStatus(
        isAr ? 'يرجى تسجيل الدخول أولاً لربط اشتراك ClipSAT Plus بحسابك السحابي.' : 'Please sign in first so ClipSAT Plus is provisioned directly onto your account.',
        false
      );
      if (typeof window.openCloudAuth === 'function') window.openCloudAuth();
      return;
    }

    setCheckoutStatus(isAr ? 'جارٍ تجهيز جلسة الدفع الآمنة بالريال السعودي…' : 'Preparing secure SAR checkout session…', false);

    var jwt = typeof cloud.getAccessToken === 'function' ? cloud.getAccessToken() : '';
    var fetcher = (typeof cloud.fetch === 'function') ? cloud.fetch : window.fetch;
    fetcher(getBillingEndpoint(), {
      method: 'POST',
      headers: {
        'Authorization': 'Bearer ' + jwt,
        'Content-Type': 'application/json',
        'X-ClipSAT-Action': 'create-checkout'
      },
      body: JSON.stringify({ provider: prov, cycle: _currentCycle })
    }).then(function(res) {
      return res.json().then(function(data) { return { status: res.status, data: data }; });
    }).then(function(out) {
      var d = out.data || {};
      if (d.url) { window.location.assign(d.url); return; }
      if (d.configured === false) {
        var waLink = document.getElementById('plus-wa-assist-link');
        var opened = (waLink && waLink.href) ? window.open(waLink.href, '_blank', 'noopener') : null;
        setCheckoutStatus(
          isAr
            ? (opened ? 'بوابة الدفع قيد التفعيل النهائي — تم فتح التفعيل الفوري عبر واتساب.' : 'بوابة الدفع قيد التفعيل النهائي — استخدم رابط واتساب أعلاه للتفعيل الفوري.')
            : (opened ? 'Merchant gateway keys pending activation — opening instant 30-day Plus activation via WhatsApp.' : 'Merchant gateway keys pending activation — click the WhatsApp link above.'),
          false
        );
        return;
      }
      setCheckoutStatus(d.error || (isAr ? 'تعذّر بدء جلسة الدفع.' : 'Could not start checkout session.'), true);
    }).catch(function() {
      setCheckoutStatus(isAr ? 'تعذّر الاتصال بخادم الفوترة. يرجى المحاولة مرة أخرى.' : 'Unable to reach billing service. Please try again.', true);
    });
  };

  window.openBillingPortal = function() {
    var isAr = (window.i18n && typeof window.i18n.getLocale === 'function')
      ? (window.i18n.getLocale() === 'ar')
      : (document.documentElement.lang === 'ar');
    var cloud = window.ClipSATCloud;
    if (!cloud || typeof cloud.isSignedIn !== 'function' || !cloud.isSignedIn()) {
      if (typeof window.openCloudAuth === 'function') window.openCloudAuth();
      return;
    }
    setCheckoutStatus(isAr ? 'جارٍ التحقق من حالة اشتراكك…' : 'Checking your subscription status…', false);
    var jwt = typeof cloud.getAccessToken === 'function' ? cloud.getAccessToken() : '';
    var fetcher = (typeof cloud.fetch === 'function') ? cloud.fetch : window.fetch;
    fetcher(getBillingEndpoint(), {
      method: 'POST',
      headers: {
        'Authorization': 'Bearer ' + jwt,
        'Content-Type': 'application/json',
        'X-ClipSAT-Action': 'customer-portal'
      },
      body: '{}'
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d && d.url) { window.location.assign(d.url); return; }
      if (d && d.plan && d.plan.tier === 'paid') {
        var until = d.plan.paid_until ? new Date(d.plan.paid_until).toLocaleDateString() : 'Active';
        setCheckoutStatus(isAr ? ('اشتراك ClipSAT Plus نشط حتى: ' + until + ' (200 نقطة/يوم).') : ('ClipSAT Plus is active through ' + until + ' (200 credits/day).'), false);
      } else {
        setCheckoutStatus(isAr ? 'أنت حاليًا على المستوى المجاني الدائم (20 نقطة ذكاء اصطناعي/يوم).' : 'You are currently on ClipSAT Free (20 AI credits/day).', false);
      }
    }).catch(function() {
      setCheckoutStatus(isAr ? 'تعذّر فتح بوابة الفواتير حاليًا.' : 'Could not load billing status right now.', true);
    });
  };

  function checkLiveEntitlementBanner() {
    if (window.location.search.indexOf('checkout=success') !== -1) {
      var b = document.getElementById('plus-plan-active-banner');
      if (b) b.hidden = false;
      setCheckoutStatus('🎉 تم تفعيل ClipSAT Plus بنجاح! رصيدك اليومي الآن 200 نقطة.', false);
    }
    var cloud = window.ClipSATCloud;
    if (!cloud || !cloud.configured || typeof cloud.isSignedIn !== 'function' || !cloud.isSignedIn()) return;
    var sb = typeof cloud.getClient === 'function' ? cloud.getClient() : null;
    if (!sb) return;
    sb.from('ai_plans').select('tier,paid_until,daily_credits').maybeSingle().then(function(res) {
      if (res && res.data && res.data.tier === 'paid') {
        var exp = res.data.paid_until ? Date.parse(res.data.paid_until) : Infinity;
        if (exp > Date.now()) {
          var b = document.getElementById('plus-plan-active-banner');
          if (b) b.hidden = false;
        }
      }
    }, function() {});
  }

  document.addEventListener('DOMContentLoaded', function() {
    window.setBilling(_currentCycle);
    checkLiveEntitlementBanner();
    var langBtn = document.getElementById('i18n-toggle-btn');
    if (langBtn) {
      langBtn.addEventListener('click', function() {
        setTimeout(function() { window.setBilling(_currentCycle); }, 0);
      });
    }
  });
})();
</script>
